// Sheets DoR trial: a window, a grid, editing, undo and save over the cell
// spike. Throwaway. No formula engine, one sheet, no close warning.

extern "c" {
    header "stdio.h"
    fn rename(string, string) i32
}

// ---- the opened file: set once, never changed ----
var g_xml = bytes("")
var g_sheet = Sheet{mem: 0, count: 0, rows: []Row{}, data_at: 0, data_close: 0, data_empty: false, prefix: ""}
var g_sst = []string{}
var g_dates = []bool{}
var g_zip = bytes("")      // the file as read: unpacked again at each save
var g_sheet_path = ""
var g_masters = make(map[int]int)

// ---- changes on top of it ----
// key = row*100+col. A value is "n:12" number, "t:abc" text, "f:A1+1"
// formula or "c:" cleared. Undo step i holds lines "key \t before \t after"
// ("" = as in the file). Maps made here live outside the frame arena.
var g_over = make(map[int]string)
var g_undo = make(map[int]string)
var g_undo_at = 0       // steps that are applied
var g_undo_end = 0      // steps that exist (redo reaches here)
var g_rev = 0
var g_saved_rev = 0

var K_Z = 29
var K_Y = 28
var K_F2 = 59
var ROWS_MAX = 20001
var COLS_MAX = 26
var RH = 26.0
var CW = 112.0
var GREEN = 0x1F7A52FF

func open_file() {
    init_names()
    file := read_file_bytes(env("IN"))
    es := unzip(file)
    names, paths := sheet_list(es)
    k := entry_index(es, paths[0])
    sst := []string{}
    si := entry_index(es, "xl/sharedStrings.xml")
    if si >= 0 { sst = shared_strings(es[si].data) }
    st := entry_index(es, "xl/styles.xml")
    if st >= 0 { g_dates = date_styles(es[st].data) }
    // each assignment to a global copies once, out of the frame's arena
    g_sst = sst
    g_xml = es[k].data
    g_sheet_path = paths[0]
    g_zip = file
    // the scan stays in this frame until its records are in alloc() memory;
    // only the row list is copied out
    sc := scan_sheet(g_xml)
    g_sheet = sc
    ms := masters(g_sheet)
    for mk, mv := range ms { g_masters[mk] = mv }
}

func key_of(r, c) { return r * 100 + c }

func base_index(r, c) {
    i := lower_bound(g_sheet, r, c)
    if i < g_sheet.count && cell_at(g_sheet, i).row == r && cell_at(g_sheet, i).col == c { return i }
    return -1
}

// what the cell shows, and what editing it starts from
func base_text(i, editing) {
    c := cell_at(g_sheet, i)
    if has_formula(c) && (editing || g_rev > 0) {
        // no formula engine: after any edit a stored result may be stale
        return "=" + formula_of(g_xml, g_sheet, g_masters, i)
    }
    if c.kind == K_SHARED { return g_sst[int_in(g_xml, c.v_at, c.v_end)] }
    if c.kind == K_INLINE { return inline_text(g_xml, c) }
    v := value_text(g_xml, c)
    if c.kind == K_NUMBER && v != "" && c.style < len(g_dates) && g_dates[c.style] { return iso_date(int(floor(parse_float(v))) - 25569) }
    return v
}

func unesc(s) { return replace(replace(s, "\\n", "\n"), "\\t", "\t") }

func cell_text(r, c, editing) {
    k := key_of(r, c)
    if has(g_over, k) {
        v := g_over[k]
        body := unesc(substr(v, 2, len(v)))
        if has_prefix(v, "f:") { return "=" + body }
        return body
    }
    i := base_index(r, c)
    if i < 0 { return "" }
    return base_text(i, editing)
}

func is_number(s) {
    b := bytes(s)
    if len(b) == 0 || len(b) > 15 { return false }
    i := 0
    if byte_at(b, 0) == 45 { i = 1 }
    digits := 0
    dots := 0
    while i < len(b) {
        c := byte_at(b, i)
        if c >= 48 && c <= 57 { digits = digits + 1 } else if c == 46 { dots = dots + 1 } else { return false }
        i = i + 1
    }
    // a leading zero marks a code, not a number
    if len(b) > 1 && byte_at(b, 0) == 48 && byte_at(b, 1) != 46 { return false }
    return digits > 0 && dots <= 1
}

func encode_input(s) {
    if s == "" { return "c:" }
    if has_prefix(s, "=") { return "f:" + esc_out(substr(s, 1, len(s))) }
    if is_number(s) { return "n:" + s }
    return "t:" + esc_out(s)
}

func over_get(k) { if has(g_over, k) { return g_over[k] }  return "" }
func over_set(k, v) { if v == "" { delete(g_over, k) } else { g_over[k] = v } }

// one undo step: lines already in "key\tbefore\tafter" form
func apply_step(lines) {
    if len(lines) == 0 { return }
    g_undo[g_undo_at] = join(lines, "\n")
    g_undo_at = g_undo_at + 1
    i := g_undo_at
    while i < g_undo_end { delete(g_undo, i)  i = i + 1 }
    g_undo_end = g_undo_at
    replay(g_undo_at - 1, false)
}

func replay(step, backwards) {
    lines := split(g_undo[step], "\n")
    i := 0
    while i < len(lines) {
        p := split(lines[i], "\t")
        // "\t" inside a value is escaped, so there are always three parts
        v := p[2]
        if backwards { v = p[1] }
        over_set(parse_int(p[0]), unesc_tabs(v))
        i = i + 1
    }
    g_rev = g_rev + 1
}

func esc_step(v) { return replace(v, "\t", "\\t") }
func unesc_tabs(v) { return v }

func change(r, c, input) {
    k := key_of(r, c)
    return str(k) + "\t" + esc_step(over_get(k)) + "\t" + esc_step(encode_input(input))
}

func undo() { if g_undo_at > 0 { g_undo_at = g_undo_at - 1  replay(g_undo_at, true) } }
func redo() { if g_undo_at < g_undo_end { replay(g_undo_at, false)  g_undo_at = g_undo_at + 1 } }

func save_file() {
    t := now_ms()
    edits := []Edit{}
    for k, v := range g_over {
        r := k / 100
        c := k % 100
        op := "text"
        if has_prefix(v, "n:") { op = "number" } else if has_prefix(v, "f:") { op = "formula" } else if has_prefix(v, "c:") { op = "clear" }
        // clearing a cell the file never had changes nothing
        if op == "clear" && base_index(r, c) < 0 { continue }
        edits = append(edits, Edit{ref: col_name(c) + str(r), op: op, val: unesc(substr(v, 2, len(v))), col: c, row: r})
    }
    out := env("OUT")
    ok := false
    arena {
        drop := len(edits) > 0
        sheet := edit_scanned(g_xml, g_sheet, edits, drop)
        parts := unzip(g_zip)
        es := []Entry{}
        i := 0
        while i < len(parts) {
            e := parts[i]
            if e.name == g_sheet_path { e = Entry{name: e.name, data: sheet} } else if drop && e.name == "xl/workbook.xml" { e = Entry{name: e.name, data: force_recalc(e.data)} }
            es = append(es, e)
            i = i + 1
        }
        tmp := out + ".tmp"
        ok = write_file_bytes(tmp, zipup(es)) >= 0 && fsync(tmp) == 0 && rename(tmp, out) == 0
    }
    if ok {
        g_saved_rev = g_rev
        set_str("status", "Saved in " + str(now_ms() - t) + " ms")
    } else {
        set_str("status", "Your file was not saved.")
    }
}

func mini(a, b) { if a < b { return a }  return b }
func maxi(a, b) { if a > b { return a }  return b }
func clampi(v, lo, hi) { return maxi(lo, mini(v, hi)) }

func light_theme() {
    C_BG = 0xFFFFFFFF  C_SURFACE = 0xF4F3F9FF  C_TEXT = 0x1C1C26FF  C_MUTED = 0x5F5F73FF
    C_ACCENT = GREEN  C_ACCENT_HI = 0x258C60FF  C_ACCENT_LO = 0x185F40FF  C_BORDER = 0xD9D7E6FF
    C_SURFACE2 = 0xE9E8F1FF  C_INPUT = 0xFFFFFFFF  C_SELECTION = 0x1F7A5240
}

func tool(label) {
    i := row()
    padxy(12.0, 6.0)
    radius(7.0)
    border(1.0, C_BORDER)
    if hovered(i) { bg(C_SURFACE2)  mdk_cursor(2) } else { bg(C_BG) }
    text(label, 13.0)
    end()
    return clicked(i)
}

func start_edit(value) {
    set_str("fx", value)
    set_int("fx:caret", len(value))
    set_int("editing", 1)
    focus("fx")
    animate()
}

func view() {
    if state_int("loaded", 0) == 0 {
        set_int("loaded", 1)
        light_theme()
        open_file()
        set_int("top", 1)
        set_int("cr", 2)  set_int("cc", 1)  set_int("ar", 2)  set_int("ac", 1)
        set_str("status", str(g_sheet.count) + " cells")
        animate()
        return
    }
    cr := state_int("cr", 2)
    cc := state_int("cc", 1)
    ar := state_int("ar", 2)
    ac := state_int("ac", 1)
    top := state_int("top", 1)
    editing := state_int("editing", 0) == 1
    was_editing := editing

    col()
    fill()
        row()
        fillw()
        padxy(10.0, 7.0)
        gap(6.0)
        align(A_CENTER)
        bg(C_SURFACE)
            if tool("Save") || (ctrl() && key(K_S)) { save_file()  animate() }
            if tool("Undo") || (!editing && ctrl() && key(K_Z)) { undo()  animate() }
            if tool("Redo") || (!editing && ctrl() && key(K_Y)) { redo()  animate() }
            spacer()
            if g_rev != g_saved_rev { text("Unsaved changes", 13.0) } else { text("No unsaved changes", 13.0) }
            fg(C_MUTED)
            text(state_str("status", ""), 13.0)
            fg(C_MUTED)
        end()
        row()
        fillw()
        padxy(10.0, 4.0)
        gap(8.0)
        align(A_CENTER)
            row()
            width(70.0)
                text(col_name(cc) + str(cr), 14.0)
                bold()
            end()
            col()
            grow(1.0)
                if editing {
                    v := text_field("fx", "")
                    if key(K_RETURN) {
                        apply_step([]string{change(cr, cc, v)})
                        editing = false
                        cr = cr + 1
                        ar = cr  ac = cc
                        blur()
                        animate()
                    } else if key(K_ESCAPE) || !focused("fx") {
                        editing = false
                        blur()
                        animate()
                    }
                } else {
                    row()
                    padxy(12.0, 9.0)
                    border(1.0, C_BORDER)
                    radius(8.0)
                        text(cell_text(cr, cc, true), 14.0)
                    end()
                }
            end()
        end()

        if !was_editing {
            moved := false
            if key(K_DOWN) { cr = cr + 1  moved = true }
            if key(K_UP) { cr = cr - 1  moved = true }
            if key(K_RIGHT) { cc = cc + 1  moved = true }
            if key(K_LEFT) { cc = cc - 1  moved = true }
            if key(K_PAGEDOWN) { cr = cr + 25  moved = true }
            if key(K_PAGEUP) { cr = cr - 25  moved = true }
            cr = clampi(cr, 1, ROWS_MAX)
            cc = clampi(cc, 1, COLS_MAX)
            if moved { if !shift() { ar = cr  ac = cc }  set_int("follow", 1)  animate() }
            if key(K_DELETE) {
                step := []string{}
                r := mini(ar, cr)
                while r <= maxi(ar, cr) {
                    c := mini(ac, cc)
                    while c <= maxi(ac, cc) { step = append(step, change(r, c, ""))  c = c + 1 }
                    r = r + 1
                }
                apply_step(step)
                animate()
            }
            if ctrl() && key(K_C) {
                out := []string{}
                r := mini(ar, cr)
                while r <= maxi(ar, cr) {
                    line := []string{}
                    c := mini(ac, cc)
                    while c <= maxi(ac, cc) { line = append(line, cell_text(r, c, false))  c = c + 1 }
                    out = append(out, join(line, "\t"))
                    r = r + 1
                }
                mdk_set_clipboard(join(out, "\n"))
                set_str("status", "Copied " + str(len(out)) + " rows")
                animate()
            }
            if ctrl() && key(K_V) {
                lines := split(replace(mdk_clipboard(), "\r", ""), "\n")
                step := []string{}
                r := 0
                while r < len(lines) && mini(ar, cr) + r <= ROWS_MAX {
                    if r == len(lines) - 1 && lines[r] == "" { break }
                    parts := split(lines[r], "\t")
                    c := 0
                    while c < len(parts) && mini(ac, cc) + c <= COLS_MAX { step = append(step, change(mini(ar, cr) + r, mini(ac, cc) + c, parts[c]))  c = c + 1 }
                    r = r + 1
                }
                apply_step(step)
                set_str("status", "Pasted " + str(len(step)) + " cells")
                animate()
            }
            if key(K_F2) || key(K_RETURN) { start_edit(cell_text(cr, cc, true))  editing = true } else if !ctrl() && mdk_typed() != "" { start_edit(mdk_typed())  editing = true }
        }

        // ---- the grid: only what fits is built ----
        visible := int((mdk_win_h() - 44.0 - 50.0 - RH) / RH)
        top = top - int(mdk_wheel() * 3.0)
        if state_int("follow", 0) == 1 {
            if cr < top { top = cr }
            if cr >= top + visible { top = cr - visible + 1 }
            set_int("follow", 0)
        }
        top = clampi(top, 1, ROWS_MAX - visible + 1)
        left := state_int("left", 1)
        ncols := int((mdk_win_w() - 70.0) / CW)
        if cc < left { left = cc }
        if cc >= left + ncols { left = cc - ncols + 1 }
        left = clampi(left, 1, maxi(1, COLS_MAX - ncols + 1))
        set_int("left", left)

        row()
        height(RH)
            col()
            width(70.0)
            end()
            c := left
            while c < left + ncols && c <= COLS_MAX {
                row()
                width(CW)
                center()
                bg(C_SURFACE)
                border(0.5, C_BORDER)
                    text(col_name(c), 12.0)
                    fg(C_MUTED)
                end()
                c = c + 1
            }
        end()
        r := top
        while r < top + visible && r <= ROWS_MAX {
            row()
            height(RH)
                row()
                width(70.0)
                height(RH)
                center()
                bg(C_SURFACE)
                    text(str(r), 12.0)
                    fg(C_MUTED)
                end()
                c = left
                while c < left + ncols && c <= COLS_MAX {
                    i := row()
                    width(CW)
                    height(RH)
                    padxy(7.0, 4.0)
                    clip()
                    if r >= mini(ar, cr) && r <= maxi(ar, cr) && c >= mini(ac, cc) && c <= maxi(ac, cc) { bg(C_SELECTION) }
                    if r == cr && c == cc { border(2.0, GREEN) } else { border(0.5, C_BORDER) }
                        text(cell_text(r, c, false), 13.0)
                    end()
                    if mdk_mouse_down() != 0 && prev_rect_has(i, mdk_mouse_x(), mdk_mouse_y()) {
                        cr = r
                        cc = c
                        if state_int("dragging", 0) == 0 {
                            set_int("dragging", 1)
                            if !shift() { ar = r  ac = c }
                        }
                        animate()
                    }
                    c = c + 1
                }
            end()
            r = r + 1
        }
    end()
    if mdk_mouse_down() == 0 { set_int("dragging", 0) }
    set_int("top", top)
    set_int("cr", cr)  set_int("cc", cc)  set_int("ar", ar)  set_int("ac", ac)
    set_int("editing", 0)
    if editing { set_int("editing", 1) }
    if env("DUMP") != "" { dump(cr, cc, editing) }
}

// test hook: the changes as they are, written after each frame
func dump(cr, cc, editing) {
    out := []string{"cursor " + col_name(cc) + str(cr) + " editing " + str(editing) + " undo " + str(g_undo_at) + "/" + str(g_undo_end) + " dirty " + str(g_rev != g_saved_rev)}
    n := 0
    for k, v := range g_over {
        n = n + 1
        if len(g_over) <= 60 { out = append(out, col_name(k % 100) + str(k / 100) + "=" + v) }
    }
    out = append(out, "changes " + str(n))
    w := write_file(env("DUMP"), join(out, "\n") + "\n")
}
