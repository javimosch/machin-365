// Sheets DoR trial: a window, a grid, editing, undo and save over the cell
// spike. Throwaway. No formula engine, one sheet, no close warning.

extern "c" {
    header "stdio.h"
    fn rename(string, string) i32
}

// ---- the opened file: set once, never changed ----
var g_xml = bytes("")
var g_sheet = Sheet{mem: 0, count: 0, rows: []Row{}, data_at: 0, data_close: 0, data_empty: false, prefix: ""}
var g_sst = []string{}
var g_dates = []bool{}
var g_zip = bytes("")      // the file as read: unpacked again at each save
var g_sheet_path = ""
var g_masters = make(map[int]int)

// ---- changes on top of it ----
// key = row*100+col. A value is "n:12" number, "t:abc" text, "f:A1+1"
// formula or "c:" cleared. Undo step i holds lines "key \t before \t after"
// ("" = as in the file). Maps made here live outside the frame arena.
var g_over = make(map[int]string)
var g_undo = make(map[int]string)
var g_undo_at = 0       // steps that are applied
var g_undo_end = 0      // steps that exist (redo reaches here)
var g_rev = 0
var g_saved_rev = 0

var K_Z = 29
var K_B = 5
var K_F = 9
// a style change is kept like a value, under key + STYLE_KEYS: "bold:fmt"
// with "x" for "as in the file"
var STYLE_KEYS = 1000000000
var MAX_FORMAT = 20000
var g_book = StyleBook{xml: "", prefix: "", fonts: []string{}, xfs: []string{}, codes: []string{}, ids: []int{}, font_of: []int{}, new_fonts: []string{}, new_xfs: []string{}, euro_id: 0, add_euro: false}
var g_looks = []string{}    // style_look of each style in the file
var K_Y = 28
var K_F2 = 59
var ROWS_MAX = 20001
var COLS_MAX = 26
var RH = 26.0
var CW = 112.0
var GREEN = 0x1F7A52FF

func open_file() {
    init_names()
    file := read_file_bytes(env("IN"))
    es := unzip(file)
    names, paths := sheet_list(es)
    k := entry_index(es, paths[0])
    sst := []string{}
    si := entry_index(es, "xl/sharedStrings.xml")
    if si >= 0 { sst = shared_strings(es[si].data) }
    st := entry_index(es, "xl/styles.xml")
    if st >= 0 {
        g_dates = date_styles(es[st].data)
        sb := read_styles(es[st].data)
        looks := []string{}
        i := 0
        while i < len(sb.xfs) { looks = append(looks, style_look(sb, i))  i = i + 1 }
        g_looks = looks
    }
    // each assignment to a global copies once, out of the frame's arena
    g_sst = sst
    g_xml = es[k].data
    g_sheet_path = paths[0]
    g_zip = file
    // the scan stays in this frame until its records are in alloc() memory;
    // only the row list is copied out
    sc := scan_sheet(g_xml)
    g_sheet = sc
    ms := masters(g_sheet)
    for mk, mv := range ms { g_masters[mk] = mv }
}

func key_of(r, c) { return r * 100 + c }

func base_index(r, c) {
    i := lower_bound(g_sheet, r, c)
    if i < g_sheet.count && cell_at(g_sheet, i).row == r && cell_at(g_sheet, i).col == c { return i }
    return -1
}

// what the cell shows, and what editing it starts from
func base_text(i, editing) {
    c := cell_at(g_sheet, i)
    if has_formula(c) && (editing || g_rev > 0) {
        // no formula engine: after any edit a stored result may be stale
        return "=" + formula_of(g_xml, g_sheet, g_masters, i)
    }
    if c.kind == K_SHARED { return g_sst[int_in(g_xml, c.v_at, c.v_end)] }
    if c.kind == K_INLINE { return inline_text(g_xml, c) }
    v := value_text(g_xml, c)
    if c.kind == K_NUMBER && v != "" && c.style < len(g_dates) && g_dates[c.style] { return iso_date(int(floor(parse_float(v))) - 25569) }
    return v
}

func unesc(s) { return replace(replace(s, "\\n", "\n"), "\\t", "\t") }

func cell_text(r, c, editing) {
    k := key_of(r, c)
    if has(g_over, k) {
        v := g_over[k]
        body := unesc(substr(v, 2, len(v)))
        if has_prefix(v, "f:") { return "=" + body }
        return body
    }
    i := base_index(r, c)
    if i < 0 { return "" }
    return base_text(i, editing)
}

func is_number(s) {
    b := bytes(s)
    if len(b) == 0 || len(b) > 15 { return false }
    i := 0
    if byte_at(b, 0) == 45 { i = 1 }
    digits := 0
    dots := 0
    while i < len(b) {
        c := byte_at(b, i)
        if c >= 48 && c <= 57 { digits = digits + 1 } else if c == 46 { dots = dots + 1 } else { return false }
        i = i + 1
    }
    // a leading zero marks a code, not a number
    if len(b) > 1 && byte_at(b, 0) == 48 && byte_at(b, 1) != 46 { return false }
    return digits > 0 && dots <= 1
}

func encode_input(s) {
    if s == "" { return "c:" }
    if has_prefix(s, "=") { return "f:" + esc_out(substr(s, 1, len(s))) }
    if is_number(s) { return "n:" + s }
    return "t:" + esc_out(s)
}

func over_get(k) { if has(g_over, k) { return g_over[k] }  return "" }
func over_set(k, v) { if v == "" { delete(g_over, k) } else { g_over[k] = v } }

// one undo step: lines already in "key\tbefore\tafter" form
func apply_step(lines) {
    if len(lines) == 0 { return }
    g_undo[g_undo_at] = join(lines, "\n")
    g_undo_at = g_undo_at + 1
    i := g_undo_at
    while i < g_undo_end { delete(g_undo, i)  i = i + 1 }
    g_undo_end = g_undo_at
    replay(g_undo_at - 1, false)
}

func replay(step, backwards) {
    lines := split(g_undo[step], "\n")
    i := 0
    while i < len(lines) {
        p := split(lines[i], "\t")
        // "\t" inside a value is escaped, so there are always three parts
        v := p[2]
        if backwards { v = p[1] }
        over_set(parse_int(p[0]), unesc_tabs(v))
        i = i + 1
    }
    g_rev = g_rev + 1
}

func esc_step(v) { return replace(v, "\t", "\\t") }
func unesc_tabs(v) { return v }

func change(r, c, input) {
    k := key_of(r, c)
    return str(k) + "\t" + esc_step(over_get(k)) + "\t" + esc_step(encode_input(input))
}

func undo() { if g_undo_at > 0 { g_undo_at = g_undo_at - 1  replay(g_undo_at, true) } }
func redo() { if g_undo_at < g_undo_end { replay(g_undo_at, false)  g_undo_at = g_undo_at + 1 } }

func save_file() {
    t := now_ms()
    out := env("OUT")
    ok := false
    arena {
        parts := unzip(g_zip)
        si := entry_index(parts, "xl/styles.xml")
        book := read_styles(parts[si].data)
        seen := make(map[int]int)
        edits := []Edit{}
        values := 0
        for key_, v0 := range g_over {
            ck := key_
            if ck >= STYLE_KEYS { ck = ck - STYLE_KEYS }
            if has(seen, ck) { continue }
            seen[ck] = 1
            r := ck / 100
            c := ck % 100
            at := base_index(r, c)
            op := "style"
            val := ""
            if has(g_over, ck) {
                v := g_over[ck]
                op = "text"
                if has_prefix(v, "n:") { op = "number" } else if has_prefix(v, "f:") { op = "formula" } else if has_prefix(v, "c:") { op = "clear" }
                val = unesc(substr(v, 2, len(v)))
                values = values + 1
            }
            style := -1
            if has(g_over, ck + STYLE_KEYS) {
                look := split(g_over[ck + STYLE_KEYS], ":")
                base := 0
                if at >= 0 { base = cell_at(g_sheet, at).style }
                idx, nb := derive_style(book, base, look[0], look[1])
                book = nb
                style = idx
            }
            // clearing a cell the file never had changes nothing
            if op == "clear" && at < 0 && style < 0 { continue }
            edits = append(edits, Edit{ref: col_name(c) + str(r), op: op, val: val, col: c, row: r, style: style})
        }
        drop := values > 0
        sheet := edit_scanned(g_xml, g_sheet, edits, drop)
        if len(book.new_xfs) > 0 { parts[si] = Entry{name: "xl/styles.xml", data: styles_xml(book)} }
        es := []Entry{}
        i := 0
        while i < len(parts) {
            e := parts[i]
            if e.name == g_sheet_path { e = Entry{name: e.name, data: sheet} } else if drop && e.name == "xl/workbook.xml" { e = Entry{name: e.name, data: force_recalc(e.data)} }
            es = append(es, e)
            i = i + 1
        }
        tmp := out + ".tmp"
        ok = write_file_bytes(tmp, zipup(es)) >= 0 && fsync(tmp) == 0 && rename(tmp, out) == 0
    }
    if ok {
        g_saved_rev = g_rev
        set_str("status", "Saved in " + str(now_ms() - t) + " ms")
    } else {
        set_str("status", "Your file was not saved.")
    }
}

// the look of a cell: what the file's style gives, with any change on top
func cell_look(r, c) (bold, fmt) {
    bold = "0"
    fmt = "plain"
    i := base_index(r, c)
    st := 0
    if i >= 0 { st = cell_at(g_sheet, i).style }
    if st < len(g_looks) {
        p := split(g_looks[st], ":")
        bold = p[0]
        fmt = p[1]
    }
    k := key_of(r, c) + STYLE_KEYS
    if has(g_over, k) {
        q := split(g_over[k], ":")
        if q[0] != "x" { bold = q[0] }
        if q[1] != "x" { fmt = q[1] }
    }
}

func looks_number(s) {
    b := bytes(s)
    if len(b) == 0 || len(b) > 24 { return false }
    i := 0
    if byte_at(b, 0) == 45 { i = 1 }
    digits := 0
    while i < len(b) {
        c := byte_at(b, i)
        if c >= 48 && c <= 57 { digits = digits + 1 } else if c != 46 { return false }
        i = i + 1
    }
    return digits > 0
}

// 1234.5 -> "1 234,50", as in the approved mockup
func two_places(x) {
    neg := x < 0.0
    if neg { x = 0.0 - x }
    cents := int(round(x * 100.0))
    whole := str(cents / 100)
    grouped := ""
    while len(whole) > 3 {
        grouped = " " + substr(whole, len(whole) - 3, len(whole)) + grouped
        whole = substr(whole, 0, len(whole) - 3)
    }
    f := str(cents % 100)
    if len(f) < 2 { f = "0" + f }
    out := whole + grouped + "," + f
    if neg && cents != 0 { out = "-" + out }
    return out
}

func formatted(raw, fmt) {
    if fmt == "num" || fmt == "eur" {
        if !looks_number(raw) { return raw }
        out := two_places(parse_float(raw))
        if fmt == "eur" { out = out + " €" }
        return out
    }
    if fmt == "date" {
        d := raw
        if looks_number(raw) && parse_float(raw) > 60.0 && parse_float(raw) < 200000.0 { d = iso_date(int(floor(parse_float(raw))) - 25569) }
        p := split(d, "-")
        if len(p) == 3 && len(p[0]) == 4 { return p[2] + "/" + p[1] + "/" + p[0] }
    }
    return raw
}

func selection_cells(ar, ac, cr, cc) { return (maxi(ar, cr) - mini(ar, cr) + 1) * (maxi(ac, cc) - mini(ac, cc) + 1) }

func do_copy(ar, ac, cr, cc) {
    out := []string{}
    r := mini(ar, cr)
    while r <= maxi(ar, cr) {
        line := []string{}
        c := mini(ac, cc)
        while c <= maxi(ac, cc) { line = append(line, cell_text(r, c, false))  c = c + 1 }
        out = append(out, join(line, "\t"))
        r = r + 1
    }
    mdk_set_clipboard(join(out, "\n"))
    set_str("status", "Copied " + str(selection_cells(ar, ac, cr, cc)) + " cells")
}

func do_clear(ar, ac, cr, cc) {
    step := []string{}
    r := mini(ar, cr)
    while r <= maxi(ar, cr) {
        c := mini(ac, cc)
        while c <= maxi(ac, cc) { step = append(step, change(r, c, ""))  c = c + 1 }
        r = r + 1
    }
    apply_step(step)
}

// cut: onto the clipboard, then cleared, as one undo step
func do_cut(ar, ac, cr, cc) {
    do_copy(ar, ac, cr, cc)
    do_clear(ar, ac, cr, cc)
    set_str("status", "Cut " + str(selection_cells(ar, ac, cr, cc)) + " cells")
}

func do_paste(ar, ac, cr, cc) {
    clip := replace(mdk_clipboard(), "\r", "")
    if clip == "" { set_str("status", "Nothing to paste")  return }
    lines := split(clip, "\n")
    step := []string{}
    r := 0
    while r < len(lines) && mini(ar, cr) + r <= ROWS_MAX {
        if r == len(lines) - 1 && lines[r] == "" { break }
        parts := split(lines[r], "\t")
        c := 0
        while c < len(parts) && mini(ac, cc) + c <= COLS_MAX { step = append(step, change(mini(ar, cr) + r, mini(ac, cc) + c, parts[c]))  c = c + 1 }
        r = r + 1
    }
    apply_step(step)
    set_str("status", "Pasted " + str(len(step)) + " cells")
}

// toggle bold ("bold") or a number format (num, eur, date) on the selection:
// off if every cell already has it, on otherwise. One undo step.
func do_format(ar, ac, cr, cc, what) {
    if selection_cells(ar, ac, cr, cc) > MAX_FORMAT { set_str("status", "Select fewer cells to format them")  return }
    all := true
    r := mini(ar, cr)
    while r <= maxi(ar, cr) {
        c := mini(ac, cc)
        while c <= maxi(ac, cc) {
            b, f := cell_look(r, c)
            if what == "bold" { if b != "1" { all = false } } else if f != what { all = false }
            c = c + 1
        }
        r = r + 1
    }
    step := []string{}
    r = mini(ar, cr)
    while r <= maxi(ar, cr) {
        c := mini(ac, cc)
        while c <= maxi(ac, cc) {
            k := key_of(r, c) + STYLE_KEYS
            cur := over_get(k)
            p := []string{"x", "x"}
            if cur != "" { p = split(cur, ":") }
            b := p[0]
            f := p[1]
            if what == "bold" { if all { b = "0" } else { b = "1" } } else { if all { f = "plain" } else { f = what } }
            step = append(step, str(k) + "\t" + cur + "\t" + b + ":" + f)
            c = c + 1
        }
        r = r + 1
    }
    apply_step(step)
}

// a total under each selected column; for a single cell, of the numbers above
func do_sum(ar, ac, cr, cc) (row_) {
    top := mini(ar, cr)
    bottom := maxi(ar, cr)
    row_ = bottom + 1
    if top == bottom && mini(ac, cc) == maxi(ac, cc) {
        r := cr - 1
        while r >= 1 && looks_number(cell_text(r, cc, false)) { r = r - 1 }
        if r == cr - 1 { set_str("status", "No numbers above to add up")  row_ = cr  return }
        apply_step([]string{change(cr, cc, "=SUM(" + col_name(cc) + str(r + 1) + ":" + col_name(cc) + str(cr - 1) + ")")})
        row_ = cr
        return
    }
    if bottom >= ROWS_MAX { set_str("status", "No room below for a total")  row_ = bottom  return }
    step := []string{}
    c := mini(ac, cc)
    while c <= maxi(ac, cc) {
        step = append(step, change(bottom + 1, c, "=SUM(" + col_name(c) + str(top) + ":" + col_name(c) + str(bottom) + ")"))
        c = c + 1
    }
    apply_step(step)
}

func selection_summary(ar, ac, cr, cc) {
    n := selection_cells(ar, ac, cr, cc)
    if n < 2 { return "" }
    if n > MAX_FORMAT { return str(n) + " cells selected" }
    count := 0
    total := 0.0
    r := mini(ar, cr)
    while r <= maxi(ar, cr) {
        c := mini(ac, cc)
        while c <= maxi(ac, cc) {
            v := cell_text(r, c, false)
            if looks_number(v) { count = count + 1  total = total + parse_float(v) }
            c = c + 1
        }
        r = r + 1
    }
    out := str(n) + " cells selected"
    if count > 0 { out = out + "      Sum " + two_places(total) + "      Average " + two_places(total / float(count)) }
    return out
}

// the next cell after (r, c), row by row, whose text contains q
func find_next(q, r, c) (fr, fc) {
    fr = 0
    fc = 0
    needle := to_lower(q)
    pos := (r - 1) * COLS_MAX + c          // the cell after the cursor
    n := ROWS_MAX * COLS_MAX
    i := 0
    while i < n && fr == 0 {
        arena {
            end_ := i + 2000
            while i < end_ && i < n && fr == 0 {
                at := (pos + i) % n
                rr := at / COLS_MAX + 1
                cc2 := at % COLS_MAX + 1
                if index(to_lower(cell_text(rr, cc2, false)), needle) >= 0 { fr = rr  fc = cc2 }
                i = i + 1
            }
        }
    }
}

func menu_item(label, hint) {
    i := row()
    fillw()
    padxy(14.0, 7.0)
    gap(18.0)
    align(A_CENTER)
    if hovered(i) { bg(C_SURFACE2)  mdk_cursor(2) }
    text(label, 13.0)
    spacer()
    text(hint, 12.0)
    fg(C_MUTED)
    end()
    return clicked(i)
}

func mini(a, b) { if a < b { return a }  return b }
func maxi(a, b) { if a > b { return a }  return b }
func clampi(v, lo, hi) { return maxi(lo, mini(v, hi)) }

func light_theme() {
    C_BG = 0xFFFFFFFF  C_SURFACE = 0xF4F3F9FF  C_TEXT = 0x1C1C26FF  C_MUTED = 0x5F5F73FF
    C_ACCENT = GREEN  C_ACCENT_HI = 0x258C60FF  C_ACCENT_LO = 0x185F40FF  C_BORDER = 0xD9D7E6FF
    C_SURFACE2 = 0xE9E8F1FF  C_INPUT = 0xFFFFFFFF  C_SELECTION = 0x1F7A5240
}

var STATUS_H = 30.0

func sep() {
    col()
    size(1.0, 20.0)
    bg(C_BORDER)
    end()
}

func tool(label) {
    i := row()
    padxy(10.0, 6.0)
    radius(7.0)
    border(1.0, C_BORDER)
    if hovered(i) { bg(C_SURFACE2)  mdk_cursor(2) } else { bg(C_BG) }
    text(label, 13.0)
    end()
    return clicked(i)
}

func start_edit(value) {
    set_str("fx", value)
    set_int("fx:caret", len(value))
    set_int("editing", 1)
    focus("fx")
    animate()
}

func view() {
    if state_int("loaded", 0) == 0 {
        set_int("loaded", 1)
        light_theme()
        open_file()
        set_int("top", 1)
        set_int("cr", 2)  set_int("cc", 1)  set_int("ar", 2)  set_int("ac", 1)
        set_str("status", str(g_sheet.count) + " cells")
        animate()
        return
    }
    cr := state_int("cr", 2)
    cc := state_int("cc", 1)
    ar := state_int("ar", 2)
    ac := state_int("ac", 1)
    top := state_int("top", 1)
    editing := state_int("editing", 0) == 1
    was_editing := editing

    col()
    fill()
        // while the menu is open, the grid takes no mouse or keys
        menu := state_int("menu", 0) == 1
        finding := state_int("finding", 0) == 1
        typing := editing || (finding && focused("find"))
        act := ""
        row()
        fillw()
        padxy(10.0, 7.0)
        gap(5.0)
        align(A_CENTER)
        bg(C_SURFACE)
            if tool("Save") || (ctrl() && key(K_S)) { act = "save" }
            if tool("Undo") || (!typing && ctrl() && key(K_Z)) { act = "undo" }
            if tool("Redo") || (!typing && ctrl() && key(K_Y)) { act = "redo" }
            sep()
            if tool("Cut") || (!typing && ctrl() && key(K_X)) { act = "cut" }
            if tool("Copy") || (!typing && ctrl() && key(K_C)) { act = "copy" }
            if tool("Paste") || (!typing && ctrl() && key(K_V)) { act = "paste" }
            if tool("Clear") || (!typing && !menu && key(K_DELETE)) { act = "clear" }
            sep()
            if tool("Bold") || (!typing && ctrl() && key(K_B)) { act = "bold" }
            if tool("Number") { act = "num" }
            if tool("Euro €") { act = "eur" }
            if tool("Date") { act = "date" }
            sep()
            if tool("Sum") { act = "sum" }
            if tool("Find") || (ctrl() && key(K_F)) { act = "find" }
        end()
        if finding {
            row()
            fillw()
            padxy(10.0, 4.0)
            gap(8.0)
            align(A_CENTER)
                text("Find", 13.0)
                col()
                width(280.0)
                    q := text_field("find", "Text to look for")
                end()
                seek := tool("Find next") || (focused("find") && key(K_RETURN))
                if seek && trim(q) != "" {
                    fr, fc := find_next(q, cr, cc)
                    if fr == 0 { set_str("status", "Nothing found") } else {
                        cr = fr  cc = fc  ar = fr  ac = fc
                        set_int("follow", 1)
                        set_str("status", "Found in " + col_name(fc) + str(fr))
                    }
                    focus("find")
                    animate()
                }
                if tool("Close") || (focused("find") && key(K_ESCAPE)) { set_int("finding", 0)  blur()  animate() }
            end()
        }
        row()
        fillw()
        padxy(10.0, 4.0)
        gap(8.0)
        align(A_CENTER)
            row()
            width(70.0)
                text(col_name(cc) + str(cr), 14.0)
                bold()
            end()
            col()
            grow(1.0)
                if editing {
                    v := text_field("fx", "")
                    if key(K_RETURN) {
                        apply_step([]string{change(cr, cc, v)})
                        editing = false
                        cr = cr + 1
                        ar = cr  ac = cc
                        blur()
                        animate()
                    } else if key(K_ESCAPE) || !focused("fx") {
                        editing = false
                        blur()
                        animate()
                    }
                } else {
                    row()
                    padxy(12.0, 9.0)
                    border(1.0, C_BORDER)
                    radius(8.0)
                        text(cell_text(cr, cc, true), 14.0)
                    end()
                }
            end()
        end()

        if !was_editing && !menu && !typing {
            moved := false
            if key(K_DOWN) { cr = cr + 1  moved = true }
            if key(K_UP) { cr = cr - 1  moved = true }
            if key(K_RIGHT) { cc = cc + 1  moved = true }
            if key(K_LEFT) { cc = cc - 1  moved = true }
            if key(K_PAGEDOWN) { cr = cr + 25  moved = true }
            if key(K_PAGEUP) { cr = cr - 25  moved = true }
            cr = clampi(cr, 1, ROWS_MAX)
            cc = clampi(cc, 1, COLS_MAX)
            if moved { if !shift() { ar = cr  ac = cc }  set_int("follow", 1)  animate() }
            if key(K_F2) || key(K_RETURN) { start_edit(cell_text(cr, cc, true))  editing = true } else if !ctrl() && mdk_typed() != "" { start_edit(mdk_typed())  editing = true }
        }

        // ---- the grid: only what fits is built ----
        find_h := 0.0
        if finding { find_h = 46.0 }
        visible := int((mdk_win_h() - 44.0 - 50.0 - RH - STATUS_H - find_h) / RH)
        top = top - int(mdk_wheel() * 3.0)
        if state_int("follow", 0) == 1 {
            if cr < top { top = cr }
            if cr >= top + visible { top = cr - visible + 1 }
            set_int("follow", 0)
        }
        top = clampi(top, 1, ROWS_MAX - visible + 1)
        left := state_int("left", 1)
        ncols := int((mdk_win_w() - 70.0) / CW)
        if cc < left { left = cc }
        if cc >= left + ncols { left = cc - ncols + 1 }
        left = clampi(left, 1, maxi(1, COLS_MAX - ncols + 1))
        set_int("left", left)

        row()
        height(RH)
            col()
            width(70.0)
            end()
            c := left
            while c < left + ncols && c <= COLS_MAX {
                row()
                width(CW)
                center()
                bg(C_SURFACE)
                border(0.5, C_BORDER)
                    text(col_name(c), 12.0)
                    fg(C_MUTED)
                end()
                c = c + 1
            }
        end()
        r := top
        while r < top + visible && r <= ROWS_MAX {
            row()
            height(RH)
                row()
                width(70.0)
                height(RH)
                center()
                bg(C_SURFACE)
                    text(str(r), 12.0)
                    fg(C_MUTED)
                end()
                c = left
                while c < left + ncols && c <= COLS_MAX {
                    i := row()
                    width(CW)
                    height(RH)
                    padxy(7.0, 4.0)
                    clip()
                    if r >= mini(ar, cr) && r <= maxi(ar, cr) && c >= mini(ac, cc) && c <= maxi(ac, cc) { bg(C_SELECTION) }
                    if r == cr && c == cc { border(2.0, GREEN) } else { border(0.5, C_BORDER) }
                    bold_, fmt := cell_look(r, c)
                    raw := cell_text(r, c, false)
                    if looks_number(raw) { justify(J_END) }
                        text(formatted(raw, fmt), 13.0)
                        if bold_ == "1" { bold() }
                    end()
                    if !menu && right_clicked(i) {
                        // outside the selection: the menu is about this cell
                        if !(r >= mini(ar, cr) && r <= maxi(ar, cr) && c >= mini(ac, cc) && c <= maxi(ac, cc)) { cr = r  cc = c  ar = r  ac = c }
                        set_int("menu", 1)
                        set_f("menu:x", float(mdk_mouse_x()))
                        set_f("menu:y", float(mdk_mouse_y()))
                        animate()
                    }
                    if !menu && mdk_mouse_down() != 0 && prev_rect_has(i, mdk_mouse_x(), mdk_mouse_y()) {
                        cr = r
                        cc = c
                        if state_int("dragging", 0) == 0 {
                            set_int("dragging", 1)
                            if !shift() { ar = r  ac = c }
                        }
                        animate()
                    }
                    c = c + 1
                }
            end()
            r = r + 1
        }
        spacer()
        row()
        fillw()
        height(STATUS_H)
        padxy(12.0, 5.0)
        gap(20.0)
        bg(C_SURFACE)
            text(selection_summary(ar, ac, cr, cc), 13.0)
            fg(C_MUTED)
            spacer()
            text(state_str("status", ""), 13.0)
            fg(C_MUTED)
            if g_rev != g_saved_rev { text("Unsaved changes", 13.0) } else { text("No unsaved changes", 13.0) }
            fg(C_MUTED)
        end()
        // drawn last, so it lies on top of everything
        if menu {
            mx := float(state_f("menu:x", 0.0))
            my := float(state_f("menu:y", 0.0))
            if mx > mdk_win_w() - 200.0 { mx = mdk_win_w() - 200.0 }
            if my > mdk_win_h() - 220.0 { my = mdk_win_h() - 220.0 }
            box := col()
            width(190.0)
            padxy(0.0, 6.0)
            radius(8.0)
            bg(C_BG)
            border(1.0, C_BORDER)
            shadow(16.0, 0x00000040)
            at(mx, my)
                if menu_item("Cut", "Ctrl+X") { act = "cut" }
                if menu_item("Copy", "Ctrl+C") { act = "copy" }
                if menu_item("Paste", "Ctrl+V") { act = "paste" }
                if menu_item("Clear", "Delete") { act = "clear" }
                divider()
                if menu_item("Bold", "Ctrl+B") { act = "bold" }
                if menu_item("Sum", "") { act = "sum" }
            end()
            outside := (mdk_mouse_released() != 0 && !hovered(box)) || right_clicked(box) == false && mdk_right_pressed() != 0
            if act != "" || key(K_ESCAPE) || outside { set_int("menu", 0)  animate() }
        }
    end()
    // one place acts, whether it came from the toolbar, a key or the menu
    if act != "" && !editing {
        if act == "save" { save_file() }
        if act == "undo" { undo() }
        if act == "redo" { redo() }
        if act == "cut" { do_cut(ar, ac, cr, cc) }
        if act == "copy" { do_copy(ar, ac, cr, cc) }
        if act == "paste" { do_paste(ar, ac, cr, cc) }
        if act == "clear" { do_clear(ar, ac, cr, cc) }
        if act == "bold" || act == "num" || act == "eur" || act == "date" { do_format(ar, ac, cr, cc, act) }
        if act == "sum" {
            to := do_sum(ar, ac, cr, cc)
            cr = to  ar = to
            set_int("follow", 1)
        }
        if act == "find" { set_int("finding", 1)  focus("find") }
        animate()
    }
    if mdk_mouse_down() == 0 { set_int("dragging", 0) }
    set_int("top", top)
    set_int("cr", cr)  set_int("cc", cc)  set_int("ar", ar)  set_int("ac", ac)
    set_int("editing", 0)
    if editing { set_int("editing", 1) }
    if env("DUMP") != "" { dump(cr, cc, editing) }
}

// test hook: the changes as they are, written after each frame
func dump(cr, cc, editing) {
    out := []string{"cursor " + col_name(cc) + str(cr) + " editing " + str(editing) + " undo " + str(g_undo_at) + "/" + str(g_undo_end) + " dirty " + str(g_rev != g_saved_rev)}
    n := 0
    for k, v := range g_over {
        n = n + 1
        if len(g_over) <= 60 { out = append(out, col_name(k % 100) + str(k / 100) + "=" + v) }
    }
    out = append(out, "changes " + str(n))
    w := write_file(env("DUMP"), join(out, "\n") + "\n")
}
