// DoR spike: how fast can MFL parse and evaluate spreadsheet formulas?
// 20000 rows: A,B numbers; C "=A#+B#*2"; plus one SUM over all of C.
func col_of(s, i) { return byte_at(bytes(s), i) - 65 }

// term := number | ref ; expr := product {+ product} ; product := term {* term}
func term(f, pos, vals) (v, p) {
    b := bytes(f)
    p = pos
    ch := byte_at(b, p)
    if ch >= 65 && ch <= 90 {
        col := ch - 65
        p = p + 1
        row := 0
        while p < len(b) && byte_at(b, p) >= 48 && byte_at(b, p) <= 57 { row = row * 10 + byte_at(b, p) - 48  p = p + 1 }
        v = vals[(row - 1) * 3 + col]
        return
    }
    start := p
    while p < len(b) && ((byte_at(b, p) >= 48 && byte_at(b, p) <= 57) || byte_at(b, p) == 46) { p = p + 1 }
    v = parse_float(substr(f, start, p))
}
func product(f, pos, vals) (v, p) {
    v, p = term(f, pos, vals)
    while p < len(f) && substr(f, p, p + 1) == "*" { w, q := term(f, p + 1, vals)  v = v * w  p = q }
}
func eval(f, vals) {
    v, p := product(f, 1, vals)
    while p < len(f) && substr(f, p, p + 1) == "+" { w, q := product(f, p + 1, vals)  v = v + w  p = q }
    return v
}

func main() {
    n := 20000
    vals := []float{}
    formulas := []string{}
    r := 0
    while r < n {
        vals = append(vals, float(r))
        vals = append(vals, 1.5)
        vals = append(vals, 0.0)
        formulas = append(formulas, "=A" + str(r + 1) + "+B" + str(r + 1) + "*2")
        r = r + 1
    }
    t0 := now_ms()
    pass := 0
    sum := 0.0
    while pass < 10 {
        r = 0
        while r < n { vals[r * 3 + 2] = eval(formulas[r], vals)  r = r + 1 }
        sum = 0.0
        r = 0
        while r < n { sum = sum + vals[r * 3 + 2]  r = r + 1 }
        pass = pass + 1
    }
    dt := now_ms() - t0
    println("20000 formulas + SUM, parsed from text each time: " + str(float(dt) / 10.0) + " ms per full recalculation")
    println("sum " + str(sum) + " expected " + str(float(n) * float(n - 1) / 2.0 + 3.0 * float(n)))
    println("0.1+0.2 shows as: " + str(0.1 + 0.2))
}
