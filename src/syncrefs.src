// syncrefs.src — which collections a sync pass covers.
//
// collection discovery: --collections arg > config.sync_collections >
// GET /v1/collections (Go bkn only — machin-bkn has no HTTP list route).
// coll_arg is the already-parsed --collections/--coll value ("" = flag absent).
// parse_coll_list lives in colls.src with the ref validators.

// Set when empty discovery is explained by an org-less session on an
// account that HAS orgs: cmd_sync exits non-zero so the pass cannot
// report a healthy "nothing to sync" while every org-scoped collection
// is invisible to the token (#119).
var sync_orgless_block = false

// A remote probe that does not return 200 (older bkn, non-bkn server,
// missing route) used to be indistinguishable from "remote has no
// collections" — remote-only collections then silently never sync.
// Warn once per invocation; the pass still runs on whatever the probes
// did return, since local-discovered collections sync correctly.
func warn_remote_discovery(st, err) {
    if err != "" {
        perr("machin-365: remote collection discovery failed: " + err +
            " — remote-only collections will not sync;" +
            " set them via sync --collections or config set sync_collections")
        return
    }
    perr("machin-365: remote does not support collection discovery" +
        " (GET /v1/collections -> HTTP " + str(st) + ")" +
        " — remote-only collections will not sync;" +
        " set them via sync --collections or config set sync_collections")
}

// bkn ref shape, mirroring the server's own rule (store splitRef /
// validSegment): <ns>/<coll> where each segment starts with a lowercase
// letter and continues with [a-z0-9_-], at most 63 chars. Probe output is
// untrusted — it arrives over HTTP from a remote we do not control — so a
// discovered "ref" that cannot name a real collection is dropped before it
// can be synced, provisioned on the remote, or persisted to config.json
// (#109: intermittent phantom refs reached all three).
func seg_ok(seg) {
    if len(seg) == 0 || len(seg) > 63 { return false }
    f := substr(seg, 0, 1)
    if f < "a" || f > "z" { return false }
    i := 0
    while i < len(seg) {
        c := substr(seg, i, i + 1)
        good := false
        if c >= "a" && c <= "z" { good = true }
        if c >= "0" && c <= "9" { good = true }
        if c == "-" || c == "_" { good = true }
        if !good { return false }
        i = i + 1
    }
    return true
}

func ref_ok(ref) {
    at := index(ref, "/")
    if at <= 0 { return false }
    rest := substr(ref, at + 1, len(ref))
    if index(rest, "/") >= 0 { return false }
    return seg_ok(substr(ref, 0, at)) && seg_ok(rest)
}

// One side's /v1/collections answer, parsed into validated refs: each
// ".collections[i].ref" that passes the bkn segment rule (ref_ok), deduped.
// dropped counts the malformed ones for the caller's diagnostic. ok is
// true only on a clean 200 — a failed probe yields an empty list the
// caller must not read as "this side has no collections".
func coll_probe(base, tok) (refs, st, err, ok, dropped) {
    refs = []string{}
    st = 0
    err = ""
    ok = false
    dropped = 0
    s, b, e := api_get(base, tok, "/v1/collections")
    st = s
    err = e
    ok = e == "" && s == 200
    if !ok { return }
    j := 0
    while true {
        r, e := json_get(b, ".collections[" + str(j) + "].ref")
        if e != "" { break }
        ref := parse(r, "")
        if !ref_ok(ref) {
            dropped = dropped + 1
        } else if !has_ref(refs, ref) {
            refs = append(refs, ref)
        }
        j = j + 1
    }
    return
}

// An org-less token is refused by every org-scoped collection, so
// /v1/collections answers 200 with an empty set — indistinguishable
// from "remote has no collections" (#119). When the account actually
// belongs to orgs, those orgs' collections are exactly what this token
// cannot see: warn and let cmd_sync fail the pass. Scope is judged on
// the token actually in use (env overrides included): a JWT's org
// claim when readable, config.org for opaque tokens that carry no
// claim to inspect. auth_my_orgs then confirms memberships before we
// cry wolf — a genuinely org-less account, or a dead/foreign token,
// has nothing to warn about.
func warn_orgless_session() {
    tok := sync_remote_tok
    p1 := index(tok, ".")
    rest := ""
    if p1 > 0 { rest = substr(tok, p1 + 1, len(tok)) }
    jwt_shaped := p1 > 0 && index(rest, ".") > 0
    if jwt_shaped {
        if jwt_org(tok) != "" { return }
    } else if load_config().org != "" {
        return
    }
    orgs, ok := auth_my_orgs(sync_remote, tok)
    if !ok || len(orgs) == 0 { return }
    sync_orgless_block = true
    perr("machin-365: session has no org scope — org-scoped collections" +
        " are invisible to this token;" +
        " run: auth login --org SLUG (or: auth switch-org SLUG)")
}

func discover_refs(coll_arg) (refs) {
    refs = []string{}
    if coll_arg != "" { return parse_coll_list(coll_arg) }
    c := load_config()
    if c.sync_collections != "" { return parse_coll_list(c.sync_collections) }
    // probe both sides, union what each exposes — twice per side. The
    // discovered set drives the whole pass (sync, remote provisioning, and
    // --collections persistence), and probe output has intermittently
    // yielded well-formed refs that exist on neither side (#109). When both
    // probes of a side answer, a ref must appear in BOTH to be believed:
    // transient garbage does not survive a second read. A failed second
    // probe cannot disprove anything, so the side falls back to its first
    // answer — the same trust level as the single probe this replaced. A
    // collection created between the two probes is picked up next pass.
    remote_ok := false
    remote_st := 0
    remote_err := ""
    dropped := 0
    unconfirmed := 0
    i := 0
    while i < 2 {
        base := sync_remote
        tok := sync_remote_tok
        if i == 1 { base = sync_local  tok = sync_local_tok }
        r1, st1, e1, ok1, d1 := coll_probe(base, tok)
        r2, st2, e2, ok2, d2 := coll_probe(base, tok)
        dropped = dropped + d1 + d2
        side := []string{}
        if ok1 && ok2 {
            a := 0
            while a < len(r1) {
                if has_ref(r2, r1[a]) && !has_ref(side, r1[a]) {
                    side = append(side, r1[a])
                }
                a = a + 1
            }
            unconfirmed = unconfirmed + len(r1) + len(r2) - 2 * len(side)
        } else if ok1 {
            side = r1
        } else if ok2 {
            side = r2
        }
        if i == 0 {
            remote_ok = ok1 || ok2
            // the warn below only fires when BOTH probes failed — report
            // the latest failure either way
            if !ok1 { remote_st = st1  remote_err = e1 }
            if !ok2 { remote_st = st2  remote_err = e2 }
        }
        a := 0
        while a < len(side) {
            if !has_ref(refs, side[a]) { refs = append(refs, side[a]) }
            a = a + 1
        }
        i = i + 1
    }
    if dropped > 0 {
        perr("machin-365: discovery dropped " + str(dropped) +
            " malformed collection ref(s)")
    }
    if unconfirmed > 0 {
        perr("machin-365: discovery ignored " + str(unconfirmed) +
            " unconfirmed collection ref(s)")
    }
    if !remote_ok { warn_remote_discovery(remote_st, remote_err) }
    return refs
}
