// syncrefs.src — which collections a sync pass covers.
//
// collection discovery: --collections arg > config.sync_collections >
// GET /v1/collections on the LOCAL bkn only — probed twice, with the
// confirmation rule in discover_refs — cross-checked against the
// collections table of the suite-managed store read directly over
// SQLite (local_coll_db_refs). The remote list is never unioned
// in: on a shared multi-tenant server it enumerates every collection
// the token can read — foreign tenants' included — and syncing those
// replicates other users' data locally, then fails every pass on
// write-back 403s (#107). Collections that exist only on the remote
// opt in explicitly via --collections or sync_collections; one remote
// probe per pass still counts them so the escape hatch stays
// discoverable.
// coll_arg is the already-parsed --collections/--coll value ("" = flag absent).
// parse_coll_list and the ref validators (ref_ok/seg_ok) live in colls.src.

// Set when empty discovery is explained by an org-less session on an
// account that HAS orgs: cmd_sync exits non-zero so the pass cannot
// report a healthy "nothing to sync" while every org-scoped collection
// is invisible to the token (#119).
var sync_orgless_block = false

// coll_probe parses one side's /v1/collections answer into validated refs:
// each ".collections[i].ref" that passes ref_ok (colls.src — the bkn
// segment rule), deduped. dropped counts the malformed ones for the
// caller's diagnostic. ok is true only on a clean 200 — a failed probe
// yields an empty list the caller must not read as "this side has no
// collections".
func coll_probe(base, tok) (refs, st, err, ok, dropped) {
    refs = []string{}
    st = 0
    err = ""
    ok = false
    dropped = 0
    s, b, e := api_get(base, tok, "/v1/collections")
    st = s
    err = e
    ok = e == "" && s == 200
    if !ok { return }
    j := 0
    while true {
        r, e := json_get(b, ".collections[" + str(j) + "].ref")
        if e != "" { break }
        ref := parse(r, "")
        if !ref_ok(ref) {
            dropped = dropped + 1
        } else if !has_ref(refs, ref) {
            refs = append(refs, ref)
        }
        j = j + 1
    }
    return
}

type CollDbRow struct { ref string }

// local_coll_db_refs reads the suite-managed local store's collections
// table straight out of bkn/bkn.db — the same rows GET /v1/collections
// serves, fetched without the HTTP body → json_get → parse pipeline that
// intermittently produced well-formed refs present on neither side
// (#109). ok is false when the local endpoint is env-overridden (the db
// then belongs to a different bkn, or the token may not see every row)
// or the file cannot be read as a bkn store; the caller then keeps the
// probe answer. An honest probe can never legitimately disagree with
// the table — it IS the table — so a mismatch means probe corruption
// and the store wins.
func local_coll_db_refs() (refs, ok) {
    refs = []string{}
    ok = false
    if env("MACHIN_365_LOCAL") != "" || env("MACHIN_365_LOCAL_TOKEN") != "" { return }
    if !is_dir(suite_home() + "/bkn") { return }
    if file_size(bkn_db()) <= 0 { return }
    db := sqlite_open(bkn_db())
    if db == 0 { return }
    rows := sqlite_query(db,
        "SELECT ns || '/' || name AS ref FROM collections" +
        " ORDER BY ns, name", []string{})
    sqlite_close(db)
    if rows == "" { return }
    parsed := parse(rows, []CollDbRow{})
    i := 0
    while i < len(parsed) {
        r := parsed[i].ref
        if ref_ok(r) && !has_ref(refs, r) { refs = append(refs, r) }
        i = i + 1
    }
    ok = true
    return
}

// set equality for two deduped ref lists.
func same_ref_set(a, b) {
    if len(a) != len(b) { return false }
    i := 0
    while i < len(a) {
        if !has_ref(b, a[i]) { return false }
        i = i + 1
    }
    return true
}

// A local probe that does not return 200 (older bkn without the route,
// unreachable service) must not be indistinguishable from "nothing to
// sync" — auto-discovery then silently covers zero collections. Warn
// once per invocation; explicit --collections/config still work.
func warn_local_discovery(st, err) {
    if err != "" {
        perr("machin-365: local collection discovery failed: " + err +
            " — no collections will auto-sync;" +
            " set them via sync --collections or config set sync_collections")
        return
    }
    perr("machin-365: local bkn does not support collection discovery" +
        " (GET /v1/collections -> HTTP " + str(st) + ")" +
        " — no collections will auto-sync;" +
        " set them via sync --collections or config set sync_collections")
}

// An org-less token is refused by every org-scoped collection, so
// /v1/collections answers 200 with an empty set — indistinguishable
// from "remote has no collections" (#119). When the account actually
// belongs to orgs, those orgs' collections are exactly what this token
// cannot see: warn and let cmd_sync fail the pass. Scope is judged on
// the token actually in use (env overrides included): a JWT's org
// claim when readable, config.org for opaque tokens that carry no
// claim to inspect. auth_my_orgs then confirms memberships before we
// cry wolf — a genuinely org-less account, or a dead/foreign token,
// has nothing to warn about.
func warn_orgless_session() {
    tok := sync_remote_tok
    p1 := index(tok, ".")
    rest := ""
    if p1 > 0 { rest = substr(tok, p1 + 1, len(tok)) }
    jwt_shaped := p1 > 0 && index(rest, ".") > 0
    if jwt_shaped {
        if jwt_org(tok) != "" { return }
    } else if load_config().org != "" {
        return
    }
    orgs, ok := auth_my_orgs(sync_remote, tok)
    if !ok || len(orgs) == 0 { return }
    sync_orgless_block = true
    perr("machin-365: session has no org scope — org-scoped collections" +
        " are invisible to this token;" +
        " run: auth login --org SLUG (or: auth switch-org SLUG)")
}

// Write the sticky sync_collections set from an explicit --collections
// list, minus the refs the last pass reported absent on the remote and
// empty locally (sync_absent_pass). Persisting those would let one typo
// replace the working sync set with refs that exist nowhere — every
// later bare sync would replicate nothing while exiting 0 (#131).
// Returns the refs kept; empty means nothing was persisted and
// config.json is untouched. The all-absent case prints nothing here —
// each caller reports it in its own voice (one-shot fails, --watch
// waits for a later pass).
func persist_explicit_refs(refs) (keep) {
    keep = []string{}
    absent := []string{}
    i := 0
    while i < len(refs) {
        if has_ref(sync_absent_pass, refs[i]) {
            absent = append(absent, refs[i])
        } else {
            keep = append(keep, refs[i])
        }
        i = i + 1
    }
    if len(keep) > 0 {
        if len(absent) > 0 {
            perr("machin-365: sync: --collections ref(s) absent on the" +
                " remote and empty locally — not persisted: " +
                join_strs(absent, ","))
        }
        persist_coll_arg(keep)
    }
    return
}

// One-shot `sync --collections` persist step: writes the sticky set minus
// absent refs; when every explicit ref is absent, leaves config.json alone
// and returns 1 so the run cannot pass for a healthy sync that replicated
// nothing (#131).
func persist_coll_flag(refs) (code) {
    code = 0
    if len(persist_explicit_refs(refs)) == 0 {
        eprintln("machin-365: sync: every --collections ref is absent" +
            " on the remote and empty locally — sync_collections" +
            " left unchanged (check for typos)")
        return 1
    }
    return code
}

// discover_refs returns the sync set plus whether it was auto-discovered
// (true) rather than named explicitly — discovered refs get fail-soft
// treatment on remote write-denial in sync.src (#107).
func discover_refs(coll_arg) (refs, discovered) {
    refs = []string{}
    discovered = false
    if coll_arg != "" { return parse_coll_list(coll_arg), false }
    c := load_config()
    if c.sync_collections != "" { return parse_coll_list(c.sync_collections), false }
    discovered = true
    // Probe the LOCAL bkn twice. The discovered set drives the whole
    // pass (sync, remote provisioning, and --collections persistence),
    // and probe output has intermittently yielded well-formed refs that
    // exist on neither side (#109). When both probes answer, a ref must
    // appear in BOTH to be believed: transient garbage does not survive
    // a second read. A failed second probe cannot disprove anything, so
    // discovery falls back to the first answer — the same trust level as
    // the single probe this replaced. A collection created between the
    // two probes is picked up next pass.
    r1, _, _, ok1, d1 := coll_probe(sync_local, sync_local_tok)
    r2, st2, e2, ok2, d2 := coll_probe(sync_local, sync_local_tok)
    dropped := d1 + d2
    side := []string{}
    unconfirmed := 0
    if ok1 && ok2 {
        a := 0
        while a < len(r1) {
            if has_ref(r2, r1[a]) && !has_ref(side, r1[a]) {
                side = append(side, r1[a])
            }
            a = a + 1
        }
        unconfirmed = len(r1) + len(r2) - 2 * len(side)
    } else if ok1 {
        side = r1
    } else if ok2 {
        side = r2
    }
    a := 0
    while a < len(side) {
        if !has_ref(refs, side[a]) { refs = append(refs, side[a]) }
        a = a + 1
    }
    // The suite-managed store's collections table is the same source the
    // probe reads, fetched over SQLite instead of HTTP — a second,
    // independent channel for the phantom refs probe output intermittently
    // produced (#109). When it answers it is authoritative: an honest
    // probe cannot disagree with the table it serves.
    drefs, dok := local_coll_db_refs()
    if dok {
        if !ok1 && !ok2 {
            perr("machin-365: collection probe failed but the local" +
                " store answered — discovering from bkn.db")
        } else if !same_ref_set(refs, drefs) {
            perr("machin-365: collection probe disagreed with the local" +
                " store — trusting the store (" + str(len(drefs)) +
                " ref(s))")
        }
        refs = drefs
    } else if !ok1 && !ok2 {
        // both probes failed — report the latest failure
        warn_local_discovery(st2, e2)
    }
    // Remote-only collections are NOT auto-synced — on a shared server
    // most of them belong to other tenants (#107). One probe per
    // process still tells the user they exist and how to opt in; count
    // only, since the names are mostly not theirs. A failed remote probe
    // only costs the count — it feeds nothing else.
    rr, _, _, rok, _ := coll_probe(sync_remote, sync_remote_tok)
    extra := 0
    if rok {
        i := 0
        while i < len(rr) {
            // sync/tombstones syncs unconditionally — it is not "absent"
            if rr[i] != sync_tomb_coll && !has_ref(refs, rr[i]) { extra = extra + 1 }
            i = i + 1
        }
    }
    if dropped > 0 {
        perr("machin-365: discovery dropped " + str(dropped) +
            " malformed collection ref(s)")
    }
    if unconfirmed > 0 {
        perr("machin-365: discovery ignored " + str(unconfirmed) +
            " unconfirmed collection ref(s)")
    }
    if extra > 0 {
        perr("machin-365: sync: remote lists " + str(extra) +
            " collection(s) absent locally — not auto-synced;" +
            " add yours via sync --collections or config set sync_collections")
    }
    return refs, discovered
}
