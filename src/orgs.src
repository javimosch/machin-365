// orgs.src — org commands (member add/list/remove live in members.src).
// Sync is org-scoped: rows replicate only inside the caller's org, so a
// shared workspace IS a shared org. These wrap the bkn membership surface
// the suite never exposed:
//
//   auth memberships            — the signed-in account's org memberships
//   auth orgs                   — org slugs the account belongs to
//   auth org create <slug> [--name N]  — create an org, creator becomes owner
//   auth switch-org <slug>      — re-scope the stored session, no password
//
// member/memberships/orgs run on the config'd server with the stored
// access token; a 401 rotates the session once and retries (auth_api) —
// the same recovery sync performs. switch-org and org create trade the
// stored refresh_token for an org-scoped pair via POST
// /v1/auth/switch-org; rotation is unconditional server-side, so BOTH
// tokens must persist.
//
// GET /v1/auth/orgs (every org on the server) is admin-token-only on bkn
// and the suite stores no admin token, so `auth orgs` reports the caller's
// own memberships via /v1/auth/me instead.

type OrgMembership struct {
    org_slug string
    role string
    user_email string
}

// auth_api performs an authenticated call against the configured server.
// On a 401 it refreshes the stored session once and retries the call.
func auth_api(method, path, reqbody) (st, resp, err) {
    st = 0
    resp = ""
    err = ""
    c := load_config()
    server := strip_slash(c.server)
    hdrs := []string{"Authorization: Bearer " + c.token}
    if reqbody != "" { hdrs = append(hdrs, "Content-Type: application/json") }
    st, resp, err = http_request(method, server + path, hdrs, reqbody)
    if st == 401 && c.refresh_token != "" {
        ntok, ok, _ := auth_refresh_stored(server)
        if ok {
            hdrs = []string{"Authorization: Bearer " + ntok}
            if reqbody != "" { hdrs = append(hdrs, "Content-Type: application/json") }
            st, resp, err = http_request(method, server + path, hdrs, reqbody)
        }
    }
    return
}

// auth_need_login gates the org commands: the config must name a server
// and hold a token, or there is nothing to authenticate with.
func auth_need_login() (msg) {
    msg = ""
    c := load_config()
    if c.server == "" {
        msg = "not configured — run: auth login --server URL --email E --password P"
        return
    }
    if c.token == "" {
        msg = "not logged in — run: auth login"
        return
    }
    return
}

// membership rows off /v1/auth/me (.memberships[]) and off an org's
// members response (.members[]) share the same fields.
func parse_member_rows(body, key) (ms) {
    ms = []OrgMembership{}
    j := 0
    while true {
        base := "." + key + "[" + str(j) + "]"
        slug_r, e := json_get(body, base + ".org_slug")
        if e != "" { break }
        role_r, _ := json_get(body, base + ".role")
        em_r, _ := json_get(body, base + ".user_email")
        ms = append(ms, OrgMembership{org_slug: parse(slug_r, ""), role: parse(role_r, ""), user_email: parse(em_r, "")})
        j = j + 1
    }
    return
}

// GET /v1/auth/me → the signed-in account's memberships. msg "" on
// success; the caller prints msg and returns 1 otherwise.
func auth_my_memberships() (ms, msg) {
    ms = []OrgMembership{}
    msg = ""
    st, body, err := auth_api("GET", "/v1/auth/me", "")
    if err != "" { msg = "memberships failed: " + err  return }
    if st != 200 { msg = "memberships failed: " + auth_errnote(st, body)  return }
    ms = parse_member_rows(body, "memberships")
    return
}

func cmd_auth_memberships(a) (code) {
    code = 0
    if has_help(a, 3) { println(cmd_usage("auth memberships"))  return code }
    if len(a) > 3 {
        usage_fail("unexpected argument '" + a[3] + "'", cmd_usage("auth memberships"))
        return 2
    }
    msg := auth_need_login()
    if msg != "" {
        eprintln("machin-365: " + msg)
        return 1
    }
    ms, emsg := auth_my_memberships()
    if emsg != "" {
        eprintln("machin-365: " + emsg)
        return 1
    }
    if len(ms) == 0 {
        println("no org memberships — org-scoped collections will refuse this token")
        return code
    }
    i := 0
    while i < len(ms) {
        println(ms[i].org_slug + "  " + ms[i].role)
        i = i + 1
    }
    return code
}

func cmd_auth_orgs(a) (code) {
    code = 0
