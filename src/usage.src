// usage.src — help text. stdout for the command list, stderr-free so the
// whole block is safe to pipe; exit code 2 on no/unknown command.

func print_usage() {
    println("machin-365 — the Machin app suite")
    println("")
    println("usage: machin-365 <command> [args]")
    println("")
    println("commands:")
    println("  init                          create suite dirs + default config")
    println("  catalog [--refresh]           list apps; --refresh pulls ${server}/catalog.json")
    println("  install <id> [--bin PATH]     install an app (release asset or local binary)")
    println("  uninstall <id>                 remove an installed app (keeps data/<id>/)")
    println("  prune                         drop .desktop entries whose home/binary is gone")
    println("  run <id> [args...]            run an installed app")
    println("  auth login --server URL --email E [--password P | --password-stdin] [--org SLUG]")
    println("  auth signup --server URL --email E [--password P | --password-stdin] [--name N] [--org SLUG]")
    println("  auth member add <org> <user> [--role owner|admin|member]   add a member to an org")
    println("  auth member list <org>          list an org's members")
    println("  auth member remove <org> <user> remove a member from an org")
    println("  auth memberships               org memberships of the signed-in account")
    println("  auth orgs                      org slugs the account belongs to")
    println("  auth org create <slug> [--name N]   create an org (creator becomes owner)")
    println("  auth switch-org <slug>         re-scope the session to another org")
    println("  auth adopt-local               merge parked pre-sign-in local data into the active store")
    println("  auth status                   show server/account/token state")
    println("  auth logout                   clear stored tokens")
    println("  config                        show suite paths and account state")
    println("  config set sync_collections a/b,c/d   set the sticky sync collection list")
    println("  service install [--bin PATH] [--latest]")
    println("                               install/upgrade bkn — --latest = newest release")
    println("  service start|stop|status     manage the local bkn instance")
    println("  service reset [--yes]         wipe ALL local bkn data (TTY prompts; --yes skips)")
    println("  sync [--collections a/b,c/d] [--watch [secs]]")
    println("                               replicate local bkn <-> remote bkn")
    println("  version                       print the suite version (also: --version, -V)")
    println("  update                        install the latest GitHub release over this binary")
    println("  telemetry [--on|--off]        anonymous usage-count status; --off opts out, --on re-enables")
    println("")
    println("env:")
    println("  MACHIN_365_HOME    suite home (default ~/.local/share/machin-365)")
    println("  MACHIN_365_CATALOG override catalog.json path")
    println("  MACHIN_365_BKN_PORT  local bkn port (default 17630)")
    println("  MACHIN_365_TOMBSTONE_TTL_DAYS  tombstone retention window (default 90)")
    println("  MACHIN_365_TELEMETRY=0        disable anonymous usage counts")
    println("")
    println("apps are offline-first: the local bkn (service *) is the")
    println("default data layer; `sync` replicates it to the remote")
    println("server configured via `auth login`. Local data created before")
    println("the first sign-in is adopted into that account's store.")
}

// cmd_usage returns the usage line for a command path ("sync",
// "auth login", "service reset", ...); "" for unknown paths. It is the
// single source for error diagnostics AND the --help/-h / `help <cmd>`
// success paths, so the two can never drift apart.
func cmd_usage(path) (s) {
    s = ""
    if path == "init" { s = "usage: machin-365 init"  return }
    if path == "catalog" || path == "apps" { s = "usage: machin-365 catalog [--refresh]"  return }
    if path == "install" { s = "usage: machin-365 install <app-id> [--bin /path/to/binary]"  return }
    if path == "uninstall" { s = "usage: machin-365 uninstall <app-id>"  return }
    if path == "prune" { s = "usage: machin-365 prune"  return }
    if path == "run" { s = "usage: machin-365 run <app-id> [args...]"  return }
    if path == "sync" { s = "usage: machin-365 sync [--collections a/b,c/d] [--watch [secs]]"  return }
    if path == "version" { s = "usage: machin-365 version"  return }
    if path == "update" { s = "usage: machin-365 update"  return }
    if path == "telemetry" { s = "usage: machin-365 telemetry [--on|--off]"  return }
    if path == "config" { s = "usage: machin-365 config [set sync_collections a/b,c/d]"  return }
    if path == "config set" { s = "usage: machin-365 config set sync_collections a/b,c/d"  return }
    if path == "auth" { s = "usage: machin-365 auth <login|signup|member|memberships|orgs|org|switch-org|adopt-local|status|logout>"  return }
    if path == "auth login" { s = "usage: machin-365 auth login --server URL --email E [--password P | --password-stdin] [--org SLUG]"  return }
    if path == "auth signup" { s = "usage: machin-365 auth signup --server URL --email E [--password P | --password-stdin] [--name N] [--org SLUG]"  return }
    if path == "auth member" { s = "usage: machin-365 auth member <add|list|remove> ..."  return }
    if path == "auth member add" { s = "usage: machin-365 auth member add <org> <user> [--role owner|admin|member]"  return }
    if path == "auth member list" { s = "usage: machin-365 auth member list <org>"  return }
    if path == "auth member remove" { s = "usage: machin-365 auth member remove <org> <user>"  return }
    if path == "auth memberships" { s = "usage: machin-365 auth memberships"  return }
    if path == "auth orgs" { s = "usage: machin-365 auth orgs"  return }
    if path == "auth org" { s = "usage: machin-365 auth org <create> ..."  return }
    if path == "auth org create" { s = "usage: machin-365 auth org create <slug> [--name N]"  return }
    if path == "auth switch-org" { s = "usage: machin-365 auth switch-org <slug>"  return }
    if path == "auth adopt-local" { s = "usage: machin-365 auth adopt-local"  return }
    if path == "auth status" { s = "usage: machin-365 auth status"  return }
    if path == "auth logout" { s = "usage: machin-365 auth logout"  return }
    if path == "service" { s = "usage: machin-365 service <install|start|stop|status|reset>"  return }
    if path == "service install" { s = "usage: machin-365 service install [--bin /path/to/bkn] [--latest]"  return }
    if path == "service start" { s = "usage: machin-365 service start"  return }
    if path == "service stop" { s = "usage: machin-365 service stop"  return }
    if path == "service status" { s = "usage: machin-365 service status"  return }
    if path == "service reset" { s = "usage: machin-365 service reset [--yes]"  return }
    return
}
