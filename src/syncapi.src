// syncapi.src — sync endpoint resolution and store API call helpers,
// split from sync.src to keep files under 500 LOC.

// "HTTP 403 <server message>" style detail; transport errors pass through.
func http_errnote(st, err, resp) {
    if err != "" { return err }
    m, e := json_get(resp, ".error.message")
    if e == "" {
        mm := parse(m, "")
        if mm != "" { return "HTTP " + str(st) + " " + mm }
    }
    return "HTTP " + str(st)
}

func sync_note_err(side, what, st, err, resp) {
    sync_err_count = sync_err_count + 1
    if side == "remote" && auth_class_err(st, resp) { sync_remote_auth_err = true }
    msg := side + " " + what + " failed: " + http_errnote(st, err, resp)
    i := 0
    while i < len(sync_err_msgs) {
        if sync_err_msgs[i] == msg { return }
        i = i + 1
    }
    if len(sync_err_msgs) < 12 { sync_err_msgs = append(sync_err_msgs, msg) }
}

func sync_setup() {
    c := load_config()
    sync_remote = env("MACHIN_365_REMOTE")
    if sync_remote == "" { sync_remote = c.server }
    sync_remote_tok = env("MACHIN_365_REMOTE_TOKEN")
    if sync_remote_tok == "" { sync_remote_tok = c.token }
    sync_local = env("MACHIN_365_LOCAL")
    if sync_local == "" { sync_local = local_url() }
    sync_local_tok = env("MACHIN_365_LOCAL_TOKEN")
    if sync_local_tok == "" { sync_local_tok = c.local_token }
}

// Fingerprint of the config fields that decide WHICH tenant a sync pass
// reconciles (#148). server+email+org are exactly the local store's
// partition key (store.src account_store_key — org included, so
// switch-org gets its own namespace), and the remote side is scoped by
// the org claim of the stored token. `sync --watch` resolves its
// endpoints once at startup; when auth login/switch-org/logout rewrites
// any of these, the running watch would keep pushing the OLD remote
// token against the NEW local namespace — cross-org writes and remote
// deletes. Comparing this fingerprint each pass catches that.
//
// Token VALUES are deliberately excluded: sync's own refresh rotates
// them mid-pass and a same-identity re-login must not stop the watch.
// Only losing the session entirely (auth logout) counts, via the
// presence flag — which honours MACHIN_365_REMOTE_TOKEN the same way
// sync_setup does, so an env-managed token is not "logged out" by a
// config-side token clear. Email is lowercased to match the store key.
func sync_identity_fp() (fp) {
    c := load_config()
    sess := "0"
    if c.token != "" || env("MACHIN_365_REMOTE_TOKEN") != "" { sess = "1" }
    fp = c.server + "\n" + to_lower(c.email) + "\n" + c.org + "\n" + sess
    return fp
}

func api_get(base, tok, path) {
    st, body, err := http_request("GET", base + path,
        []string{"Authorization: Bearer " + tok}, "")
    return st, body, err
}

func api_post(base, tok, path, body) {
    st, resp, err := http_request("POST", base + path,
        []string{"Authorization: Bearer " + tok, "Content-Type: application/json"}, body)
    return st, resp, err
}

// --- record deletes -------------------------------------------------------
//
// Record ids are arbitrary strings — '/' included (javimosch/machin-365#140)
// — and the two bkn implementations carry them on DELETE differently:
//
//   query — DELETE /v1/store/<ref>?id=<enc>: the machin-bkn collection
//           route. Its record route reads only segs[4], so a '/'-bearing
//           id in the path truncates to the prefix and deletes the WRONG
//           record; its query values ARE percent-decoded, so ?id= carries
//           the full id.
//   path  — DELETE /v1/store/<ref>/<enc>: the Go bkn's {id} wildcard
//           matches one ESCAPED segment and unescapes it (%2F -> '/'),
//           but it registers no collection-level DELETE, so ?id= is a
//           405 there.
//
// The form is probed once per base with a bare DELETE on the tombstone
// collection: machin-bkn answers 400 ("DELETE needs ?id="), Go bkn 405 —
// a request that cannot delete anything on either. The answer is cached
// per base because local and remote may be different implementations.
var sync_del_mode = make(map[string]string)

func api_del_mode(base, tok) (mode) {
    mode = sync_del_mode[base]
    if mode != "" { return mode }
    st, _, err := http_request("DELETE",
        base + "/v1/store/" + sync_tomb_coll,
        []string{"Authorization: Bearer " + tok}, "")
    mode = "query"
    if err == "" {
        if st == 405 { mode = "path" }
        sync_del_mode[base] = mode
    }
    return mode
}

// RFC-3986 unreserved bytes pass through; everything else becomes %XX.
// '.' is excluded on purpose: a literal "." or ".." segment would be
// path-cleaned by the Go mux before {id} ever sees it, so it must arrive
// escaped. keep_high leaves bytes >= 0x80 raw — required for the query
// form, whose decoder (machin-bkn urlDecode) only resolves escapes into
// printable ASCII and would mangle a %XX-encoded UTF-8 id; the path form
// encodes them so the request line stays pure ASCII for any proxy.
func pct_ok(c) {
    if c >= 48 && c <= 57 { return true }
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    if c == 45 || c == 95 || c == 126 { return true }
    return false
}

func pct_hex(c) (h) {
    d := "0123456789ABCDEF"
    h = substr(d, c / 16, c / 16 + 1) + substr(d, c % 16, c % 16 + 1)
}

func pctenc(s, keep_high) (out) {
    b := bytes(s)
    out = ""
    i := 0
    while i < len(b) {
        c := byte_at(b, i)
        if pct_ok(c) || (keep_high && c > 126) {
            out = out + substr(s, i, i + 1)
        } else {
            out = out + "%" + pct_hex(c)
        }
        i = i + 1
    }
    return out
}

func api_delete(base, tok, ref, id, side) {
    path := "/v1/store/" + ref
    if api_del_mode(base, tok) == "path" {
        path = path + "/" + pctenc(id, false)
    } else {
        path = path + "?id=" + pctenc(id, true)
    }
    st, resp, err := http_request("DELETE", base + path,
        []string{"Authorization: Bearer " + tok}, "")
    ok := (st == 200 || st == 204) && err == ""
    if !ok { sync_note_err(side, "DELETE " + path, st, err, resp) }
    return ok
}

// One transport-level probe of the local endpoint per pass. A connect
// failure means nothing is listening — say so once instead of reporting a
// wall of per-call "connect" errors. Any HTTP status counts as alive:
// auth and store errors are still reported per call, where they belong.
func local_alive() {
    _, _, err := api_get(sync_local, sync_local_tok,
        "/v1/store/" + sync_tomb_coll + "?limit=1")
    return err == ""
}
