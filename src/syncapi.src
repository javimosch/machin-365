// syncapi.src — sync endpoint resolution and store API call helpers,
// split from sync.src to keep files under 500 LOC.

// fetch every record of a collection as raw JSON objects, paginated.
// sync_fetch_ok ends true only when every page of EVERY range arrived —
// callers that persist or diff the result (the sync manifest) must check
// it. sync_fetch_absent ends true only when the fetch stopped on the quiet
// private-admin refusal: the collection is confirmed absent for this
// token, so records missing from the view really are absent *for us*
// and writes would be refused the same way — the merge may still run.
// Every other early exit (transport error, non-private status, partial
// page) leaves the contents unknown: absence in the partial view means
// nothing and the merge must not run on it (#152).
// sync/tombstones is fetched with server-side _mtime windows so markers
// past the retention window never leave the store in the live range
// (tombs.src): live ms markers via ?_mtime=gt:<tomb_cutoff()>, plus a
// second range ?_mtime=lt:<tomb_gc_cutoff()> for everything older than
// the GC window — ms markers collected by tombgc.src once their target
// is confirmed gone, AND markers written in epoch SECONDS (they sit far
// below every ms cutoff and would otherwise be invisible to both sides,
// #126). The two ranges are disjoint — tomb_gc_cutoff() is clamped to
// never exceed tomb_cutoff() — so no doc can arrive twice;
// load_tombs/canon_tombs still apply their cutoffs client-side after
// rec_mtime's seconds→ms scaling, so the wide low range only costs
// transfer of dormant non-ms markers and GC candidates awaiting
// collection.
func fetch_records(base, tok, ref, side) (recs) {
    recs = []string{}
    sync_fetch_ok = true
    sync_fetch_absent = false
    if ref == sync_tomb_coll {
        recs = fetch_range(base, tok, ref, side,
            "&_mtime=gt:" + str(tomb_cutoff()))
        // A confirmed-absent first range means the collection itself is
        // refused for this token — the low range would fail the same
        // way, so don't spend the call.
        if sync_fetch_absent { return recs }
        // Anything short of a proven-empty answer leaves the low range's
        // quiet refusal meaningful: absent is only confirmed when NO
        // range produced records or completed — a lone low-range refusal
        // after range 1 answered is contradictory, i.e. unknown state
        // (#152), not confirmation.
        proven1 := sync_fetch_ok || len(recs) > 0
        low := fetch_range(base, tok, ref, side,
            "&_mtime=lt:" + str(tomb_gc_cutoff()))
        if proven1 { sync_fetch_absent = false }
        i := 0
        while i < len(low) {
            recs = append(recs, low[i])
            i = i + 1
        }
        return recs
    }
    return fetch_range(base, tok, ref, side, "")
}

// One paginated range of fetch_records; filt is an extra server-side
// query clause ("" or "&_mtime=..."). Failures clear sync_fetch_ok but
// never set it — fetch_records owns the flag across its ranges.
func fetch_range(base, tok, ref, side, filt) (recs) {
    recs = []string{}
    off := 0
    while true {
        q := "?limit=500&offset=" + str(off) + filt
        st, body, err := api_get(base, tok, "/v1/store/" + ref + q)
        if err != "" || st != 200 {
            quiet := false
            if side == "remote" && is_private_admin_err(st, body) {
                // Read-path self-declaration is gated on local writes being
                // pending for this ref (sync_prov_gate, set by sync_one_ref):
                // declaring an empty<->empty ref leaves a phantom collection
                // on the server (#101). Gate 2 retries after the PUT; gate 1
                // never declares — a discovered ref gets the deny
                // skip-message (#107) while an explicitly named data ref
                // falls through to sync_note_err and fails the pass (#168);
                // gate 0 means the local fetch already failed, so stay
                // quiet here.
                if sync_prov_gate == 2 {
                    if remote_provision(ref) { continue }
                } else {
                    if sync_prov_gate == 1 && sync_discovered {
                        // gate 1 + discovered: the remote administers this
                        // ref privately — skip-message, not a typo hint (#107)
                        sync_deny_ref(ref)
                        quiet = true
                    } else if sync_prov_gate == 0 || ref == sync_tomb_coll {
                        // gate 0: the local fetch already reported its own
                        // failure. sync/tombstones: undeclared is the normal
                        // fresh-install state — infrastructure, not a ref
                        // the user named — so it stays quiet.
                        quiet = true
                    }
                    // Remaining case — gate 1 + an explicitly named data
                    // ref: bkn answers the same 403 for undeclared and
                    // admin-only collections, so "absent — check for typos"
                    // was a guess that hid real access-policy denials behind
                    // a clean exit 0 (#168). Explicit refs stay strict like
                    // gate 2 and the write path (#107): quiet stays false so
                    // the refusal reports as an ordinary remote failure.
                }
            }
            if !quiet {
                // A discovered ref the remote administers privately is
                // skipped, not failed — see sync_deny_ref (#107).
                if side == "remote" && sync_discovered &&
                    is_private_admin_err(st, body) {
                    sync_deny_ref(ref)
                } else {
                    sync_note_err(side, "GET /v1/store/" + ref, st, err, body)
                }
            }
            sync_fetch_ok = false
            // quiet == the private-admin refusal was accepted as
            // confirmed-absent (undeclared/invisible collection); every
            // other early exit leaves the remote state unknown (#152)
            sync_fetch_absent = quiet
            break
        }
        i := 0
        n := 0
        while true {
            r, e := json_get(body, ".records[" + str(i) + "]")
            if e != "" { break }
            recs = append(recs, r)
            note_mtime_suspect(r)
            i = i + 1
            n = n + 1
        }
        if n < 500 { break }
        off = off + 500
    }
    return recs
}

func rec_id(rec) {
    v, e := json_get(rec, ".id")
    if e != "" { return "" }
    return parse(v, "")
}

// string field of a raw record JSON; "" when absent.
func jstr(rec, path) {
    v, e := json_get(rec, path)
    if e != "" { return "" }
    return parse(v, "")
}

// find a raw record by id in a fetched list; "" when absent.
func find_rec(recs, id) {
    i := 0
    while i < len(recs) {
        if rec_id(recs[i]) == id { return recs[i] }
        i = i + 1
    }
    return ""
}

func post_doc(base, tok, ref, doc, side) {
    if side == "remote" && sync_ref_denied(ref) { return false }
    st, resp, err := api_post(base, tok, "/v1/store/" + ref, doc)
    ok := (st == 200 || st == 201) && err == ""
    if !ok && side == "remote" && is_private_admin_err(st, resp) && remote_provision(ref) {
        st, resp, err = api_post(base, tok, "/v1/store/" + ref, doc)
        ok = (st == 200 || st == 201) && err == ""
    }
    if !ok {
        // A discovered ref the remote administers privately is skipped,
        // not failed — see sync_deny_ref (#107).
        if side == "remote" && sync_discovered && is_private_admin_err(st, resp) {
            sync_deny_ref(ref)
        } else {
            sync_note_err(side, "POST /v1/store/" + ref, st, err, resp)
        }
    }
    return ok
}

func push_doc(base, tok, ref, rec, side) {
    return post_doc(base, tok, ref, stamp(rec, ref), side)
}

// "HTTP 403 <server message>" style detail; transport errors pass through.
func http_errnote(st, err, resp) {
    if err != "" { return err }
    m, e := json_get(resp, ".error.message")
    if e == "" {
        mm := parse(m, "")
        if mm != "" { return "HTTP " + str(st) + " " + mm }
    }
    return "HTTP " + str(st)
}

func sync_note_err(side, what, st, err, resp) {
    sync_err_count = sync_err_count + 1
    if side == "remote" && auth_class_err(st, resp) { sync_remote_auth_err = true }
    msg := side + " " + what + " failed: " + http_errnote(st, err, resp)
    i := 0
    while i < len(sync_err_msgs) {
        if sync_err_msgs[i] == msg { return }
        i = i + 1
    }
    if len(sync_err_msgs) < 12 { sync_err_msgs = append(sync_err_msgs, msg) }
}

func sync_setup() {
    c := load_config()
    sync_remote = env("MACHIN_365_REMOTE")
    if sync_remote == "" { sync_remote = c.server }
    sync_remote_tok = env("MACHIN_365_REMOTE_TOKEN")
    if sync_remote_tok == "" { sync_remote_tok = c.token }
    sync_local = env("MACHIN_365_LOCAL")
    if sync_local == "" { sync_local = local_url() }
    sync_local_tok = env("MACHIN_365_LOCAL_TOKEN")
    if sync_local_tok == "" { sync_local_tok = c.local_token }
}

// Fingerprint of the config fields that decide WHICH tenant a sync pass
// reconciles (#148). server+email+org are exactly the local store's
// partition key (store.src account_store_key — org included, so
// switch-org gets its own namespace), and the remote side is scoped by
// the org claim of the stored token. `sync --watch` resolves its
// endpoints once at startup; when auth login/switch-org/logout rewrites
// any of these, the running watch would keep pushing the OLD remote
// token against the NEW local namespace — cross-org writes and remote
// deletes. Comparing this fingerprint each pass catches that.
//
// Token VALUES are deliberately excluded: sync's own refresh rotates
// them mid-pass and a same-identity re-login must not stop the watch.
// Only losing the session entirely (auth logout) counts, via the
// presence flag — which honours MACHIN_365_REMOTE_TOKEN the same way
// sync_setup does, so an env-managed token is not "logged out" by a
// config-side token clear. Email is lowercased to match the store key.
func sync_identity_fp() (fp) {
    c := load_config()
    sess := "0"
    if c.token != "" || env("MACHIN_365_REMOTE_TOKEN") != "" { sess = "1" }
    fp = c.server + "\n" + to_lower(c.email) + "\n" + c.org + "\n" + sess
    return fp
}

// The partition key bkn_store_switch assigns the CURRENT config identity
// — "_unclaimed" without an email, the account hash otherwise. "" when
// sync reads a store this home's marker cannot describe: a
// MACHIN_365_LOCAL override points at a different bkn entirely.
func sync_expected_store_key() {
    if env("MACHIN_365_LOCAL") != "" { return "" }
    c := load_config()
    if c.email == "" { return "_unclaimed" }
    return account_store_key(c.server, c.email, c.org)
}

// The local store's active partition marker (bkn/.active-key), or "" when
// absent or corrupt — pre-partitioning homes carry no marker and are
// covered by the config fingerprint alone.
func sync_active_store_key() {
    k := trim(read_file(suite_home() + "/bkn/.active-key"))
    if !valid_store_key(k) { return "" }
    return k
}

func api_get(base, tok, path) {
    st, body, err := http_request("GET", base + path,
        []string{"Authorization: Bearer " + tok}, "")
    return st, body, err
}

func api_post(base, tok, path, body) {
    st, resp, err := http_request("POST", base + path,
        []string{"Authorization: Bearer " + tok, "Content-Type: application/json"}, body)
    return st, resp, err
}

// --- record deletes -------------------------------------------------------
//
// Record ids are arbitrary strings — '/' included (javimosch/machin-365#140)
// — and the two bkn implementations carry them on DELETE differently:
//
//   query — DELETE /v1/store/<ref>?id=<enc>: the machin-bkn collection
//           route. Its record route reads only segs[4], so a '/'-bearing
//           id in the path truncates to the prefix and deletes the WRONG
//           record; its query values ARE percent-decoded, so ?id= carries
//           the full id.
//   path  — DELETE /v1/store/<ref>/<enc>: the Go bkn's {id} wildcard
//           matches one ESCAPED segment and unescapes it (%2F -> '/'),
//           but it registers no collection-level DELETE, so ?id= is a
//           405 there.
//
// The form is probed once per base with a bare DELETE on the tombstone
// collection: machin-bkn answers 400 ("DELETE needs ?id="), Go bkn 405 —
// a request that cannot delete anything on either. The answer is cached
// per base because local and remote may be different implementations.
var sync_del_mode = make(map[string]string)

func api_del_mode(base, tok) (mode) {
    mode = sync_del_mode[base]
    if mode != "" { return mode }
    st, _, err := http_request("DELETE",
        base + "/v1/store/" + sync_tomb_coll,
        []string{"Authorization: Bearer " + tok}, "")
    mode = "query"
    if err == "" {
        if st == 405 { mode = "path" }
        sync_del_mode[base] = mode
    }
    return mode
}

// RFC-3986 unreserved bytes pass through; everything else becomes %XX.
// '.' is excluded on purpose: a literal "." or ".." segment would be
// path-cleaned by the Go mux before {id} ever sees it, so it must arrive
// escaped. keep_high leaves bytes >= 0x80 raw — required for the query
// form, whose decoder (machin-bkn urlDecode) only resolves escapes into
// printable ASCII and would mangle a %XX-encoded UTF-8 id; the path form
// encodes them so the request line stays pure ASCII for any proxy.
func pct_ok(c) {
    if c >= 48 && c <= 57 { return true }
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    if c == 45 || c == 95 || c == 126 { return true }
    return false
}

func pct_hex(c) (h) {
    d := "0123456789ABCDEF"
    h = substr(d, c / 16, c / 16 + 1) + substr(d, c % 16, c % 16 + 1)
}

func pctenc(s, keep_high) (out) {
    b := bytes(s)
    out = ""
    i := 0
    while i < len(b) {
        c := byte_at(b, i)
        if pct_ok(c) || (keep_high && c > 126) {
            out = out + substr(s, i, i + 1)
        } else {
            out = out + "%" + pct_hex(c)
        }
        i = i + 1
    }
    return out
}

func api_delete(base, tok, ref, id, side) {
    if side == "remote" && sync_ref_denied(ref) { return false }
    path := "/v1/store/" + ref
    if api_del_mode(base, tok) == "path" {
        path = path + "/" + pctenc(id, false)
    } else {
        path = path + "?id=" + pctenc(id, true)
    }
    st, resp, err := http_request("DELETE", base + path,
        []string{"Authorization: Bearer " + tok}, "")
    ok := (st == 200 || st == 204) && err == ""
    if !ok {
        // A discovered ref the remote administers privately is skipped,
        // not failed — see sync_deny_ref (#107).
        if side == "remote" && sync_discovered && is_private_admin_err(st, resp) {
            sync_deny_ref(ref)
        } else {
            sync_note_err(side, "DELETE " + path, st, err, resp)
        }
    }
    return ok
}

// One transport-level probe of the local endpoint per pass. A connect
// failure means nothing is listening — say so once instead of reporting a
// wall of per-call "connect" errors. Any HTTP status counts as alive:
// auth and store errors are still reported per call, where they belong.
func local_alive() {
    _, _, err := api_get(sync_local, sync_local_tok,
        "/v1/store/" + sync_tomb_coll + "?limit=1")
    return err == ""
}
