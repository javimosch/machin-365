// catalog.src — the app catalog: what the suite can install.
// Resolution order: MACHIN_365_CATALOG env file > the suite-home snapshot
// ($MACHIN_365_HOME/catalog.json, written by `catalog --refresh`) > the
// copy bundled at build time. A server-hosted catalog therefore overrides
// the bundled one once fetched; offline installs keep working on the
// snapshot or the bundle.

type Asset struct { platform string  url string  sha256 string }
type CatApp struct {
    id string
    name string
    kind string
    repo string
    version string
    bin string
    desc string
    assets []Asset
}
type Catalog struct {
    suite_version int
    server_default string
    apps []CatApp
}

func catalog_text() {
    p := env("MACHIN_365_CATALOG")
    if p != "" { return read_file(p) }
    snap := read_file(catalog_path())
    if snap != "" { return snap }
    return catalog_json()
}

func load_catalog() {
    p := env("MACHIN_365_CATALOG")
    cat := parse(catalog_text(), Catalog{})
    // An explicit override that reads empty or parses to zero apps is a
    // broken pointer, not an empty catalog — fail loudly like
    // `catalog --refresh` does for a bad server catalog. The implicit
    // snapshot/bundle path keeps the silent fall-through.
    if p != "" && len(cat.apps) == 0 {
        eprintln("machin-365: catalog override " + p + " unreadable/invalid — fix MACHIN_365_CATALOG or unset it")
        exit(1)
    }
    return cat
}

func find_app(cat, id) (a, found) {
    a = CatApp{id: "", name: "", kind: "", repo: "", version: "", bin: "", desc: "", assets: []Asset{}}
    found = false
    i := 0
    while i < len(cat.apps) {
        if cat.apps[i].id == id {
            a = cat.apps[i]
            found = true
            return
        }
        i = i + 1
    }
    return
}
