// config.src — suite config: which server, who is logged in.
// Stored as JSON at <suite_home>/config.json; tokens live here owner-only
// by directory permissions, never printed by `config` or `auth status`.

type SuiteConfig struct {
    server string
    token string
    refresh_token string
    email string
    org string
    local_port int
    local_token string
    sync_collections string
}

func load_config() (c) {
    c = SuiteConfig{server: "", token: "", refresh_token: "", email: "", org: "", local_port: 0, local_token: "", sync_collections: ""}
    s := read_file(config_path())
    if s == "" { return c }
    return parse(s, SuiteConfig{})
}

func save_config(c) {
    system("mkdir -p '" + suite_home() + "'")
    write_file(config_path(), json(c))
}
