// config.src — suite config: which server, who is logged in.
// Stored as JSON at <suite_home>/config.json. The suite home is kept at
// mode 700 and the file is written mode 600 via temp+rename, so tokens
// stay owner-only; never printed by `config` or `auth status`.

type SuiteConfig struct {
    server string
    token string
    refresh_token string
    email string
    org string
    local_port int
    local_token string
    sync_collections string
}

func load_config() (c) {
    c = SuiteConfig{server: "", token: "", refresh_token: "", email: "", org: "", local_port: 0, local_token: "", sync_collections: ""}
    s := read_file(config_path())
    if s == "" { return c }
    return parse(s, SuiteConfig{})
}

func save_config(c) {
    system("mkdir -p '" + suite_home() + "'")
    system("chmod 700 '" + suite_home() + "'")
    // temp+rename: the file is never world-readable, not even between
    // create and chmod (write_file alone would leave it at umask 0644)
    tmp := suite_home() + "/.config.json.tmp"
    write_file(tmp, json(c))
    system("chmod 600 '" + tmp + "'")
    system("mv -f '" + tmp + "' '" + config_path() + "'")
}
