// manifests.src — the last-seen id sets per synced collection.
//
// A DELETE on the store API removes the record and nothing else — no
// tombstone — so the next pass reads it as remote-only and pulls it back.
// sync-manifest.txt is the local baseline: ids that were present locally
// at the end of the last pass. An id that was synced but is absent now
// was deleted by *some* client; sync writes the tombstone marker itself
// so the delete propagates like an app delete would.
//
// sync-remote-manifest.txt is the mirror baseline: ids that were present
// on the remote at the end of the last pass. A raw store-API DELETE
// against the remote (admin cleanup, GDPR erasure, any non-suite client)
// leaves no marker either — without this baseline the local copy reads
// as "local-only" and is pushed straight back up, silently undoing the
// delete on every suite home. A remote-vanished baseline id that still
// has a local copy and the absence is unexplained gets the same marker
// written locally, so the pre-delete pass removes the local copy and the
// marker propagates the delete to the other devices. A live tombstone
// explains the absence only when the remote copy last seen was OLDER
// than the marker — that is the copy the marker's propagation removed.
// A baseline _mtime newer than the marker means the remote held a record
// the tombstone could not have deleted (an edit-after-delete pushed
// back), so the absence is unexplained and still needs a marker — see
// remote_missing_ids.
//
// File format (one section per synced collection):
//   machin-365 sync-manifest v1|v2
//   account <key>
//   ref "<json-escaped ref>"
//   "<json-escaped id>"             v1 line — local manifest
//   ["<json-escaped id>",<mtime>]   v2 line — remote manifest: the remote
//                                   record's _mtime when last seen
//   ...
// The in-memory map is ref -> blob, where a blob is the section's id
// lines verbatim, so load/save round-trip without re-encoding. v2 mtimes
// let remote_missing_ids tell a tombstone-covered absence (the remote
// copy last seen was OLDER than the marker — the copy its propagation
// removed) from an unexplained one (copy NEWER than the marker, which
// tomb_wins would not have deleted). v1 lines decode with mtime 0 =
// unknown, keeping the pre-v2 tombstone-covered excuse.
//
// Baselines are per identity: sync-manifest.<key>.txt and
// sync-remote-manifest.<key>.txt, one file per manifest key, so an
// account/org switch parks the previous identity's baseline instead of
// discarding it — switching back restores vanished-id detection and a
// remote delete that landed while another identity was active is still
// flagged instead of silently resurrecting (#118). The pre-per-key
// single-slot files (sync-manifest.txt / sync-remote-manifest.txt) are
// migrated on first read: their content is parked under the account key
// their own "account" line names, then the slot is removed.

// Identity the baseline is bound to: the account key plus the local
// endpoint. An account switch swaps the active bkn store
// (bkn_store_switch) and a different MACHIN_365_LOCAL is a different
// store — either way the old id set must not tombstone the new store's
// contents, so a mismatch discards the baseline rather than reusing it.
func manifest_key() {
    c := load_config()
    return account_store_key(c.server + "\n" + sync_local, c.email, c.org)
}

// Remote baseline identity: the account on the remote endpoint. Bound to
// sync_remote (the effective URL, env override included) rather than
// sync_local — a different remote or a different org is a different
// visibility scope, so its id set must not tombstone this one's records.
func remote_manifest_key() {
    c := load_config()
    return account_store_key(c.server + "\n" + sync_remote, c.email, c.org)
}

// v1 encode: blob lines are json()-quoted ids, one per line.
func man_encode(ids) (blob) {
    blob = ""
    i := 0
    while i < len(ids) {
        blob = blob + json(ids[i]) + "\n"
        i = i + 1
    }
    return blob
}

// v2 encode for the remote manifest: each line is ["<id>",<mtime>] —
// the remote record's _mtime when last seen (0 when unknown). The local
// baseline stays v1; only remote_missing_ids consumes the mtimes.
func man_encode_mt(ids, mts) (blob) {
    blob = ""
    i := 0
    while i < len(ids) {
        blob = blob + "[" + json(ids[i]) + "," + str(mts[ids[i]]) + "]\n"
        i = i + 1
    }
    return blob
}

func man_decode(blob) (ids) {
    ids = []string{}
    rest := blob
    while rest != "" {
        e := index(rest, "\n")
        line := rest
        if e >= 0 {
            line = substr(rest, 0, e)
            rest = substr(rest, e + 1, len(rest))
        } else {
            rest = ""
        }
        if line != "" {
            if has_prefix(line, "[") {
                // v2 line ["id",mtime] — the id is element 0
                v, ve := json_get(line, "[0]")
                if ve == "" { ids = append(ids, parse(v, "")) }
            } else {
                ids = append(ids, parse(line, ""))
            }
        }
    }
    return ids
}

// v2-aware decode returning the id list plus id -> last-seen mtime.
// v1 lines yield mtime 0 (unknown) — remote_missing_ids treats that as
// "cannot prove the remote copy post-dates the tombstone" and keeps the
// tombstone-covered excuse.
func man_decode_mt(blob) (ids, mts) {
    ids = []string{}
    mts = make(map[string]int)
    rest := blob
    while rest != "" {
        e := index(rest, "\n")
        line := rest
        if e >= 0 {
            line = substr(rest, 0, e)
            rest = substr(rest, e + 1, len(rest))
        } else {
            rest = ""
        }
        if line == "" { continue }
        if has_prefix(line, "[") {
            iv, ie := json_get(line, "[0]")
            mv, me := json_get(line, "[1]")
            if ie == "" && me == "" {
                id := parse(iv, "")
                ids = append(ids, id)
                // norm_mtime heals baselines written before _mtime's
                // unit was pinned — a seconds-scale mtime would
                // otherwise read as ancient next to a ms tombstone
                mts[id] = norm_mtime(parse_int(trim(mv)))
            }
        } else {
            id := parse(line, "")
            ids = append(ids, id)
            mts[id] = 0
        }
    }
    return
}

// Parse manifest text into ref -> blob plus the stored account key (""
// when there is no account line — the caller treats any key other than
// the current baseline key as no baseline).
func manifest_parse(s) (man, acct) {
    man = make(map[string]string)
    acct = ""
    cur := ""
    rest := s
    while rest != "" {
        e := index(rest, "\n")
        line := rest
        if e >= 0 {
            line = substr(rest, 0, e)
            rest = substr(rest, e + 1, len(rest))
        } else {
            rest = ""
        }
        if has_prefix(line, "account ") {
            acct = substr(line, 8, len(line))
        } else if has_prefix(line, "ref ") {
            cur = parse(substr(line, 4, len(line)), "")
        } else if (has_prefix(line, "\"") || has_prefix(line, "[")) && cur != "" {
            man[cur] = man[cur] + line + "\n"
        }
    }
    return
}

// Load a manifest file into ref -> blob plus the stored account key.
func manifest_read(path) (man, acct) {
    man, acct = manifest_parse(read_file(path))
    return
}

// Persist a post-pass baseline. Only refs still in the sync set are
// written — a collection removed from sync loses its baseline, so a later
// re-add starts fresh instead of tombstoning whatever vanished meanwhile.
// temp+rename keeps a torn write from becoming a truncated baseline.
func manifest_write(path, tmp, man, acct, refs, ver) {
    s := "machin-365 sync-manifest " + ver + "\naccount " + acct + "\n"
    i := 0
    while i < len(refs) {
        ref := refs[i]
        blob := man[ref]
        if blob != "" { s = s + "ref " + json(ref) + "\n" + blob }
        i = i + 1
    }
    if write_file(tmp, s) < 0 {
        eprintln("machin-365: could not write " + path)
        return
    }
    if system("mv -f '" + tmp + "' '" + path + "'") != 0 {
        remove(tmp)
        eprintln("machin-365: could not write " + path)
    }
}

func save_manifest(man, acct, refs) {
    manifest_write(manifest_stem() + acct + ".txt",
        suite_home() + "/.sync-manifest." + acct + ".tmp",
        man, acct, refs, "v1")
}

func save_remote_manifest(man, acct, refs) {
    manifest_write(remote_manifest_stem() + acct + ".txt",
        suite_home() + "/.sync-remote-manifest." + acct + ".tmp",
        man, acct, refs, "v2")
}

// Load the baseline for one identity. Baselines live in per-key files
// (<stem><key>.txt) so an account/org switch parks the previous
// identity's baseline instead of discarding it — switching back finds
// vanished-id detection intact, and a remote delete that landed while
// another identity was active is still flagged instead of being pushed
// back up (#118). A key with no file has no baseline yet (first sync
// for that identity) — trusted-empty by design.
//
// The pre-per-key single-slot file (legacy_path) is migrated on every
// read until it is gone: its content is parked under the account key
// its own "account" line names, then the slot is removed. The slot is
// only ever written by the old version, so when it names THIS identity
// it is newer than any per-key file (a downgrade rewrote it) and is
// adopted outright; for another identity it is parked only when no
// per-key file exists yet — an existing one is newer, written by this
// version. A baseline is trusted only when the file's account line
// matches the key it is stored under — a mismatch is corruption, not a
// baseline, and is ignored.
func manifest_load_for(ckey, stem, legacy_path, label) (man) {
    man = make(map[string]string)
    lraw := read_file(legacy_path)
    if lraw != "" {
        _, lacct := manifest_parse(lraw)
        if !valid_store_key(lacct) {
            // no trustworthy identity to park it under — the content
            // was never a usable baseline anyway; drop the slot
            remove(legacy_path)
        } else {
            lkpath := stem + lacct + ".txt"
            if lacct == ckey || file_size(lkpath) < 0 {
                if write_file(lkpath, lraw) < 0 {
                    perr("machin-365: could not migrate " + legacy_path)
                } else {
                    remove(legacy_path)
                }
            } else {
                // already parked under a newer per-key file
                remove(legacy_path)
            }
        }
    }
    kpath := stem + ckey + ".txt"
    m, acct := manifest_read(kpath)
    if acct == ckey { return m }
    if acct != "" {
        perr("machin-365: sync: " + label + " manifest account mismatch —" +
            " ignoring " + kpath)
    }
    return man
}

// Remove every manifest baseline: all per-identity files, the legacy
// single-slot files and stray tmp files. service reset calls this after
// wiping the stores — any surviving baseline would read the empty
// stores as mass deletes and tombstone the remote copies.
func remove_all_manifests() {
    prefixes := []string{"sync-manifest.", ".sync-manifest.",
        "sync-remote-manifest.", ".sync-remote-manifest."}
    pi := 0
    while pi < len(prefixes) {
        names := dir_names_prefixed(suite_home(), prefixes[pi])
        i := 0
        while i < len(names) {
            remove(suite_home() + "/" + names[i])
            i = i + 1
        }
        pi = pi + 1
    }
}

// Load this pass's local-side baseline for the current identity.
func manifest_begin() (man, ckey) {
    ckey = manifest_key()
    man = manifest_load_for(ckey, manifest_stem(), manifest_path(),
        "local store")
    return
}

// Load this pass's remote-side baseline for the current identity.
func remote_manifest_begin() (man, ckey) {
    ckey = remote_manifest_key()
    man = manifest_load_for(ckey, remote_manifest_stem(),
        remote_manifest_path(), "remote")
    return
}

// Fold one just-merged ref into the next baseline. A complete fetch on
// the side the baseline describes (ok + ids) makes the post-merge id set
// authoritative; an incomplete one keeps the previous baseline so the
// next pass can still tell a real delete from a bad page.
func manifest_note(ref, man, man_new, ok, ids) {
    if ref == sync_tomb_coll { return }
    if ok {
        man_new[ref] = man_encode(ids)
    } else if man[ref] != "" {
        man_new[ref] = man[ref]
    }
}

// Remote-side variant of manifest_note: the remote baseline is written
// in v2 form — each line carries the remote record's last-seen _mtime —
// so remote_missing_ids can compare a covering tombstone against the
// mtime of the copy it claims to have removed. mts is empty/ignored
// when the remote fetch was incomplete (ok false keeps the old blob,
// mtimes included).
func manifest_note_mt(ref, man, man_new, ok, ids, mts) {
    if ref == sync_tomb_coll { return }
    if ok {
        man_new[ref] = man_encode_mt(ids, mts)
    } else if man[ref] != "" {
        man_new[ref] = man[ref]
    }
}
