// tombs.src — delete-marker handling for sync. A deleter POSTs
// {"ref":"ns/coll","id":"ns/coll|<target>","_mtime":T} to sync/tombstones,
// then DELETEs the record. The tombstone's own doc id is the compound
// "ref|id" — a bare target id would let same-id deletes in different
// collections overwrite each other and resurrect. Legacy tombstones
// written with a bare ".id" are still honoured, and each sync pass
// rewrites them to the compound id.

// collection holding delete markers. New-style docs carry the compound
// "ref|id" as .id so same-id deletes in different collections cannot
// collide; legacy docs carry the bare target id and are still honoured.
var sync_tomb_coll = "sync/tombstones"

// tomb map: "ref|id" -> newest tombstone _mtime, from the (just-merged)
// local sync/tombstones collection.
func load_tombs() (tm) {
    tm = make(map[string]int)
    recs := fetch_records(sync_local, sync_local_tok, sync_tomb_coll, "local")
    i := 0
    while i < len(recs) {
        r := recs[i]
        ref := jstr(r, ".ref")
        id := jstr(r, ".id")
        mt := rec_mtime(r)
        if ref != "" && id != "" && mt > 0 {
            k := ref + "|" + id
            // new-style tombstones already use "ref|id" as the doc id —
            // that string IS the match key; legacy bare-id docs need the
            // ref prepended
            if has_prefix(id, ref + "|") { k = id }
            if mt > tm[k] { tm[k] = mt }
        }
        i = i + 1
    }
    return tm
}

// true when a tombstone newer than mt exists for ref/id — the record is dead.
func tomb_wins(tm, ref, id, mt) {
    return tm[ref + "|" + id] > mt
}

// Rewrite legacy bare-id tombstones to the compound "ref|id" doc id so
// same-id deletes in different collections can coexist. Runs on both
// sides before the tombstone merge each pass; already-compound docs and
// invalid markers are left alone. When a compound doc for the same target
// already exists with a newer-or-equal _mtime the legacy doc is redundant
// and is just dropped — rewriting it would needlessly downgrade the mt.
func canon_tombs(base, tok, side) {
    recs := fetch_records(base, tok, sync_tomb_coll, side)
    i := 0
    while i < len(recs) {
        r := recs[i]
        ref := jstr(r, ".ref")
        id := jstr(r, ".id")
        mt := rec_mtime(r)
        if ref != "" && id != "" && mt > 0 && !has_prefix(id, ref + "|") {
            nid := ref + "|" + id
            dup := find_rec(recs, nid)
            dmt := 0
            if dup != "" { dmt = rec_mtime(dup) }
            if dmt >= mt {
                api_delete(base, tok, "/v1/store/" + sync_tomb_coll + "/" + id, side)
            } else if push_doc(base, tok, sync_tomb_coll,
                "{\"ref\":" + json(ref) + ",\"id\":" + json(nid) +
                ",\"_mtime\":" + str(mt) + "}", side) {
                api_delete(base, tok, "/v1/store/" + sync_tomb_coll + "/" + id, side)
            }
        }
        i = i + 1
    }
}

// ---- sync manifests: the last-seen id sets per synced collection ----
//
// A DELETE on the store API removes the record and nothing else — no
// tombstone — so the next pass reads it as remote-only and pulls it back.
// Two manifests are sync's own baselines: manifest_path() tracks ids
// present locally, remote_manifest_path() ids present on the remote, each
// bound to its own store identity. An id that was synced but is absent
// from its side's fetch was deleted by *some* client; sync writes the
// tombstone marker itself so the delete propagates like an app delete
// would — in either direction.
//
// File format (one section per synced collection):
//   machin-365 sync-manifest v1
//   account <key>
//   ref "<json-escaped ref>"
//   "<json-escaped id>"
//   ...
// The in-memory map is ref -> blob, where a blob is the section's id
// lines verbatim (each a json-quoted id + "\n"), so load/save round-trip
// without re-encoding.

// Identity the local baseline is bound to: the account key plus the local
// endpoint. An account switch swaps the active bkn store
// (bkn_store_switch) and a different MACHIN_365_LOCAL is a different
// store — either way the old id set must not tombstone the new store's
// contents, so a mismatch discards the baseline rather than reusing it.
func manifest_key() {
    c := load_config()
    return account_store_key(c.server + "\n" + sync_local, c.email, c.org)
}

// Identity the remote baseline is bound to: the remote endpoint plus the
// signed-in account/org — org scoping decides which records the remote
// returns, so a different login or org must not inherit the old id set.
// The token itself is not part of the key: access tokens rotate on
// refresh while the visible store stays the same.
func remote_manifest_key() {
    c := load_config()
    return account_store_key(sync_remote, c.email, c.org)
}

// blob <-> id list. blob lines are json()-quoted ids, one per line.
// Duplicates collapse: the remote baseline can see the same id from both
// the remote-survivor and pushed-record passes of a merge.
func man_encode(ids) (blob) {
    blob = ""
    seen := make(map[string]int)
    i := 0
    while i < len(ids) {
        if seen[ids[i]] == 0 {
            seen[ids[i]] = 1
            blob = blob + json(ids[i]) + "\n"
        }
        i = i + 1
    }
    return blob
}

func man_decode(blob) (ids) {
    ids = []string{}
    rest := blob
    while rest != "" {
        e := index(rest, "\n")
        line := rest
        if e >= 0 {
            line = substr(rest, 0, e)
            rest = substr(rest, e + 1, len(rest))
        } else {
            rest = ""
        }
        if line != "" { ids = append(ids, parse(line, "")) }
    }
    return ids
}

// Load a manifest file into ref -> blob plus the stored account key (""
// when the file is absent or has no account line — the caller treats any
// key other than the current manifest key as no baseline).
func load_manifest(path) (man, acct) {
    man = make(map[string]string)
    acct = ""
    s := read_file(path)
    if s == "" { return }
    cur := ""
    rest := s
    while rest != "" {
        e := index(rest, "\n")
        line := rest
        if e >= 0 {
            line = substr(rest, 0, e)
            rest = substr(rest, e + 1, len(rest))
        } else {
            rest = ""
        }
        if has_prefix(line, "account ") {
            acct = substr(line, 8, len(line))
        } else if has_prefix(line, "ref ") {
            cur = parse(substr(line, 4, len(line)), "")
        } else if has_prefix(line, "\"") && cur != "" {
            man[cur] = man[cur] + line + "\n"
        }
    }
    return
}

// Persist the post-pass baseline. Only refs still in the sync set are
// written — a collection removed from sync loses its baseline, so a later
// re-add starts fresh instead of tombstoning whatever vanished meanwhile.
// temp+rename keeps a torn write from becoming a truncated baseline.
func save_manifest(path, man, acct, refs) {
    s := "machin-365 sync-manifest v1\naccount " + acct + "\n"
    i := 0
    while i < len(refs) {
        ref := refs[i]
        blob := man[ref]
        if blob != "" { s = s + "ref " + json(ref) + "\n" + blob }
        i = i + 1
    }
    tmp := path + ".tmp"
    if write_file(tmp, s) < 0 {
        eprintln("machin-365: could not write " + path)
        return
    }
    if system("mv -f '" + tmp + "' '" + path + "'") != 0 {
        remove(tmp)
        eprintln("machin-365: could not write " + path)
    }
}

// Ids that were in ref's last-seen local set but are absent from the
// current local fetch (lr) AND would survive the current tombstones on
// the remote copy (rr): a tombstone only counts when it is newer than the
// record's _mtime, so an existing-but-older marker (edit-after-delete)
// still needs a fresh one. No baseline for ref (first sync, new
// collection, reset manifest) returns empty — an empty baseline must
// never tombstone anything.
func tomb_missing_ids(ref, lr, rr, tm, man) (ids) {
    ids = []string{}
    blob := man[ref]
    if blob == "" { return ids }
    cur := make(map[string]int)
    i := 0
    while i < len(lr) {
        id := rec_id(lr[i])
        if id != "" { cur[id] = 1 }
        i = i + 1
    }
    old := man_decode(blob)
    i = 0
    while i < len(old) {
        id := old[i]
        if cur[id] == 0 {
            rmt := 0
            rrec := find_rec(rr, id)
            if rrec != "" { rmt = rec_mtime(rrec) }
            if tm[ref + "|" + id] <= rmt {
                ids = append(ids, id)
            }
        }
        i = i + 1
    }
    return ids
}

// Mirror of tomb_missing_ids for the remote side: ids that were in ref's
// last-seen REMOTE set (rman) but are absent from the current remote
// fetch (rr) were deleted remotely through the store API — without a
// tombstone the merge would read the surviving local copy as local-only
// and push it straight back up. An existing tombstone only counts when
// it beats the local copy's _mtime, so an older marker (edit-after-
// delete) still needs a fresh one. No baseline, an incomplete remote
// fetch (caller checks rok), or an EMPTY remote collection returns
// empty — a wiped/rebuilt remote must not mass-delete every device's
// local data, so remote-vanish detection only runs on a non-empty rr.
func tomb_remote_missing_ids(ref, lr, rr, tm, rman) (ids) {
    ids = []string{}
    blob := rman[ref]
    if blob == "" || len(rr) == 0 { return ids }
    cur := make(map[string]int)
    i := 0
    while i < len(rr) {
        id := rec_id(rr[i])
        if id != "" { cur[id] = 1 }
        i = i + 1
    }
    old := man_decode(blob)
    i = 0
    while i < len(old) {
        id := old[i]
        if cur[id] == 0 {
            lmt := 0
            lrec := find_rec(lr, id)
            if lrec != "" { lmt = rec_mtime(lrec) }
            if tm[ref + "|" + id] <= lmt {
                ids = append(ids, id)
            }
        }
        i = i + 1
    }
    return ids
}

// POST a sync/tombstones marker for each vanished id — the same doc shape
// apps write ({"ref","id":"ref|id","_mtime"}), so canon_tombs and
// load_tombs treat them identically. Returns how many were accepted.
func tomb_write_markers(ref, ids) (w) {
    w = 0
    mt := now_ms()
    i := 0
    while i < len(ids) {
        doc := "{\"ref\":" + json(ref) + ",\"id\":" + json(ref + "|" + ids[i]) +
            ",\"_mtime\":" + str(mt) + "}"
        if push_doc(sync_local, sync_local_tok, sync_tomb_coll, doc, "local") {
            w = w + 1
        }
        i = i + 1
    }
    return w
}

// Vanished-id handling for one ref, run inside sync_one_ref after both
// sides are fetched and before the merge. When markers were written the
// tombstone collection is re-synced so they reach the remote, and the
// returned map is the reloaded tomb set so this pass's pre-delete removes
// the remote copies immediately. tm is returned unchanged when nothing
// was written (no baseline, no vanished ids, or every marker POST failed).
// rman is threaded through for the nested tombstone-collection sync.
func tomb_vanished_sync(ref, lr, rr, tm, man, rman) (ntm) {
    ntm = tm
    need := tomb_missing_ids(ref, lr, rr, tm, man)
    if len(need) == 0 { return ntm }
    w := tomb_write_markers(ref, need)
    if w == 0 { return ntm }
    empty := make(map[string]int)
    sync_one_ref(sync_tomb_coll, empty, man, rman)
    ntm = load_tombs()
    perr("machin-365: sync: " + str(w) + " record(s) in " + ref +
        " vanished locally without a tombstone — wrote delete markers" +
        " so the deletes propagate (apps should POST sync/tombstones" +
        " before DELETE)")
    return ntm
}

// Remote-side twin of tomb_vanished_sync: ids that were in the remote
// baseline but vanished from the remote fetch get the same marker
// treatment, so a tombstone-less DELETE on the remote converges instead
// of resurrecting on the next push. Runs only when BOTH fetches are
// complete — a partial local page would misread surviving records, and a
// partial remote page would misread deletes (same rule tomb_missing_ids
// applies to lr).
func tomb_remote_vanished_sync(ref, lr, rr, tm, rman, man) (ntm) {
    ntm = tm
    need := tomb_remote_missing_ids(ref, lr, rr, tm, rman)
    if len(need) == 0 { return ntm }
    w := tomb_write_markers(ref, need)
    if w == 0 { return ntm }
    empty := make(map[string]int)
    sync_one_ref(sync_tomb_coll, empty, man, rman)
    ntm = load_tombs()
    perr("machin-365: sync: " + str(w) + " record(s) in " + ref +
        " vanished on the remote without a tombstone — wrote delete" +
        " markers so the deletes propagate")
    return ntm
}

// Load this pass's manifest baseline, discarding it when it was written
// under a different store identity — a switched store must not inherit
// the old store's id set. what labels the diagnostic ("local"/"remote").
func manifest_begin_for(path, ckey, what) (man) {
    man, acct := load_manifest(path)
    if acct != ckey {
        if acct != "" {
            perr("machin-365: sync: " + what + " store identity changed —" +
                " previous sync manifest ignored")
        }
        man = make(map[string]string)
    }
    return
}

// Local and remote baselines: same file format, different paths and
// identity keys (manifest_key vs remote_manifest_key).
func manifest_begin() (man, ckey) {
    ckey = manifest_key()
    man = manifest_begin_for(manifest_path(), ckey, "local")
    return
}

func remote_manifest_begin() (rman, rkey) {
    rkey = remote_manifest_key()
    rman = manifest_begin_for(remote_manifest_path(), rkey, "remote")
    return
}

// Fold one just-merged ref into the next baseline. A complete local fetch
// (sync_post_ok) makes the post-merge id set authoritative; an incomplete
// one keeps the previous baseline so the next pass can still tell a real
// delete from a bad page.
func manifest_note(ref, man, man_new) {
    if ref == sync_tomb_coll { return }
    if sync_post_ok {
        man_new[ref] = man_encode(sync_post_ids)
    } else if man[ref] != "" {
        man_new[ref] = man[ref]
    }
}

// Remote twin of manifest_note: a complete remote fetch
// (sync_post_rok) makes the post-merge remote id set authoritative;
// an incomplete one keeps the previous baseline.
func remote_manifest_note(ref, rman, rman_new) {
    if ref == sync_tomb_coll { return }
    if sync_post_rok {
        rman_new[ref] = man_encode(sync_post_rids)
    } else if rman[ref] != "" {
        rman_new[ref] = rman[ref]
    }
}
