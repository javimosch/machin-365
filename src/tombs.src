// tombs.src — delete-marker handling for sync. A deleter POSTs
// {"ref":"ns/coll","id":"ns/coll|<target>","_mtime":T} to sync/tombstones,
// then DELETEs the record. The tombstone's own doc id is the compound
// "ref|id" — a bare target id would let same-id deletes in different
// collections overwrite each other and resurrect. Legacy tombstones
// written with a bare ".id" are still honoured, and each sync pass
// rewrites them to the compound id.
//
// Retention: markers older than tomb_retention_ms are expired — sync
// stops fetching, merging and honouring them, so a pass costs
// O(deletes inside the window) instead of O(deletes ever). Expired
// markers are NOT deleted from the store: their doc ids contain the
// ref's "/" and the store API's DELETE route addresses a record by a
// single path segment, so compound-id docs cannot be removed over HTTP
// (verified against machin-bkn). They stay on disk as dormant rows;
// reclaiming them needs a bkn route that accepts multi-segment or
// query-addressed ids. The trade-off is a resurrection window: a peer
// offline longer than the retention window that still holds a deleted
// record will push it back (same failure family as #84/#85). 30 days is
// the conservative end of the window the issue suggests; it assumes
// roughly NTP-synced clocks, since each home computes its own cutoff.

// collection holding delete markers. New-style docs carry the compound
// "ref|id" as .id so same-id deletes in different collections cannot
// collide; legacy docs carry the bare target id and are still honoured.
var sync_tomb_coll = "sync/tombstones"

// How long a delete marker stays live for sync. Past this age the marker
// is invisible to every tombstone read (see header comment).
var tomb_retention_ms = 2592000000 // 30 days

// oldest _mtime a marker may carry and still be honoured this pass.
func tomb_cutoff() (cutoff) {
    return now_ms() - tomb_retention_ms
}

// tomb map: "ref|id" -> newest tombstone _mtime, from the (just-merged)
// local sync/tombstones collection.
func load_tombs() (tm) {
    tm = make(map[string]int)
    recs := fetch_records(sync_local, sync_local_tok, sync_tomb_coll, "local")
    i := 0
    while i < len(recs) {
        r := recs[i]
        ref := jstr(r, ".ref")
        id := jstr(r, ".id")
        mt := rec_mtime(r)
        // expired markers are dead weight — fetch_records already filters
        // them server-side, this is the same rule for stores that ignore
        // the filter or for callers holding unfiltered records
        if ref != "" && id != "" && mt > tomb_cutoff() {
            k := ref + "|" + id
            // new-style tombstones already use "ref|id" as the doc id —
            // that string IS the match key; legacy bare-id docs need the
            // ref prepended
            if has_prefix(id, ref + "|") { k = id }
            if mt > tm[k] { tm[k] = mt }
        }
        i = i + 1
    }
    return tm
}

// true when a tombstone newer than mt exists for ref/id — the record is dead.
func tomb_wins(tm, ref, id, mt) {
    return tm[ref + "|" + id] > mt
}

// Rewrite legacy bare-id tombstones to the compound "ref|id" doc id so
// same-id deletes in different collections can coexist. Runs on both
// sides before the tombstone merge each pass; already-compound docs and
// invalid markers are left alone. When a compound doc for the same target
// already exists with a newer-or-equal _mtime the legacy doc is redundant
// and is just dropped — rewriting it would needlessly downgrade the mt.
func canon_tombs(base, tok, side) {
    recs := fetch_records(base, tok, sync_tomb_coll, side)
    i := 0
    while i < len(recs) {
        r := recs[i]
        ref := jstr(r, ".ref")
        id := jstr(r, ".id")
        mt := rec_mtime(r)
        if ref != "" && id != "" && mt > tomb_cutoff() && !has_prefix(id, ref + "|") {
            nid := ref + "|" + id
            dup := find_rec(recs, nid)
            dmt := 0
            if dup != "" { dmt = rec_mtime(dup) }
            if dmt >= mt {
                api_delete(base, tok, "/v1/store/" + sync_tomb_coll + "/" + id, side)
            } else if push_doc(base, tok, sync_tomb_coll,
                "{\"ref\":" + json(ref) + ",\"id\":" + json(nid) +
                ",\"_mtime\":" + str(mt) + "}", side) {
                api_delete(base, tok, "/v1/store/" + sync_tomb_coll + "/" + id, side)
            }
        }
        i = i + 1
    }
}

// ---- sync manifests: the last-seen id sets per synced collection ----
//
// A DELETE on the store API removes the record and nothing else — no
// tombstone — so the next pass reads it as remote-only and pulls it back.
// sync-manifest.txt is the local baseline: ids that were present locally
// at the end of the last pass. An id that was synced but is absent now
// was deleted by *some* client; sync writes the tombstone marker itself
// so the delete propagates like an app delete would.
//
// sync-remote-manifest.txt is the mirror baseline: ids that were present
// on the remote at the end of the last pass. A raw store-API DELETE
// against the remote (admin cleanup, GDPR erasure, any non-suite client)
// leaves no marker either — without this baseline the local copy reads
// as "local-only" and is pushed straight back up, silently undoing the
// delete on every suite home. A remote-vanished baseline id that still
// has a local copy and NO live tombstone gets the same marker written
// locally, so the pre-delete pass removes the local copy and the marker
// propagates the delete to the other devices. When a live tombstone
// covers the id the absence is already explained — tomb_wins then keeps
// an edit-after-delete survivor instead of a fresh marker out-ranking it.
//
// File format (one section per synced collection):
//   machin-365 sync-manifest v1
//   account <key>
//   ref "<json-escaped ref>"
//   "<json-escaped id>"
//   ...
// The in-memory map is ref -> blob, where a blob is the section's id
// lines verbatim (each a json-quoted id + "\n"), so load/save round-trip
// without re-encoding.

// Identity the baseline is bound to: the account key plus the local
// endpoint. An account switch swaps the active bkn store
// (bkn_store_switch) and a different MACHIN_365_LOCAL is a different
// store — either way the old id set must not tombstone the new store's
// contents, so a mismatch discards the baseline rather than reusing it.
func manifest_key() {
    c := load_config()
    return account_store_key(c.server + "\n" + sync_local, c.email, c.org)
}

// Remote baseline identity: the account on the remote endpoint. Bound to
// sync_remote (the effective URL, env override included) rather than
// sync_local — a different remote or a different org is a different
// visibility scope, so its id set must not tombstone this one's records.
func remote_manifest_key() {
    c := load_config()
    return account_store_key(c.server + "\n" + sync_remote, c.email, c.org)
}

// blob <-> id list. blob lines are json()-quoted ids, one per line.
func man_encode(ids) (blob) {
    blob = ""
    i := 0
    while i < len(ids) {
        blob = blob + json(ids[i]) + "\n"
        i = i + 1
    }
    return blob
}

func man_decode(blob) (ids) {
    ids = []string{}
    rest := blob
    while rest != "" {
        e := index(rest, "\n")
        line := rest
        if e >= 0 {
            line = substr(rest, 0, e)
            rest = substr(rest, e + 1, len(rest))
        } else {
            rest = ""
        }
        if line != "" { ids = append(ids, parse(line, "")) }
    }
    return ids
}

// Load a manifest file into ref -> blob plus the stored account key (""
// when the file is absent or has no account line — the caller treats any
// key other than the current baseline key as no baseline).
func manifest_read(path) (man, acct) {
    man = make(map[string]string)
    acct = ""
    s := read_file(path)
    if s == "" { return }
    cur := ""
    rest := s
    while rest != "" {
        e := index(rest, "\n")
        line := rest
        if e >= 0 {
            line = substr(rest, 0, e)
            rest = substr(rest, e + 1, len(rest))
        } else {
            rest = ""
        }
        if has_prefix(line, "account ") {
            acct = substr(line, 8, len(line))
        } else if has_prefix(line, "ref ") {
            cur = parse(substr(line, 4, len(line)), "")
        } else if has_prefix(line, "\"") && cur != "" {
            man[cur] = man[cur] + line + "\n"
        }
    }
    return
}

// Persist a post-pass baseline. Only refs still in the sync set are
// written — a collection removed from sync loses its baseline, so a later
// re-add starts fresh instead of tombstoning whatever vanished meanwhile.
// temp+rename keeps a torn write from becoming a truncated baseline.
func manifest_write(path, tmp, man, acct, refs) {
    s := "machin-365 sync-manifest v1\naccount " + acct + "\n"
    i := 0
    while i < len(refs) {
        ref := refs[i]
        blob := man[ref]
        if blob != "" { s = s + "ref " + json(ref) + "\n" + blob }
        i = i + 1
    }
    if write_file(tmp, s) < 0 {
        eprintln("machin-365: could not write " + path)
        return
    }
    if system("mv -f '" + tmp + "' '" + path + "'") != 0 {
        remove(tmp)
        eprintln("machin-365: could not write " + path)
    }
}

func save_manifest(man, acct, refs) {
    manifest_write(manifest_path(), suite_home() + "/.sync-manifest.tmp",
        man, acct, refs)
}

func save_remote_manifest(man, acct, refs) {
    manifest_write(remote_manifest_path(),
        suite_home() + "/.sync-remote-manifest.tmp", man, acct, refs)
}

// Ids that were in ref's last-seen local set but are absent from the
// current local fetch (lr) AND would survive the current tombstones on
// the remote copy (rr): a tombstone only counts when it is newer than the
// record's _mtime, so an existing-but-older marker (edit-after-delete)
// still needs a fresh one. No baseline for ref (first sync, new
// collection, reset manifest) returns empty — an empty baseline must
// never tombstone anything.
func tomb_missing_ids(ref, lr, rr, tm, man) (ids) {
    ids = []string{}
    blob := man[ref]
    if blob == "" { return ids }
    cur := make(map[string]int)
    i := 0
    while i < len(lr) {
        id := rec_id(lr[i])
        if id != "" { cur[id] = 1 }
        i = i + 1
    }
    old := man_decode(blob)
    i = 0
    while i < len(old) {
        id := old[i]
        if cur[id] == 0 {
            rmt := 0
            rrec := find_rec(rr, id)
            if rrec != "" { rmt = rec_mtime(rrec) }
            if tm[ref + "|" + id] <= rmt {
                ids = append(ids, id)
            }
        }
        i = i + 1
    }
    return ids
}

// POST a sync/tombstones marker for each vanished id — the same doc shape
// apps write ({"ref","id":"ref|id","_mtime"}), so canon_tombs and
// load_tombs treat them identically. Returns how many were accepted.
func tomb_write_markers(ref, ids) (w) {
    w = 0
    mt := now_ms()
    i := 0
    while i < len(ids) {
        doc := "{\"ref\":" + json(ref) + ",\"id\":" + json(ref + "|" + ids[i]) +
            ",\"_mtime\":" + str(mt) + "}"
        if push_doc(sync_local, sync_local_tok, sync_tomb_coll, doc, "local") {
            w = w + 1
        }
        i = i + 1
    }
    return w
}

// Vanished-id handling for one ref, run inside sync_one_ref after both
// sides are fetched and before the merge. When markers were written the
// tombstone collection is re-synced so they reach the remote, and the
// returned map is the reloaded tomb set so this pass's pre-delete removes
// the remote copies immediately. tm is returned unchanged when nothing
// was written (no baseline, no vanished ids, or every marker POST failed).
func tomb_vanished_sync(ref, lr, rr, tm, man, rman) (ntm) {
    ntm = tm
    need := tomb_missing_ids(ref, lr, rr, tm, man)
    if len(need) == 0 { return ntm }
    w := tomb_write_markers(ref, need)
    if w == 0 { return ntm }
    empty := make(map[string]int)
    sync_one_ref(sync_tomb_coll, empty, man, rman)
    ntm = load_tombs()
    perr("machin-365: sync: " + str(w) + " record(s) in " + ref +
        " vanished locally without a tombstone — wrote delete markers" +
        " so the deletes propagate (apps should POST sync/tombstones" +
        " before DELETE)")
    return ntm
}

// Remote-side mirror of tomb_missing_ids: ids that were in ref's
// last-seen REMOTE set but are absent from the current remote fetch (rr)
// while a local copy (lr) exists and NO live tombstone covers the id.
// A live tombstone already explains the remote absence — sync itself
// removed the remote copy when propagating the marker — and tomb_wins
// picks the survivor: local _mtime older than the marker is pre-delete,
// newer is edit-after-delete and gets pushed back. Writing a fresh
// marker (with _mtime = now) over a live tombstone would out-rank that
// edit and destroy it, so only a tombstone-free absence — a raw
// store-API DELETE — is flagged. Callers must only run this after a
// COMPLETE remote fetch: the remote listing is org-scoped, so a partial
// page or a failed fetch would read still-present records as remote
// deletes. No baseline for ref returns empty — an empty baseline must
// never tombstone anything.
func remote_missing_ids(ref, lr, rr, tm, rman) (ids) {
    ids = []string{}
    blob := rman[ref]
    if blob == "" { return ids }
    cur := make(map[string]int)
    i := 0
    while i < len(rr) {
        id := rec_id(rr[i])
        if id != "" { cur[id] = 1 }
        i = i + 1
    }
    old := man_decode(blob)
    i = 0
    while i < len(old) {
        id := old[i]
        if cur[id] == 0 {
            lrec := find_rec(lr, id)
            if lrec != "" && tm[ref + "|" + id] == 0 {
                ids = append(ids, id)
            }
        }
        i = i + 1
    }
    return ids
}

// Remote-side mirror of tomb_vanished_sync. Markers are written to the
// LOCAL sync/tombstones in the same doc shape apps emit; the collection
// is then re-synced so they reach the remote (where the records are
// already gone — the markers only need to reach the OTHER devices) and
// the returned map is the reloaded tomb set so this pass's pre-delete
// removes the local copies immediately. tm is returned unchanged when
// nothing was written.
func tomb_remote_vanished_sync(ref, lr, rr, tm, man, rman) (ntm) {
    ntm = tm
    need := remote_missing_ids(ref, lr, rr, tm, rman)
    if len(need) == 0 { return ntm }
    w := tomb_write_markers(ref, need)
    if w == 0 { return ntm }
    empty := make(map[string]int)
    sync_one_ref(sync_tomb_coll, empty, man, rman)
    ntm = load_tombs()
    perr("machin-365: sync: " + str(w) + " record(s) in " + ref +
        " vanished on the remote without a tombstone — wrote delete" +
        " markers so the deletes propagate instead of being pushed back")
    return ntm
}

// Load this pass's manifest baseline, discarding it when it was written
// under a different account+endpoint identity — a switched store or a
// different remote scope must not inherit the old id set.
func manifest_begin() (man, ckey) {
    man, acct := manifest_read(manifest_path())
    ckey = manifest_key()
    if acct != ckey {
        if acct != "" {
            perr("machin-365: sync: local store identity changed —" +
                " previous sync manifest ignored")
        }
        man = make(map[string]string)
    }
    return
}

func remote_manifest_begin() (man, ckey) {
    man, acct := manifest_read(remote_manifest_path())
    ckey = remote_manifest_key()
    if acct != ckey {
        if acct != "" {
            perr("machin-365: sync: remote identity changed —" +
                " previous remote sync manifest ignored")
        }
        man = make(map[string]string)
    }
    return
}

// Fold one just-merged ref into the next baseline. A complete fetch on
// the side the baseline describes (ok + ids) makes the post-merge id set
// authoritative; an incomplete one keeps the previous baseline so the
// next pass can still tell a real delete from a bad page.
func manifest_note(ref, man, man_new, ok, ids) {
    if ref == sync_tomb_coll { return }
    if ok {
        man_new[ref] = man_encode(ids)
    } else if man[ref] != "" {
        man_new[ref] = man[ref]
    }
}
