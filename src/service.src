// service.src — the suite-managed local bkn instance.
// One bkn per suite home: binary in bin/, database in bkn/, pid in
// bkn/bkn.pid, log in bkn/bkn.log. Port and admin token live in config.json.
// Default port 17630; BKN_PORT-style override via MACHIN_365_BKN_PORT.
//
// Multiple suite homes (MACHIN_365_HOME) share that default port, so a
// bare "something answers /_health" is NOT proof the bkn belongs to this
// home — bkn_owner() verifies identity before start/status claim it.

func bkn_bin() { return suite_home() + "/bin/bkn" }
func bkn_db() { return suite_home() + "/bkn/bkn.db" }
func bkn_pidfile() { return suite_home() + "/bkn/bkn.pid" }
func bkn_log() { return suite_home() + "/bkn/bkn.log" }

func bkn_port() {
    p := env("MACHIN_365_BKN_PORT")
    if p != "" { return parse_int(p) }
    c := load_config()
    if c.local_port != 0 { return c.local_port }
    return 17630
}

func local_url() { return "http://127.0.0.1:" + str(bkn_port()) }

func find_bkn() {
    // --bin path wins, then PATH lookup, then an existing suite install.
    p := env("MACHIN_BKN_BIN")
    if p != "" { return p }
    _, out, _ := exec("command -v bkn 2>/dev/null || command -v mbkn 2>/dev/null")
    if trim(out) != "" { return trim(out) }
    if file_size(bkn_bin()) > 0 { return bkn_bin() }
    return ""
}

func cmd_service_install(a) (code) {
    code = 0
    src := ""
    i := 3
    while i < len(a) {
        arg := a[i]
        if has_prefix(arg, "--") {
            fname, val, has_eq := flag_eq(arg)
            if fname != "--bin" {
                usage_fail("unknown flag '" + arg + "'",
                    "usage: machin-365 service install [--bin /path/to/bkn]")
                return 2
            }
            v, last, ok := flag_value(a, i, val, has_eq)
            if !ok {
                usage_fail("--bin requires a value (e.g. --bin ./bkn)",
                    "usage: machin-365 service install [--bin /path/to/bkn]")
                return 2
            }
            src = v
            i = last + 1
            continue
        }
        if has_prefix(arg, "-") {
            usage_fail("unknown flag '" + arg + "'",
                "usage: machin-365 service install [--bin /path/to/bkn]")
            return 2
        }
        usage_fail("unexpected argument '" + arg + "'",
            "usage: machin-365 service install [--bin /path/to/bkn]")
        return 2
    }
    if src == "" { src = find_bkn() }
    if src == "" {
        eprintln("machin-365: no bkn binary found — pass --bin /path/to/bkn")
        return 1
    }
    system("mkdir -p '" + suite_home() + "/bin' '" + suite_home() + "/bkn'")
    b := read_file_bytes(src)
    if len(b) == 0 {
        eprintln("machin-365: cannot read " + src)
        return 1
    }
    // Snapshot the previous install so a failed verification restores it —
    // a rejected install leaves the suite exactly as it was.
    oldb := read_file_bytes(bkn_bin())
    had_old := file_size(bkn_bin()) > 0
    if write_bkn_bin(b) != 0 {
        eprintln("machin-365: cannot write " + bkn_bin())
        return 1
    }
    // Same gate `install` applies to app binaries: the bytes must actually
    // run on this host (right arch, interpreter present, no loader error)
    // before they are claimed installed.
    detail := probe_binary(bkn_bin())
    if detail != "" {
        restore_bkn_bin(oldb, had_old)
        eprintln("machin-365: " + src + " cannot run on this host — not installed")
        eprintln("  " + detail)
        return 1
    }
    // Runnable is not the same as bkn: /bin/true probes clean yet never
    // serves. The honest check is the one `service start` already does —
    // spawn it and require /_health to identify THIS home's instance
    // (bkn_owner). When this home's bkn is already running, restart onto
    // the new bytes first so upgrades are verified the same way; a
    // failure restores the previous binary and revives it.
    was_running := bkn_owner() == "ours"
    if was_running { cmd_service_stop() }
    oldpid := trim(read_file(bkn_pidfile()))
    if cmd_service_start() != 0 {
        service_install_rollback(oldpid)
        restore_bkn_bin(oldb, had_old)
        foreign := bkn_owner() == "foreign"
        tail := ""
        if !foreign { tail = service_log_tail() }
        // A foreign bkn holding the port is an environment problem, not a
        // bad binary — its log tail would only mislead, and reviving the
        // old binary would fail the same way. Otherwise surface the
        // launcher's own words (a text file's "not found", a loader
        // error) and put the previous service back.
        if foreign {
            // The port error above already says why — the binary itself
            // was never the problem.
            eprintln("machin-365: " + src + " not installed")
        } else {
            eprintln("machin-365: " + src + " is not a working bkn — install rejected")
            if tail != "" { eprintln("  " + tail) }
        }
        if was_running && had_old && !foreign { cmd_service_start() }
        return 1
    }
    println("installed bkn → " + bkn_bin())
    return code
}

// Write bin/bkn atomically: a rename replaces the directory entry even
// while the previous bkn is still executing it — a direct truncate-write
// fails ETXTBSY on a running binary and, unchecked, silently keeps the
// old bytes, so install would "verify" the wrong file.
func write_bkn_bin(b) (code) {
    code = 0
    tmp := suite_home() + "/bin/.bkn.tmp"
    if write_file_bytes(tmp, b) < 0 { remove(tmp)  return 1 }
    system("chmod +x '" + tmp + "'")
    if system("mv -f '" + tmp + "' '" + bkn_bin() + "'") != 0 {
        remove(tmp)
        return 1
    }
    return code
}

// Put back the previous bin/bkn after a failed install verify — a rejected
// install leaves the suite exactly as it was, not half-written.
func restore_bkn_bin(oldb, had_old) {
    if had_old {
        write_bkn_bin(oldb)
    } else {
        remove(bkn_bin())
    }
}

// Undo the spawn cmd_service_start attempted during install verification.
// Only a pid THIS attempt wrote to the pidfile may be killed — a
// pre-existing pidfile can name a pid the OS has since recycled, and that
// process is not ours to kill.
func service_install_rollback(oldpid) {
    pid := trim(read_file(bkn_pidfile()))
    if pid == "" || pid == oldpid { return }
    hp := bkn_health_pid()
    if hp != "" && hp != pid { return }
    system("kill " + pid + " 2>/dev/null")
    remove(bkn_pidfile())
}

// The tail of bkn.log as a string — the launcher's own account of why the
// binary never came up (a text file's "not found", a loader error). ""
// when there is no log. Returned rather than printed so the caller picks
// the ordering — a revive-start would truncate the log.
func service_log_tail() (t) {
    t = ""
    sz := file_size(bkn_log())
    if sz <= 0 { return }
    off := sz - 400
    if off < 0 { off = 0 }
    t = trim(bytes_str(read_file_at(bkn_log(), off, sz - off)))
    if t != "" { t = replace(t, "\n", "\n  ") }
    return
}

// pid the bkn answering /_health reports; "" when nothing healthy listens.
func bkn_health_pid() {
    st, body, err := http_get(local_url() + "/_health")
    if err != "" || st != 200 { return "" }
    v, e := json_get(body, ".pid")
    if e != "" { return "" }
    return trim(v)
}

// true when the listener accepts tok as an admin bearer on an authed
// store route. Proves the bkn on our port holds THIS home's token.
func bkn_accepts(tok) {
    st, _, err := http_request("GET",
        local_url() + "/v1/store/m365/tasks?limit=1",
        []string{"Authorization: Bearer " + tok}, "")
    return err == "" && st >= 200 && st < 300
}

// "ours" | "foreign" | "down" — who owns the bkn listening on bkn_port().
// A /_health 200 alone is not enough: every suite home's bkn answers it.
// Identity is proven by the admin token being accepted AND a bogus token
// rejected (a bkn started without BKN_ADMIN_TOKEN accepts anything on
// loopback, which proves nothing), or by /_health's pid matching the
// pidfile — the pid we spawned.
func bkn_owner() {
    hp := bkn_health_pid()
    if hp == "" { return "down" }
    c := load_config()
    if c.local_token != "" &&
        bkn_accepts(c.local_token) && !bkn_accepts("m365-foreign-probe") {
        return "ours"
    }
    pp := trim(read_file(bkn_pidfile()))
    if pp != "" && pp == hp { return "ours" }
    return "foreign"
}

// A failed start must not leave port/token in config.json claiming a
// local bkn is configured — sync would then probe a dead endpoint on
// every pass instead of reporting "no local bkn". Restores whatever the
// config held before this attempt (usually empty on a fresh home).
func service_start_unpersist(old_port, old_tok) {
    c := load_config()
    c.local_port = old_port
    c.local_token = old_tok
    save_config(c)
}

func cmd_service_start() (code) {
    code = 0
    c := load_config()
    old_port := c.local_port
    old_tok := c.local_token
    if c.local_token == "" {
        // 32 hex chars of randomness is enough for a loopback admin token.
        c.local_token = to_hex(rand_bytes(16))
    }
    // persist port+token — apps discover the endpoint via config.json
    c.local_port = bkn_port()
    save_config(c)
    own := bkn_owner()
    if own == "ours" {
        println("bkn already running at " + local_url())
        return code
    }
    if own == "foreign" {
        service_start_unpersist(old_port, old_tok)
        eprintln("machin-365: port " + str(bkn_port()) + " already serves a different bkn " +
            "(pid " + bkn_health_pid() + ") — another MACHIN_365_HOME?")
        eprintln("machin-365: set MACHIN_365_BKN_PORT or stop the other instance")
        return 1
    }
    system("mkdir -p '" + suite_home() + "/bkn'")
    cmd := "BKN_DATA='" + bkn_db() + "' BKN_PORT=" + str(bkn_port()) +
        " BKN_ADMIN_TOKEN='" + c.local_token + "' '" + bkn_bin() + "' serve" +
        " >'" + bkn_log() + "' 2>&1 & echo $!"
    _, out, err := exec(cmd)
    if err != "" {
        service_start_unpersist(old_port, old_tok)
        eprintln("machin-365: service start failed: " + err)
        return 1
    }
    pid := trim(out)
    write_file(bkn_pidfile(), pid + "\n")
    // wait until the port serves THIS home's bkn — a foreign bkn that
    // answers /_health must not satisfy the wait (or the claim).
    i := 0
    while i < 30 {
        own = bkn_owner()
        if own == "ours" {
            hpid := bkn_health_pid()
            if hpid != "" && hpid != pid { write_file(bkn_pidfile(), hpid + "\n") }
            println("bkn running at " + local_url() + " (pid " + hpid + ")")
            return code
        }
        if own == "foreign" { break }
        sleep(100)
        i = i + 1
    }
    own = bkn_owner()
    if own == "foreign" {
        eprintln("machin-365: port " + str(bkn_port()) + " is held by a different bkn — " +
            "set MACHIN_365_BKN_PORT or stop the other instance")
    } else {
        eprintln("machin-365: bkn did not come up — see " + bkn_log())
    }
    service_start_unpersist(old_port, old_tok)
    return 1
}

func cmd_service_stop() {
    pid := trim(read_file(bkn_pidfile()))
    if pid == "" {
        own := bkn_owner()
        if own == "foreign" {
            eprintln("machin-365: no pidfile — port " + str(bkn_port()) +
                " serves a bkn this home did not start (another MACHIN_365_HOME?)")
        } else if own == "ours" {
            eprintln("machin-365: bkn is running (pid " + bkn_health_pid() +
                ") but " + bkn_pidfile() + " is missing")
        } else {
            eprintln("machin-365: no pidfile — is the service running?")
        }
        return
    }
    // a healthy bkn on our port whose pid differs from the pidfile means
    // the pidfile is stale — its pid may have been recycled, so don't kill.
    hp := bkn_health_pid()
    if hp != "" && hp != pid {
        eprintln("machin-365: port " + str(bkn_port()) + " serves pid " + hp +
            ", not pidfile pid " + pid + " — pidfile is stale, not killing")
        remove(bkn_pidfile())
        return
    }
    if system("kill " + pid) == 0 {
        remove(bkn_pidfile())
        println("stopped bkn (pid " + pid + ")")
    } else {
        eprintln("machin-365: pid " + pid + " is not running — removing stale pidfile")
        remove(bkn_pidfile())
    }
}

func cmd_service_status() {
    own := bkn_owner()
    if own == "ours" {
        println("bkn: running at " + local_url() + " (pid " + bkn_health_pid() + ")")
        println("db:  " + bkn_db())
    } else if own == "foreign" {
        println("bkn: port " + str(bkn_port()) + " serves a different bkn (pid " +
            bkn_health_pid() + ") — not this home's instance")
        println("hint: set MACHIN_365_BKN_PORT for this home, or stop the other instance")
    } else {
        println("bkn: not running")
    }
}
