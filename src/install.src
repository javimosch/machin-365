// install.src — install, run and registry for suite apps.
// Layout per app:  apps/<id>/bin/<bin>   (the binary)
//                  data/<id>/            (the app's own local store)
// installed.json records id → {version, bin path, installed_at}.

type Installed struct {
    id string
    version string
    bin string
    installed_at string
}
type InstallRegistry struct { apps []Installed }

func load_registry() {
    r := InstallRegistry{apps: []Installed{}}
    s := read_file(installed_path())
    if s == "" { return r }
    return parse(s, InstallRegistry{})
}

func save_registry(r) {
    system("mkdir -p '" + suite_home() + "'")
    write_file(installed_path(), json(r))
}

func find_installed(r, id) (t, found) {
    t = Installed{id: "", version: "", bin: "", installed_at: ""}
    found = false
    i := 0
    while i < len(r.apps) {
        if r.apps[i].id == id {
            t = r.apps[i]
            found = true
            return
        }
        i = i + 1
    }
    return
}

func upsert_installed(r, t) {
    i := 0
    while i < len(r.apps) {
        if r.apps[i].id == t.id {
            r.apps[i] = t
            return r
        }
        i = i + 1
    }
    r.apps = append(r.apps, t)
    return r
}

// platform maps uname to catalog asset keys: linux-amd64, darwin-arm64, …
func platform() {
    _, o, _ := exec("uname -s")
    s := to_lower(trim(o))
    _, m, _ := exec("uname -m")
    mm := to_lower(trim(m))
    if mm == "x86_64" { mm = "amd64" }
    if mm == "aarch64" { mm = "arm64" }
    if s == "darwin" { return "darwin-" + mm }
    return "linux-" + mm
}

func write_desktop_file(id, app, bin) {
    d := desktop_dir()
    system("mkdir -p '" + d + "'")
    body := "[Desktop Entry]\n"
    body = body + "Type=Application\n"
    body = body + "Name=" + app.name + "\n"
    body = body + "Comment=" + app.desc + "\n"
    body = body + "Exec=" + bin + "\n"
    body = body + "Icon=applications-science\n"
    body = body + "Categories=Office;\n"
    body = body + "Terminal=false\n"
    write_file(d + "/machin-365-" + id + ".desktop", body)
}

func install_bin(id, app, src) (code) {
    code = 0
    dst := app_bin_dir(id) + "/" + app.bin
    system("mkdir -p '" + app_bin_dir(id) + "'")
    b := read_file_bytes(src)
    if len(b) == 0 {
        eprintln("machin-365: cannot read " + src)
        return 1
    }
    write_file_bytes(dst, b)
    system("chmod +x '" + dst + "'")
    reg := load_registry()
    reg = upsert_installed(reg, Installed{id: id, version: app.version, bin: dst, installed_at: str(now_ms())})
    save_registry(reg)
    write_desktop_file(id, app, dst)
    println("installed " + app.name + " " + app.version + " → " + dst)
    return code
}

func install_asset(id, app, asset) (code) {
    code = 0
    tmp := suite_home() + "/.dl-" + id
    system("mkdir -p '" + suite_home() + "'")
    dc, _, _ := exec("curl -fsSL '" + asset.url + "' -o '" + tmp + "'")
    if dc != 0 {
        eprintln("machin-365: download failed for " + id + " (curl exit " + str(dc) + ")")
        return 1
    }
    if asset.sha256 != "" {
        sum := to_hex(sha256_bytes(read_file_bytes(tmp)))
        if sum != asset.sha256 {
            remove(tmp)
            eprintln("machin-365: sha256 mismatch for " + id + " — refusing to install")
            return 1
        }
    }
    dst := app_bin_dir(id) + "/" + app.bin
    system("mkdir -p '" + app_bin_dir(id) + "'")
    system("mv -f '" + tmp + "' '" + dst + "'")
    system("chmod +x '" + dst + "'")
    reg := load_registry()
    reg = upsert_installed(reg, Installed{id: id, version: app.version, bin: dst, installed_at: str(now_ms())})
    save_registry(reg)
    write_desktop_file(id, app, dst)
    println("installed " + app.name + " " + app.version + " → " + dst)
    return code
}

func cmd_install(a) (code) {
    code = 0
    id := ""
    binpath := ""
    i := 2
    while i < len(a) {
        if a[i] == "--bin" && i+1 < len(a) {
            binpath = a[i+1]
            i = i + 2
            continue
        }
        if id == "" { id = a[i] }
        i = i + 1
    }
    if id == "" {
        eprintln("usage: machin-365 install <app-id> [--bin /path/to/binary]")
        return 2
    }
    cat := load_catalog()
    app, found := find_app(cat, id)
    if !found {
        eprintln("machin-365: unknown app '" + id + "' — see: machin-365 catalog")
        return 1
    }
    if binpath != "" { return install_bin(id, app, binpath) }

    want := platform()
    j := 0
    while j < len(app.assets) {
        if app.assets[j].platform == want {
            return install_asset(id, app, app.assets[j])
        }
        j = j + 1
    }
    eprintln("machin-365: no release asset for " + want + " — build from source")
    eprintln("  git clone " + app.repo + " && ./build.sh")
    eprintln("  then: machin-365 install " + id + " --bin ./build/" + app.bin)
    return 1
}

// ensure_service starts the local bkn when it is installed but not running,
// so suite apps get the bkn backend without a manual `service start`.
// Silent no-op when no bkn is installed — apps then use their own fallback.
// A bkn answering on our port that fails bkn_owner() is another suite
// home's: service start reports it loudly and we propagate the failure
// rather than let the app talk to the wrong home's data layer.
func ensure_service() (code) {
    code = 0
    if file_size(bkn_bin()) == 0 { return code }
    if bkn_owner() == "ours" { return code }
    return cmd_service_start()
}

// shell_quote wraps s in single quotes for /bin/sh, escaping embedded
// single quotes the POSIX way (' → '\'').
func shell_quote(s) {
    return "'" + replace(s, "'", "'\\''") + "'"
}

func cmd_run(a) (code) {
    code = 0
    id := ""
    i := 2
    while i < len(a) {
        if id == "" { id = a[i] }
        i = i + 1
    }
    if id == "" {
        eprintln("usage: machin-365 run <app-id> [args...]")
        return 2
    }
    if ensure_service() != 0 { return 1 }
    r := load_registry()
    t, found := find_installed(r, id)
    if !found {
        eprintln("machin-365: '" + id + "' is not installed — run: machin-365 install " + id)
        return 1
    }
    // system() inherits stdio, so the app's stdout/stderr reach the user
    // live — exec() would capture and silently drop them.
    cmd := shell_quote(t.bin)
    j := 3
    while j < len(a) {
        cmd = cmd + " " + shell_quote(a[j])
        j = j + 1
    }
    return system(cmd)
}

// catalog --refresh pulls ${server}/catalog.json into the suite-home
// snapshot, which then overrides the bundled catalog for catalog/install.
func catalog_refresh() (code) {
    code = 0
    c := load_config()
    if c.server == "" {
        eprintln("machin-365: no server configured — run: auth login --server URL")
        return 1
    }
    st, body, err := http_request("GET", c.server + "/catalog.json", []string{}, "")
    if err != "" || st != 200 {
        eprintln("machin-365: catalog fetch failed (http " + str(st) + ")")
        return 1
    }
    cat := parse(body, Catalog{})
    if len(cat.apps) == 0 {
        eprintln("machin-365: server catalog invalid — refusing to save")
        return 1
    }
    system("mkdir -p '" + suite_home() + "'")
    write_file(catalog_path(), body)
    println("catalog refreshed from " + c.server + " (" + str(len(cat.apps)) + " apps)")
    return code
}

func cmd_catalog(a) {
    if len(a) > 2 && a[2] == "--refresh" {
        if catalog_refresh() != 0 { return }
    }
    cat := load_catalog()
    r := load_registry()
    i := 0
    while i < len(cat.apps) {
        app := cat.apps[i]
        t, inst := find_installed(r, app.id)
        state := "available"
        if inst { state = "installed " + t.version }
        println(app.id + "\t" + app.name + "\t" + app.kind + "\t" + state + "\t" + app.desc)
        i = i + 1
    }
}
