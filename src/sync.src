// sync.src — one-pass bidirectional replication between the suite-managed
// local bkn and a remote bkn. Records are treated as opaque JSON: we only
// read .id and ._mtime and re-POST the raw object (POST upserts by id).
//
// Conflict policy: last-writer-wins on the _mtime field (ms). Sync stamps
// _mtime on any doc it writes that lacks one.
//
// Deletes DO propagate via tombstones (see tombs.src for the marker
// format and migration): a deleter POSTs a marker to sync/tombstones,
// then DELETEs the record. sync/tombstones is itself a synced collection,
// so tombstones replicate like any doc. A record whose _mtime is older
// than its tombstone is deleted on both sides; a newer _mtime
// (edit-after-delete) wins and the record survives. Apps that bypass
// tombstones will still see deletes resurrect — write the tombstone
// first, then delete.
//
// Endpoints: config.json server/token = remote; local_port/local_token =
// the service instance. Env overrides win for testing:
//   MACHIN_365_REMOTE[_TOKEN], MACHIN_365_LOCAL[_TOKEN]

var sync_remote = ""
var sync_remote_tok = ""
var sync_local = ""
var sync_local_tok = ""

// Failed local/remote data calls in the current pass. Every non-2xx (or
// transport error) on the store paths is counted and messaged — a sync that
// could not reach or was refused by a side must not report success.
var sync_err_count = 0
var sync_err_msgs = []string{}

// Credential-recovery state for the remote side: sync_remote_auth_err is
// set by an auth-class remote failure, triggering one refresh + retry;
// sync_refresh_dead stops further attempts (refresh rejected, or a fresh
// token still refused); sync_refresh_warned prints the login hint once.
var sync_remote_auth_err = false
var sync_refresh_dead = false
var sync_refresh_warned = false

// "HTTP 403 <server message>" style detail; transport errors pass through.
func http_errnote(st, err, resp) {
    if err != "" { return err }
    m, e := json_get(resp, ".error.message")
    if e == "" {
        mm := parse(m, "")
        if mm != "" { return "HTTP " + str(st) + " " + mm }
    }
    return "HTTP " + str(st)
}

func sync_note_err(side, what, st, err, resp) {
    sync_err_count = sync_err_count + 1
    if side == "remote" && auth_class_err(st, resp) { sync_remote_auth_err = true }
    msg := side + " " + what + " failed: " + http_errnote(st, err, resp)
    i := 0
    while i < len(sync_err_msgs) {
        if sync_err_msgs[i] == msg { return }
        i = i + 1
    }
    if len(sync_err_msgs) < 12 { sync_err_msgs = append(sync_err_msgs, msg) }
}

func sync_setup() {
    c := load_config()
    sync_remote = env("MACHIN_365_REMOTE")
    if sync_remote == "" { sync_remote = c.server }
    sync_remote_tok = env("MACHIN_365_REMOTE_TOKEN")
    if sync_remote_tok == "" { sync_remote_tok = c.token }
    sync_local = env("MACHIN_365_LOCAL")
    if sync_local == "" { sync_local = local_url() }
    sync_local_tok = env("MACHIN_365_LOCAL_TOKEN")
    if sync_local_tok == "" { sync_local_tok = c.local_token }
}

func api_get(base, tok, path) {
    st, body, err := http_request("GET", base + path,
        []string{"Authorization: Bearer " + tok}, "")
    return st, body, err
}

func api_post(base, tok, path, body) {
    st, resp, err := http_request("POST", base + path,
        []string{"Authorization: Bearer " + tok, "Content-Type: application/json"}, body)
    return st, resp, err
}

func api_delete(base, tok, path, side) {
    st, resp, err := http_request("DELETE", base + path,
        []string{"Authorization: Bearer " + tok}, "")
    ok := (st == 200 || st == 204) && err == ""
    if !ok { sync_note_err(side, "DELETE " + path, st, err, resp) }
    return ok
}

// fetch every record of a collection as raw JSON objects, paginated.
func fetch_records(base, tok, ref, side) (recs) {
    recs = []string{}
    off := 0
    while true {
        st, body, err := api_get(base, tok, "/v1/store/" + ref +
            "?limit=500&offset=" + str(off))
        if err != "" || st != 200 {
            if side == "remote" && is_private_admin_err(st, body) && remote_provision(ref) { continue }
            sync_note_err(side, "GET /v1/store/" + ref, st, err, body)
            break
        }
        i := 0
        n := 0
        while true {
            r, e := json_get(body, ".records[" + str(i) + "]")
            if e != "" { break }
            recs = append(recs, r)
            i = i + 1
            n = n + 1
        }
        if n < 500 { break }
        off = off + 500
    }
    return recs
}

// mtime of a raw record JSON; 0 when absent/unparseable.
func rec_mtime(rec) (mt) {
    mt = 0
    v, e := json_get(rec, "._mtime")
    if e != "" { return mt }
    return parse_int(trim(v))
}

// ensure _mtime is present, injecting now_ms() at top level if missing.
func stamp(rec) {
    _, e := json_get(rec, "._mtime")
    if e == "" { return rec }
    inner := substr(rec, 0, len(rec)-1)
    comma := ","
    if len(inner) <= 1 { comma = "" }
    return inner + comma + "\"_mtime\":" + str(now_ms()) + "}"
}

func rec_id(rec) {
    v, e := json_get(rec, ".id")
    if e != "" { return "" }
    return parse(v, "")
}

// string field of a raw record JSON; "" when absent.
func jstr(rec, path) {
    v, e := json_get(rec, path)
    if e != "" { return "" }
    return parse(v, "")
}

// find a raw record by id in a fetched list; "" when absent.
func find_rec(recs, id) {
    i := 0
    while i < len(recs) {
        if rec_id(recs[i]) == id { return recs[i] }
        i = i + 1
    }
    return ""
}

func push_doc(base, tok, ref, rec, side) {
    doc := stamp(rec)
    st, resp, err := api_post(base, tok, "/v1/store/" + ref, doc)
    ok := (st == 200 || st == 201) && err == ""
    if !ok && side == "remote" && is_private_admin_err(st, resp) && remote_provision(ref) {
        st, resp, err = api_post(base, tok, "/v1/store/" + ref, doc)
        ok = (st == 200 || st == 201) && err == ""
    }
    if !ok { sync_note_err(side, "POST /v1/store/" + ref, st, err, resp) }
    return ok
}

// comma-separated list → refs ("a/b, c/d" tolerates spaces)
func parse_coll_list(s) (refs) {
    refs = []string{}
    cur := ""
    i := 0
    while i <= len(s) {
        ch := ","
        if i < len(s) { ch = substr(s, i, i + 1) }
        if ch == "," {
            r := trim(cur)
            if r != "" { refs = append(refs, r) }
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    return refs
}

// collection discovery: --collections arg > config.sync_collections >
// GET /v1/collections (Go bkn only — machin-bkn has no HTTP list route).
func discover_refs(a) (refs) {
    refs = []string{}
    i := 2
    while i < len(a) {
        if (a[i] == "--collections" || a[i] == "--coll") && i+1 < len(a) {
            return parse_coll_list(a[i+1])
        }
        i = i + 1
    }
    c := load_config()
    if c.sync_collections != "" { return parse_coll_list(c.sync_collections) }
    // probe both sides, union what each exposes
    i = 0
    while i < 2 {
        base := sync_remote
        tok := sync_remote_tok
        if i == 1 { base = sync_local  tok = sync_local_tok }
        st, body, err := api_get(base, tok, "/v1/collections")
        if err == "" && st == 200 {
            j := 0
            while true {
                r, e := json_get(body, ".collections[" + str(j) + "].ref")
                if e != "" { break }
                ref := parse(r, "")
                if !has_ref(refs, ref) { refs = append(refs, ref) }
                j = j + 1
            }
        }
        i = i + 1
    }
    return refs
}

// merge one collection both ways. tm maps "ref|id" -> tombstone _mtime;
// records older than their tombstone are DELETE'd on their side and then
// treated as absent, so they cannot resurrect. An empty tm disables
// tombstone handling (used for the tombstone collection itself).
func sync_one_ref(ref, tm) {
    pushed := 0
    pulled := 0
    same := 0
    deleted := 0
    e0 := sync_err_count
    lr := fetch_records(sync_local, sync_local_tok, ref, "local")
    rr := fetch_records(sync_remote, sync_remote_tok, ref, "remote")

    // pre-delete: any surviving record that loses to a tombstone goes away
    j := 0
    while j < len(lr) {
        r := lr[j]
        id := rec_id(r)
        if id != "" && tomb_wins(tm, ref, id, rec_mtime(r)) {
            if api_delete(sync_local, sync_local_tok, "/v1/store/" + ref + "/" + id, "local") {
                deleted = deleted + 1
            }
        }
        j = j + 1
    }
    j := 0
    while j < len(rr) {
        r := rr[j]
        id := rec_id(r)
        if id != "" && tomb_wins(tm, ref, id, rec_mtime(r)) {
            if api_delete(sync_remote, sync_remote_tok, "/v1/store/" + ref + "/" + id, "remote") {
                deleted = deleted + 1
            }
        }
        j = j + 1
    }

    // merge survivors; tomb-losing records count as absent on their side
    j := 0
    while j < len(lr) {
        lrec := lr[j]
        id := rec_id(lrec)
        lm := rec_mtime(lrec)
        ldead := tomb_wins(tm, ref, id, lm)
        rrec := find_rec(rr, id)
        rdead := rrec != "" && tomb_wins(tm, ref, id, rec_mtime(rrec))
        if !ldead {
            if rrec == "" || rdead {
                // local-only (or remote copy dead) → push
                if push_doc(sync_remote, sync_remote_tok, ref, lrec, "remote") { pushed = pushed + 1 }
            } else {
                rm := rec_mtime(rrec)
                if lm > rm {
                    if push_doc(sync_remote, sync_remote_tok, ref, lrec, "remote") { pushed = pushed + 1 }
                } else if rm > lm {
                    if push_doc(sync_local, sync_local_tok, ref, rrec, "local") { pulled = pulled + 1 }
                } else {
                    same = same + 1
                }
            }
        }
        j = j + 1
    }
    // remote-only (or local-dead) docs → pull
    j := 0
    while j < len(rr) {
        rrec := rr[j]
        id := rec_id(rrec)
        if !tomb_wins(tm, ref, id, rec_mtime(rrec)) {
            lrec := find_rec(lr, id)
            lhas := lrec != "" && !tomb_wins(tm, ref, id, rec_mtime(lrec))
            if !lhas {
                if push_doc(sync_local, sync_local_tok, ref, rrec, "local") { pulled = pulled + 1 }
            }
        }
        j = j + 1
    }
    println(ref + ": pushed=" + str(pushed) + " pulled=" + str(pulled) +
        " deleted=" + str(deleted) + " same=" + str(same) +
        " local=" + str(len(lr)) + " remote=" + str(len(rr)))
    flush()
    if sync_err_count > e0 {
        eprintln(ref + ": " + str(sync_err_count - e0) + " call(s) failed")
    }
}

// the actionable hint prints once per process, not once per failed pass.
func sync_auth_warn(msg) {
    if sync_refresh_warned { return }
    sync_refresh_warned = true
    eprintln("machin-365: " + msg)
}

// One shot at remote credential recovery. Env-managed tokens
// (MACHIN_365_REMOTE_TOKEN) are the caller's problem — auth login cannot
// override them, so they are refused here rather than silently ignored.
// Returns the new access token on success; fatal=true means retrying later
// cannot help until the next auth login.
func sync_try_refresh() (ntok, ok, fatal) {
    ntok = ""
    ok = false
    fatal = false
    if env("MACHIN_365_REMOTE_TOKEN") != "" {
        sync_auth_warn("remote rejected MACHIN_365_REMOTE_TOKEN — set a valid" +
            " token or unset the env var (auth login cannot override it)")
        fatal = true
        return
    }
    ntok, ok, fatal = auth_refresh_stored(sync_remote)
    return
}

// Refresh ahead of expiry so --watch does not eat a failed pass every token
// TTL. Only config-managed JWTs are proactively refreshed; anything else
// falls through to the reactive path in sync_pass.
func sync_maybe_refresh() {
    if sync_refresh_dead { return }
    if env("MACHIN_365_REMOTE_TOKEN") != "" { return }
    exp := jwt_exp(sync_remote_tok)
    if exp == 0 || exp - now_ms() / 1000 > 60 { return }
    ntok, ok, fatal := sync_try_refresh()
    if ok {
        sync_remote_tok = ntok
        eprintln("machin-365: access token refreshed before expiry")
    } else {
        if fatal { sync_refresh_dead = true }
        sync_auth_warn("access token expired and refresh failed — run: machin-365 auth login")
    }
}

// one full replication pass: tombstones merge first so delete decisions
// use converged state, then every configured collection.
func sync_pass_once(refs) {
    sync_err_count = 0
    sync_err_msgs = []string{}
    sync_remote_auth_err = false
    sync_provision_tried = []string{}
    canon_tombs(sync_local, sync_local_tok, "local")
    canon_tombs(sync_remote, sync_remote_tok, "remote")
    empty := make(map[string]int)
    sync_one_ref(sync_tomb_coll, empty)
    tm := load_tombs()
    i := 0
    while i < len(refs) {
        if refs[i] != sync_tomb_coll { sync_one_ref(refs[i], tm) }
        i = i + 1
    }
    if sync_err_count > 0 {
        eprintln("sync incomplete: " + str(sync_err_count) + " call(s) failed this pass:")
        j := 0
        while j < len(sync_err_msgs) {
            eprintln("  " + sync_err_msgs[j])
            j = j + 1
        }
    }
}

// One pass plus credential recovery: when remote calls fail in an
// auth-class way, rotate the stored session via /v1/auth/refresh and retry
// the pass ONCE with the new token. A fresh token that is still refused
// (org-less login, revoked session) marks refresh dead for the process —
// sync keeps reporting the failures, but stops rotating tokens every pass.
func sync_pass(refs) {
    sync_maybe_refresh()
    sync_pass_once(refs)
    if !sync_remote_auth_err || sync_refresh_dead { return }
    ntok, ok, fatal := sync_try_refresh()
    if !ok {
        if fatal { sync_refresh_dead = true }
        if env("MACHIN_365_REMOTE_TOKEN") == "" {
            sync_auth_warn("remote rejected the access token and refresh failed" +
                " — run: machin-365 auth login")
        }
        return
    }
    sync_remote_tok = ntok
    eprintln("machin-365: access token refreshed — retrying pass")
    sync_pass_once(refs)
    if sync_remote_auth_err {
        sync_refresh_dead = true
        sync_auth_warn("token refreshed but remote still refuses — check org" +
            " scope (auth login --org SLUG) or run: auth login")
    }
}

func cmd_sync(a) (code) {
    code = 0
    sync_setup()
    if sync_remote == "" || sync_remote_tok == "" {
        eprintln("machin-365: no remote configured — run: auth login --server URL")
        return 1
    }
    if sync_local == "" || sync_local_tok == "" {
        eprintln("machin-365: no local bkn — run: service install && service start")
        return 1
    }

    watch := 0
    i := 2
    while i < len(a) {
        if a[i] == "--watch" {
            watch = 15
            if i + 1 < len(a) {
                n := parse_int(a[i + 1])
                if n > 0 { watch = n }
            }
        }
        i = i + 1
    }

    refs := discover_refs(a)
    if len(refs) == 0 {
        println("nothing to sync — no collections found")
        println("hint: machin-365 sync --collections ns/coll,ns/coll2")
        println("      or set sync_collections in config.json")
        return code
    }

    if watch > 0 {
        println("watching every " + str(watch) + "s — ctrl-c to stop")
        flush()
        pass := 0
        while true {
            pass = pass + 1
            println("=== sync pass " + str(pass) + " ===")
            flush()
            sync_pass(refs)
            flush()
            sleep(watch * 1000)
        }
        return code
    }
    sync_pass(refs)
    if sync_err_count > 0 { return 1 }
    return code
}

func has_ref(refs, ref) {
    i := 0
    while i < len(refs) {
        if refs[i] == ref { return true }
        i = i + 1
    }
    return false
}
