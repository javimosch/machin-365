// sync.src — one-pass bidirectional replication between the suite-managed
// local bkn and a remote bkn. Records are treated as opaque JSON: we only
// read .id and ._mtime and re-POST the raw object (POST upserts by id).
//
// Conflict policy: last-writer-wins on the _mtime field (ms). Sync stamps
// _mtime on any doc it writes that lacks one.
//
// Deletes DO propagate via tombstones (see tombs.src for the marker
// format and migration): a deleter POSTs a marker to sync/tombstones,
// then DELETEs the record. sync/tombstones is itself a synced collection,
// so tombstones replicate like any doc. A record whose _mtime is older
// than its tombstone is deleted on both sides; a newer _mtime
// (edit-after-delete) wins and the record survives. Deletes made through
// the store API carry no tombstone, so sync keeps last-seen id manifests
// on BOTH sides (manifests.src) and writes the missing markers itself — see
// tomb_missing_ids (local) and remote_missing_ids (remote).
//
// Endpoints: config.json server/token = remote; local_port/local_token =
// the service instance. Env overrides win for testing:
//   MACHIN_365_REMOTE[_TOKEN], MACHIN_365_LOCAL[_TOKEN]

var sync_remote = ""
var sync_remote_tok = ""
var sync_local = ""
var sync_local_tok = ""

// Failed local/remote data calls in the current pass. Every non-2xx (or
// transport error) on the store paths is counted and messaged — a sync that
// could not reach or was refused by a side must not report success.
var sync_err_count = 0
var sync_err_msgs = []string{}

// Set when a pass found the local endpoint unreachable. Lets a one-shot
// sync exit non-zero after doing no work, and lets --watch print the
// "service start" hint once per dead streak instead of every interval.
var sync_local_dead = false

// Credential-recovery state for the remote side: sync_remote_auth_err is
// set by an auth-class remote failure, triggering one refresh + retry;
// sync_refresh_dead stops further attempts (refresh rejected, or a fresh
// token still refused); sync_refresh_warned prints the login hint once.
var sync_remote_auth_err = false
var sync_refresh_dead = false
var sync_refresh_warned = false

// Manifest plumbing (tombs.src): sync_fetch_ok reports whether the last
// fetch_records call returned the whole collection — a partial fetch
// must not feed delete detection or become the new baseline.
// sync_post_*/sync_rpost_* carry the just-processed ref's post-merge
// local/remote id sets back to sync_pass_once for the manifest updates.
var sync_fetch_ok = true
var sync_post_ok = false
var sync_post_ids = []string{}
var sync_rpost_ok = false
var sync_rpost_ids = []string{}

// sync_rpost_mts maps each sync_rpost_ids entry to the remote-side
// _mtime the record will hold after this pass — the remote manifest's
// v2 payload (manifests.src man_encode_mt).
var sync_rpost_mts = make(map[string]int)

// fetch every record of a collection as raw JSON objects, paginated.
// sync_fetch_ok ends true only when every page arrived — callers that
// persist or diff the result (the sync manifest) must check it.
// sync/tombstones is fetched with a server-side _mtime floor so markers
// past the retention window never leave the store (tombs.src): the merge
// then only ever sees live markers, and expired rows stop costing
// transfer on every pass. load_tombs applies the same cutoff client-side
// for stores that ignore the filter.
func fetch_records(base, tok, ref, side) (recs) {
    recs = []string{}
    sync_fetch_ok = true
    off := 0
    while true {
        q := "?limit=500&offset=" + str(off)
        if ref == sync_tomb_coll { q = q + "&_mtime=gt:" + str(tomb_cutoff()) }
        st, body, err := api_get(base, tok, "/v1/store/" + ref + q)
        if err != "" || st != 200 {
            quiet := false
            if side == "remote" && is_private_admin_err(st, body) {
                // Read-path self-declaration is gated on local writes being
                // pending for this ref (sync_prov_gate, set by sync_one_ref):
                // declaring an empty<->empty ref leaves a phantom collection
                // on the server (#101). Gate 2 retries after the PUT; gate 1
                // reports the ref absent instead of erroring; gate 0 means
                // the local fetch already failed, so stay quiet here.
                if sync_prov_gate == 2 {
                    if remote_provision(ref) { continue }
                } else {
                    if sync_prov_gate == 1 { sync_note_absent(ref) }
                    quiet = true
                }
            }
            if !quiet { sync_note_err(side, "GET /v1/store/" + ref, st, err, body) }
            sync_fetch_ok = false
            break
        }
        i := 0
        n := 0
        while true {
            r, e := json_get(body, ".records[" + str(i) + "]")
            if e != "" { break }
            recs = append(recs, r)
            i = i + 1
            n = n + 1
        }
        if n < 500 { break }
        off = off + 500
    }
    return recs
}

// mtime of a raw record JSON; 0 when absent/unparseable.
func rec_mtime(rec) (mt) {
    mt = 0
    v, e := json_get(rec, "._mtime")
    if e != "" { return mt }
    return parse_int(trim(v))
}

// _mtime the remote record will carry after push_doc: the doc's own, or
// the stamp() injection when absent — approximated by now_ms() (the
// inject runs a few instructions later inside push_doc; ms-level skew
// is harmless for manifest bookkeeping).
func push_mtime(rec) {
    mt := rec_mtime(rec)
    if mt > 0 { return mt }
    return now_ms()
}

// ensure _mtime is present, injecting now_ms() at top level if missing.
func stamp(rec) {
    _, e := json_get(rec, "._mtime")
    if e == "" { return rec }
    inner := substr(rec, 0, len(rec)-1)
    comma := ","
    if len(inner) <= 1 { comma = "" }
    return inner + comma + "\"_mtime\":" + str(now_ms()) + "}"
}

func rec_id(rec) {
    v, e := json_get(rec, ".id")
    if e != "" { return "" }
    return parse(v, "")
}

// string field of a raw record JSON; "" when absent.
func jstr(rec, path) {
    v, e := json_get(rec, path)
    if e != "" { return "" }
    return parse(v, "")
}

// find a raw record by id in a fetched list; "" when absent.
func find_rec(recs, id) {
    i := 0
    while i < len(recs) {
        if rec_id(recs[i]) == id { return recs[i] }
        i = i + 1
    }
    return ""
}

func push_doc(base, tok, ref, rec, side) {
    doc := stamp(rec)
    st, resp, err := api_post(base, tok, "/v1/store/" + ref, doc)
    ok := (st == 200 || st == 201) && err == ""
    if !ok && side == "remote" && is_private_admin_err(st, resp) && remote_provision(ref) {
        st, resp, err = api_post(base, tok, "/v1/store/" + ref, doc)
        ok = (st == 200 || st == 201) && err == ""
    }
    if !ok { sync_note_err(side, "POST /v1/store/" + ref, st, err, resp) }
    return ok
}

// merge one collection both ways. tm maps "ref|id" -> tombstone _mtime;
// records older than their tombstone are DELETE'd on their side and then
// treated as absent, so they cannot resurrect. An empty tm disables
// tombstone handling (used for the tombstone collection itself). man and
// rman are the sync manifests (tombs.src): store-API deletes leave no
// marker, so vanished baseline ids get one written before the merge.
// On return sync_post_*/sync_rpost_* describe this ref's post-merge
// local and remote ids.
func sync_one_ref(ref, tm, man, rman) {
    pushed := 0
    pulled := 0
    same := 0
    deleted := 0
    e0 := sync_err_count
    lr := fetch_records(sync_local, sync_local_tok, ref, "local")
    lok := sync_fetch_ok
    // Arm read-path self-provisioning for the remote fetch below: the
    // remote collection is only worth declaring when this pass would push
    // local records into it (#101).
    sync_prov_gate = sync_prov_gate_for(ref, lr, tm, lok)
    rr := fetch_records(sync_remote, sync_remote_tok, ref, "remote")
    rok := sync_fetch_ok

    // Only COMPLETE fetches may feed delete detection — a partial page
    // would read missing records as deletes. rok is captured before the
    // vanished-sync calls: their nested tombstone sync overwrites
    // sync_fetch_ok. The remote listing is org-scoped, so a refused or
    // partial remote fetch must never read as mass remote deletes.
    if lok && ref != sync_tomb_coll {
        tm = tomb_vanished_sync(ref, lr, rr, tm, man, rman)
    }
    if rok && ref != sync_tomb_coll {
        tm = tomb_remote_vanished_sync(ref, lr, rr, tm, man, rman)
    }
    post := []string{}

    // pre-delete: any surviving record that loses to a tombstone goes away
    j := 0
    while j < len(lr) {
        r := lr[j]
        id := rec_id(r)
        if id != "" && tomb_wins(tm, ref, id, rec_mtime(r)) {
            if api_delete(sync_local, sync_local_tok, "/v1/store/" + ref + "/" + id, "local") {
                deleted = deleted + 1
            }
        }
        j = j + 1
    }
    // Remote pre-delete doubles as the post-merge remote id set for the
    // remote manifest. A push only fires for ids absent or tomb-dead on
    // the remote, so no id can be recorded twice. rpost_mt carries each
    // id's remote-side _mtime for the manifest's v2 lines.
    rpost := []string{}
    rpost_mt := make(map[string]int)
    j = 0
    while j < len(rr) {
        r := rr[j]
        id := rec_id(r)
        mt := rec_mtime(r)
        if id != "" && tomb_wins(tm, ref, id, mt) {
            if api_delete(sync_remote, sync_remote_tok, "/v1/store/" + ref + "/" + id, "remote") {
                deleted = deleted + 1
            }
        } else if id != "" {
            rpost = append(rpost, id)
            rpost_mt[id] = mt
        }
        j = j + 1
    }

    // merge survivors; tomb-losing records count as absent on their side
    j := 0
    while j < len(lr) {
        lrec := lr[j]
        id := rec_id(lrec)
        lm := rec_mtime(lrec)
        ldead := tomb_wins(tm, ref, id, lm)
        rrec := find_rec(rr, id)
        rdead := rrec != "" && tomb_wins(tm, ref, id, rec_mtime(rrec))
        if !ldead {
            if id != "" { post = append(post, id) }
            if rrec == "" || rdead {
                // local-only (or remote copy dead) → push
                if push_doc(sync_remote, sync_remote_tok, ref, lrec, "remote") {
                    pushed = pushed + 1
                    if id != "" {
                        rpost = append(rpost, id)
                        rpost_mt[id] = push_mtime(lrec)
                    }
                }
            } else {
                rm := rec_mtime(rrec)
                if lm > rm {
                    if push_doc(sync_remote, sync_remote_tok, ref, lrec, "remote") {
                        pushed = pushed + 1
                        // the remote now holds the newer local doc —
                        // refresh the mtime pre-delete recorded
                        if id != "" { rpost_mt[id] = push_mtime(lrec) }
                    }
                } else if rm > lm {
                    if push_doc(sync_local, sync_local_tok, ref, rrec, "local") { pulled = pulled + 1 }
                } else {
                    same = same + 1
                }
            }
        }
        j = j + 1
    }
    // remote-only (or local-dead) docs → pull
    j := 0
    while j < len(rr) {
        rrec := rr[j]
        id := rec_id(rrec)
        if !tomb_wins(tm, ref, id, rec_mtime(rrec)) {
            lrec := find_rec(lr, id)
            lhas := lrec != "" && !tomb_wins(tm, ref, id, rec_mtime(lrec))
            if !lhas {
                if push_doc(sync_local, sync_local_tok, ref, rrec, "local") {
                    pulled = pulled + 1
                    if id != "" { post = append(post, id) }
                }
            }
        }
        j = j + 1
    }
    sync_post_ids = post
    sync_post_ok = lok
    sync_rpost_ids = rpost
    sync_rpost_mts = rpost_mt
    sync_rpost_ok = rok
    pout(ref + ": pushed=" + str(pushed) + " pulled=" + str(pulled) +
        " deleted=" + str(deleted) + " same=" + str(same) +
        " local=" + str(len(lr)) + " remote=" + str(len(rr)))
    if sync_err_count > e0 {
        perr(ref + ": " + str(sync_err_count - e0) + " call(s) failed")
    }
}

// the actionable hint prints once per process, not once per failed pass.
func sync_auth_warn(msg) {
    if sync_refresh_warned { return }
    sync_refresh_warned = true
    eprintln("machin-365: " + msg)
}

// One shot at remote credential recovery. Env-managed tokens
// (MACHIN_365_REMOTE_TOKEN) are the caller's problem — auth login cannot
// override them, so they are refused here rather than silently ignored.
// Returns the new access token on success; fatal=true means retrying later
// cannot help until the next auth login.
func sync_try_refresh() (ntok, ok, fatal) {
    ntok = ""
    ok = false
    fatal = false
    if env("MACHIN_365_REMOTE_TOKEN") != "" {
        sync_auth_warn("remote rejected MACHIN_365_REMOTE_TOKEN — set a valid" +
            " token or unset the env var (auth login cannot override it)")
        fatal = true
        return
    }
    ntok, ok, fatal = auth_refresh_stored(sync_remote)
    return
}

// Refresh ahead of expiry so --watch does not eat a failed pass every token
// TTL. Only config-managed JWTs are proactively refreshed; anything else
// falls through to the reactive path in sync_pass.
func sync_maybe_refresh() {
    if sync_refresh_dead { return }
    if env("MACHIN_365_REMOTE_TOKEN") != "" { return }
    exp := jwt_exp(sync_remote_tok)
    if exp == 0 || exp - now_ms() / 1000 > 60 { return }
    ntok, ok, fatal := sync_try_refresh()
    if ok {
        sync_remote_tok = ntok
        perr("machin-365: access token refreshed before expiry")
    } else {
        if fatal { sync_refresh_dead = true }
        sync_auth_warn("access token expired and refresh failed — run: machin-365 auth login")
    }
}

// one full replication pass: tombstones merge first so delete decisions
// use converged state, then every configured collection.
func sync_pass_once(refs) {
    sync_err_count = 0
    sync_err_msgs = []string{}
    sync_remote_auth_err = false
    sync_provision_tried = []string{}
    if !local_alive() {
        if !sync_local_dead {
            perr("machin-365: local bkn not running at " + sync_local +
                " — run: service start")
            sync_local_dead = true
        }
        return
    }
    sync_local_dead = false
    // canon_tombs' remote fetch is maintenance, not a sync decision — pin
    // the provisioning gate off so an undeclared remote sync/tombstones is
    // skipped quietly; sync_one_ref re-arms it precisely per ref below.
    sync_prov_gate = 0
    canon_tombs(sync_local, sync_local_tok, "local")
    canon_tombs(sync_remote, sync_remote_tok, "remote")
    man, ckey := manifest_begin()
    rman, rkey := remote_manifest_begin()
    empty := make(map[string]int)
    sync_one_ref(sync_tomb_coll, empty, man, rman)
    tm := load_tombs()
    man_new := make(map[string]string)
    rman_new := make(map[string]string)
    i := 0
    while i < len(refs) {
        ref := refs[i]
        if ref != sync_tomb_coll { sync_one_ref(ref, tm, man, rman) }
        manifest_note(ref, man, man_new, sync_post_ok, sync_post_ids)
        manifest_note_mt(ref, rman, rman_new, sync_rpost_ok, sync_rpost_ids, sync_rpost_mts)
        i = i + 1
    }
    save_manifest(man_new, ckey, refs)
    save_remote_manifest(rman_new, rkey, refs)
    if sync_err_count > 0 {
        perr("sync incomplete: " + str(sync_err_count) + " call(s) failed this pass:")
        j := 0
        while j < len(sync_err_msgs) {
            perr("  " + sync_err_msgs[j])
            j = j + 1
        }
    }
}

// One pass plus credential recovery: when remote calls fail in an
// auth-class way, rotate the stored session via /v1/auth/refresh and retry
// the pass ONCE with the new token. A fresh token that is still refused
// (org-less login, revoked session) marks refresh dead for the process —
// sync keeps reporting the failures, but stops rotating tokens every pass.
func sync_pass(refs) {
    sync_maybe_refresh()
    sync_pass_once(refs)
    if !sync_remote_auth_err || sync_refresh_dead { return }
    ntok, ok, fatal := sync_try_refresh()
    if !ok {
        if fatal { sync_refresh_dead = true }
        if env("MACHIN_365_REMOTE_TOKEN") == "" {
            sync_auth_warn("remote rejected the access token and refresh failed" +
                " — run: machin-365 auth login")
        }
        return
    }
    sync_remote_tok = ntok
    perr("machin-365: access token refreshed — retrying pass")
    sync_pass_once(refs)
    if sync_remote_auth_err {
        sync_refresh_dead = true
        sync_auth_warn("token refreshed but remote still refuses — check org" +
            " scope (auth login --org SLUG) or run: auth login")
    }
}

func cmd_sync(a) (code) {
    code = 0

    watch, coll_arg, have_coll, err_msg := sync_parse_args(a)
    if err_msg != "" {
        eprintln("machin-365: " + err_msg)
        eprintln("usage: machin-365 sync [--collections a/b,c/d] [--watch [secs]]")
        return 2
    }

    sync_setup()
    if sync_remote == "" {
        eprintln("machin-365: no remote configured — run: auth login --server URL")
        return 1
    }
    if sync_remote_tok == "" {
        eprintln("machin-365: not logged in — run: auth login")
        return 1
    }
    if sync_local == "" || sync_local_tok == "" {
        eprintln("machin-365: no local bkn — run: service install && service start")
        return 1
    }

    refs := discover_refs(coll_arg)
    if have_coll && len(refs) == 0 {
        eprintln("machin-365: --collections named no collections")
        return 2
    }
    // --collections values were already validated in sync_parse_args; this
    // catches malformed refs that came from config.sync_collections or a
    // server probe instead — a poisoned config must fail loudly, not 404
    // every pass forever.
    bad := first_bad_ref(refs)
    if bad != "" {
        eprintln("machin-365: invalid collection ref '" + bad + "' — expected ns/coll")
        if !have_coll && load_config().sync_collections != "" {
            eprintln("hint: check sync_collections in config.json or set it via:" +
                " machin-365 config set sync_collections a/b,c/d")
        }
        return 2
    }
    if len(refs) == 0 {
        println("nothing to sync — no collections found")
        println("hint: machin-365 sync --collections ns/coll,ns/coll2  (remembered)")
        println("      or: machin-365 config set sync_collections ns/coll,ns/coll2")
        return code
    }

    if watch > 0 {
        sync_watch(refs, watch, have_coll)
        return code
    }
    sync_pass(refs)
    if sync_local_dead || sync_err_count > 0 { return 1 }
    if have_coll { persist_coll_arg(refs) }
    return code
}
