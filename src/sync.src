// sync.src — one-pass bidirectional replication between the suite-managed
// local bkn and a remote bkn. Records are treated as opaque JSON: we only
// read .id and ._mtime and re-POST the raw object (POST upserts by id).
// The one exception is tenancy: a pulled doc is stripped of the local
// collection's scope field before it is written locally (see scope.src) —
// the local store is single-user and a kept stamp would fork a second
// scope-keyed row beside the app's scope-less original.
//
// Conflict policy: last-writer-wins on the _mtime field — milliseconds
// since epoch, the unit sync itself writes (now_ms()). Sync stamps
// _mtime on any doc it writes that lacks one.
//
// Deletes DO propagate via tombstones (see tombs.src for the marker
// format and migration): a deleter POSTs a marker to sync/tombstones,
// then DELETEs the record. sync/tombstones is itself a synced collection,
// so tombstones replicate like any doc. A record whose _mtime is older
// than its tombstone is deleted on both sides; a newer _mtime
// (edit-after-delete) wins and the record survives. Deletes made through
// the store API carry no tombstone, so sync keeps last-seen id manifests
// on BOTH sides (manifests.src) and writes the missing markers itself — see
// tomb_missing_ids (local) and remote_missing_ids (remote). Markers are
// retained for a window then collected once their target is confirmed
// absent on both sides (tombgc.src).
//
// Endpoints: config.json server/token = remote; local_port/local_token =
// the service instance. Env overrides win for testing:
//   MACHIN_365_REMOTE[_TOKEN], MACHIN_365_LOCAL[_TOKEN]

var sync_remote = ""
var sync_remote_tok = ""
var sync_local = ""
var sync_local_tok = ""

// Failed local/remote data calls in the current pass. Every non-2xx (or
// transport error) on the store paths is counted and messaged — a sync that
// could not reach or was refused by a side must not report success.
var sync_err_count = 0
var sync_err_msgs = []string{}

// Fetched records whose _mtime sits in the epoch-seconds band this pass —
// reported once at the end of sync_pass_once so mixed-unit writers
// surface instead of diverging silently (#126).
var sync_mtime_suspect = 0

// Set when a pass found the local endpoint unreachable. Lets a one-shot
// sync exit non-zero after doing no work, and lets --watch print the
// "service start" hint once per dead streak instead of every interval.
var sync_local_dead = false

// Credential-recovery state for the remote side: sync_remote_auth_err is
// set by an auth-class remote failure, triggering one refresh + retry;
// sync_refresh_dead stops further attempts (refresh rejected, or a fresh
// token still refused); sync_refresh_warned prints the login hint once.
var sync_remote_auth_err = false
var sync_refresh_dead = false
var sync_refresh_warned = false

// sync_discovered is true when the ref set came from auto-discovery (no
// --collections flag, no sync_collections config). Discovered refs get
// fail-soft treatment on remote write-denial: a shared server lists
// collections the token may read but not administer, and those must not
// fail every pass (#107). Explicitly configured refs stay strict — the
// user asked for them by name.
var sync_discovered = false

// sync_denied_refs lists refs whose remote side answered the
// administered-privately 403 this pass; their remaining remote writes
// and remote→local pulls are skipped for the rest of the pass.
// sync_denied_warned dedupes the one-line warning across --watch passes.
var sync_denied_refs = []string{}
var sync_denied_warned = []string{}

// Manifest plumbing (tombs.src): sync_fetch_ok reports whether the last
// fetch_records call returned the whole collection — a partial fetch
// must not feed delete detection or become the new baseline.
// sync_fetch_absent marks the one failure that is NOT unknown state:
// the quiet private-admin refusal, meaning the collection is confirmed
// undeclared/invisible to this token. sync_post_*/sync_rpost_* carry
// the just-processed ref's post-merge local/remote id sets back to
// sync_pass_once for the manifest updates.
var sync_fetch_ok = true
var sync_fetch_absent = false
var sync_post_ok = false
var sync_post_ids = []string{}
var sync_rpost_ok = false
var sync_rpost_ids = []string{}

// sync_rpost_mts maps each sync_rpost_ids entry to the remote-side
// _mtime the record will hold after this pass — the remote manifest's
// v2 payload (manifests.src man_encode_mt).
var sync_rpost_mts = make(map[string]int)

// merge one collection both ways. tm maps "ref|id" -> tombstone _mtime;
// records older than their tombstone are DELETE'd on their side and then
// treated as absent, so they cannot resurrect. An empty tm disables
// tombstone handling (used for the tombstone collection itself). man and
// rman are the sync manifests (tombs.src): store-API deletes leave no
// marker, so vanished baseline ids get one written before the merge.
// On return sync_post_*/sync_rpost_* describe this ref's post-merge
// local and remote ids.
func sync_one_ref(ref, tm, man, rman) {
    pushed := 0
    pulled := 0
    same := 0
    deleted := 0
    e0 := sync_err_count
    lr := fetch_records(sync_local, sync_local_tok, ref, "local")
    lok := sync_fetch_ok
    heal_future_mtimes(sync_local, sync_local_tok, ref, lr, "local")
    // Arm read-path self-provisioning for the remote fetch below: the
    // remote collection is only worth declaring when this pass would push
    // local records into it (#101).
    sync_prov_gate = sync_prov_gate_for(ref, lr, tm, lok)
    rr := fetch_records(sync_remote, sync_remote_tok, ref, "remote")
    rok := sync_fetch_ok
    heal_future_mtimes(sync_remote, sync_remote_tok, ref, rr, "remote")
    // Captured with rok for the same reason: the vanished-sync calls
    // below run nested fetches that overwrite both globals.
    rabsent := sync_fetch_absent

    // Only COMPLETE fetches may feed delete detection — a partial page
    // would read missing records as deletes. rok is captured before the
    // vanished-sync calls: their nested tombstone sync overwrites
    // sync_fetch_ok. The remote listing is org-scoped, so a refused or
    // partial remote fetch must never read as mass remote deletes. A
    // complete-but-EMPTY remote fetch is just as dangerous: a wiped or
    // rebuilt remote collection is indistinguishable from every record
    // being deleted, so remote-side detection also requires a non-empty
    // rr — the pass then re-pushes the local records and restores the
    // remote instead of tombstoning every device's copy (#84).
    if lok && ref != sync_tomb_coll {
        tm = tomb_vanished_sync(ref, lr, rr, tm, man, rman)
    }
    if rok && len(rr) > 0 && ref != sync_tomb_coll {
        tm = tomb_remote_vanished_sync(ref, lr, rr, tm, man, rman)
    }
    post := []string{}

    // The merge itself needs the same completeness gate delete detection
    // got above (#152): a record missing from a partial fetch is unseen,
    // not absent — on that view every unfetched remote twin reads as
    // remote-absent and its local doc gets POSTed over the newer remote
    // record (and symmetrically for pulls on a partial local fetch).
    // The one exception is a CONFIRMED-absent remote (sync_fetch_absent:
    // the quiet private-admin refusal — undeclared or invisible
    // collection): writes would be refused the same way, so the merge
    // cannot clobber, and post_doc still gets its self-provision retry.
    // The local side has no confirmed-absent case — any local fetch
    // failure skips the merge outright.
    merge := lok && (rok || rabsent)

    // pre-delete: any surviving record that loses to a tombstone goes away.
    // Survivors also seed post here — the local post-merge id set — so a
    // merge skipped on an unknown remote fetch still leaves an accurate
    // baseline for manifest_note (pulled ids join post in the merge below).
    j := 0
    while j < len(lr) {
        r := lr[j]
        id := rec_id(r)
        if id != "" && tomb_wins(tm, ref, id, rec_mtime_bounded(r)) {
            if api_delete(sync_local, sync_local_tok, ref, id, "local") {
                deleted = deleted + 1
            }
        } else if id != "" {
            post = append(post, id)
        }
        j = j + 1
    }
    // Remote pre-delete doubles as the post-merge remote id set for the
    // remote manifest. A push only fires for ids absent or tomb-dead on
    // the remote, so no id can be recorded twice. rpost_mt carries each
    // id's remote-side _mtime for the manifest's v2 lines.
    rpost := []string{}
    rpost_mt := make(map[string]int)
    j = 0
    while j < len(rr) {
        r := rr[j]
        id := rec_id(r)
        mt := rec_mtime_bounded(r)
        if id != "" && tomb_wins(tm, ref, id, mt) {
            if api_delete(sync_remote, sync_remote_tok, ref, id, "remote") {
                deleted = deleted + 1
            }
        } else if id != "" {
            rpost = append(rpost, id)
            rpost_mt[id] = mt
        }
        j = j + 1
    }

    // merge survivors; tomb-losing records count as absent on their side.
    // Skipped entirely when either fetch failed: post/rpost then hold only
    // the pre-delete survivor sets — still accurate post-pass ids, so each
    // baseline below advances on its own side's fetch completeness rather
    // than freezing both on the failed side's unknown state (#152).
    if merge {
        // _mtime is a sync-internal stamp apps never write, so a local
        // record without a usable one reads as epoch 0 and loses every
        // LWW comparison — the next pull silently reverts the local
        // edit (#1). heal_local_docs stamps (and persists) now_ms() on
        // such records before any mtime is compared; records a live
        // tombstone condemns keep their epoch-0 read so deletes still
        // win over ambiguous unstamped writes.
        hn := heal_local_docs(ref, lr, tm)
        if hn > 0 {
            perr("machin-365: sync: " + ref + ": stamped _mtime on " +
                str(hn) + " local record(s) written without it")
        }
        j := 0
        while j < len(lr) {
            lrec := lr[j]
            id := rec_id(lrec)
            lm := rec_mtime_bounded(lrec)
            ldead := tomb_wins(tm, ref, id, lm)
            rrec := find_rec(rr, id)
            rdead := rrec != "" && tomb_wins(tm, ref, id, rec_mtime_bounded(rrec))
            if !ldead {
                if rrec == "" || rdead {
                    // local-only (or remote copy dead) → push
                    if sync_write_rec(ref, lrec, true) {
                        pushed = pushed + 1
                        if id != "" {
                            rpost = append(rpost, id)
                            rpost_mt[id] = push_mtime(lrec, ref)
                        }
                    }
                } else {
                    rm := rec_mtime_bounded(rrec)
                    if lm > rm {
                        if sync_write_rec(ref, lrec, true) {
                            pushed = pushed + 1
                            // the remote now holds the newer local doc —
                            // refresh the mtime pre-delete recorded
                            if id != "" { rpost_mt[id] = push_mtime(lrec, ref) }
                        }
                    } else if rm > lm {
                        // remote→local pull — skipped once the ref's remote
                        // side denied writes this pass (sync_deny_ref, #107)
                        if !sync_ref_denied(ref) &&
                            sync_write_rec(ref, rrec, false) { pulled = pulled + 1 }
                    } else {
                        same = same + 1
                    }
                }
            }
            j = j + 1
        }
        // remote-only (or local-dead) docs → pull
        j := 0
        while j < len(rr) {
            rrec := rr[j]
            id := rec_id(rrec)
            if !tomb_wins(tm, ref, id, rec_mtime_bounded(rrec)) {
                lrec := find_rec(lr, id)
                lhas := lrec != "" && !tomb_wins(tm, ref, id, rec_mtime_bounded(lrec))
                if !lhas {
                    // remote→local pull — skipped once the ref's remote
                    // side denied writes this pass (sync_deny_ref, #107)
                    if !sync_ref_denied(ref) &&
                        sync_write_rec(ref, rrec, false) {
                        pulled = pulled + 1
                        if id != "" { post = append(post, id) }
                    }
                }
            }
            j = j + 1
        }
    }
    sync_post_ids = post
    // post/rpost describe each side's post-pass id sets — the pre-delete
    // survivors plus whatever the merge added — so they stay accurate
    // even when the merge was skipped. The LOCAL baseline can advance on
    // lok alone: local vanished-id detection already ran on the complete
    // local view and its markers are written to the local tombstone
    // collection, so a skipped merge loses nothing by moving it forward
    // (#152). The REMOTE baseline additionally needs lok: remote vanished
    // detection cross-references local copies (find_rec over lr) and
    // writes its markers through the local store, so a failed local
    // fetch leaves remote deletes pending — freezing rman keeps the
    // pre-pass baseline so the next pass can still detect them.
    sync_post_ok = lok
    sync_rpost_ids = rpost
    sync_rpost_mts = rpost_mt
    sync_rpost_ok = rok && lok
    pout(ref + ": pushed=" + str(pushed) + " pulled=" + str(pulled) +
        " deleted=" + str(deleted) + " same=" + str(same) +
        " local=" + str(len(lr)) + " remote=" + str(len(rr)))
    if sync_err_count > e0 {
        perr(ref + ": " + str(sync_err_count - e0) + " call(s) failed")
    }
    if !merge {
        perr(ref + ": merge skipped — a fetch failed with state unknown," +
            " records left untouched this pass")
    }
}

// one full replication pass: tombstones merge first so delete decisions
// use converged state, then every configured collection.
func sync_pass_once(refs) {
    sync_err_count = 0
    sync_err_msgs = []string{}
    sync_mtime_clamped = 0
    sync_mtime_suspect = 0
    sync_remote_auth_err = false
    sync_provision_tried = []string{}
    sync_absent_pass = []string{}
    sync_denied_refs = []string{}
    sync_scope_cache = make(map[string]string)
    if !local_alive() {
        if !sync_local_dead {
            perr("machin-365: local bkn not running at " + sync_local +
                " — run: service start")
            sync_local_dead = true
        }
        return
    }
    sync_local_dead = false
    // canon_tombs' remote fetch is maintenance, not a sync decision — pin
    // the provisioning gate off so an undeclared remote sync/tombstones is
    // skipped quietly; sync_one_ref re-arms it precisely per ref below.
    sync_prov_gate = 0
    tomb_gc_begin()
    canon_tombs(sync_local, sync_local_tok, "local")
    canon_tombs(sync_remote, sync_remote_tok, "remote")
    man, ckey := manifest_begin()
    rman, rkey := remote_manifest_begin()
    empty := make(map[string]int)
    sync_one_ref(sync_tomb_coll, empty, man, rman)
    tm := load_tombs()
    man_new := make(map[string]string)
    rman_new := make(map[string]string)
    i := 0
    while i < len(refs) {
        ref := refs[i]
        if ref != sync_tomb_coll { sync_one_ref(ref, tm, man, rman) }
        manifest_note(ref, man, man_new, sync_post_ok, sync_post_ids)
        manifest_note_mt(ref, rman, rman_new, sync_rpost_ok, sync_rpost_ids, sync_rpost_mts)
        surv_note(ref, "local", sync_post_ids)
        surv_note(ref, "remote", sync_rpost_ids)
        i = i + 1
    }
    save_manifest(man_new, ckey, refs)
    save_remote_manifest(rman_new, rkey, refs)
    if sync_mtime_clamped > 0 {
        perr("machin-365: sync: rewrote _mtime on " + str(sync_mtime_clamped) +
            " doc(s) beyond the +" + str(mtime_skew_ms / 60000) +
            "min skew horizon to now — _mtime is ms since epoch;" +
            " check the writer's clock (#129)")
    }
    if sync_mtime_suspect > 0 {
        perr("machin-365: sync: " + str(sync_mtime_suspect) + " fetched" +
            " record(s) carry epoch-second-scale _mtime — scaled ×1000" +
            " to ms on read; _mtime is milliseconds since epoch" +
            " (see README)")
    }
    tomb_gc_finish()
    if sync_err_count > 0 {
        perr("sync incomplete: " + str(sync_err_count) + " call(s) failed this pass:")
        j := 0
        while j < len(sync_err_msgs) {
            perr("  " + sync_err_msgs[j])
            j = j + 1
        }
    }
}

func cmd_sync(a) (code) {
    code = 0

    if has_help(a, 2) { println(cmd_usage("sync"))  return code }
    watch, coll_arg, have_coll, err_msg := sync_parse_args(a)
    if err_msg != "" {
        eprintln("machin-365: " + err_msg)
        eprintln(cmd_usage("sync"))
        return 2
    }

    sync_setup()
    if sync_remote == "" {
        eprintln("machin-365: no remote configured — run: auth login --server URL")
        return 1
    }
    if sync_remote_tok == "" {
        eprintln("machin-365: not logged in — run: auth login")
        return 1
    }
    if sync_local == "" || sync_local_tok == "" {
        eprintln("machin-365: no local bkn — run: service install && service start")
        return 1
    }

    refs, discovered := discover_refs(coll_arg)
    if have_coll && len(refs) == 0 {
        eprintln("machin-365: --collections named no collections")
        return 2
    }
    // --collections values were already validated in sync_parse_args; this
    // catches malformed refs that came from config.sync_collections or a
    // server probe instead — a poisoned config must fail loudly, not 404
    // every pass forever.
    bad := first_bad_ref(refs)
    if bad != "" {
        eprintln("machin-365: invalid collection ref '" + bad +
            "' — expected ns/coll with [a-z0-9_-] segments")
        if !have_coll && load_config().sync_collections != "" {
            eprintln("hint: check sync_collections in config.json or set it via:" +
                " machin-365 config set sync_collections a/b,c/d")
        }
        return 2
    }
    if len(refs) == 0 {
        // An org-less session on an org-ful account discovers zero refs
        // forever — that is a broken login, not an idle sync (#119).
        warn_orgless_session()
        println("nothing to sync — no collections found")
        println("hint: machin-365 sync --collections ns/coll,ns/coll2  (remembered)")
        println("      or: machin-365 config set sync_collections ns/coll,ns/coll2")
        if sync_orgless_block { return 1 }
        return code
    }

    sync_discovered = discovered

    // One sync at a time per suite home (#138): the lock covers the
    // whole pass — manifest tmp writes AND the remote data plane — so
    // a concurrent `sync`/`sync --watch` fails fast instead of racing
    // the deterministic manifest paths. --watch holds it for its whole
    // lifetime; a one-shot releases it as soon as the pass is done.
    lst, lowner := sync_lock_acquire()
    if lst == 1 {
        eprintln("machin-365: sync already running (pid " + str(lowner) + ")")
        return 1
    }
    if lst != 0 {
        eprintln("machin-365: could not acquire sync lock")
        return 1
    }

    if watch > 0 {
        // sync_watch only returns on an identity change (#148) — release
        // the lock it holds for its whole lifetime before exiting.
        wrc := sync_watch(refs, watch, have_coll)
        sync_lock_release()
        return wrc
    }
    sync_pass(refs)
    sync_lock_release()
    if sync_local_dead || sync_err_count > 0 { return 1 }
    if have_coll { return persist_coll_flag(refs) }
    return code
}
