// main.src — entry point. argv[0] is the program name; the command is argv[1].

func cmd_config(a) (code) {
    code = 0
    if len(a) > 2 {
        if a[2] == "set" { return cmd_config_set(a) }
        if has_help(a, 2) { println(cmd_usage("config"))  return code }
        eprintln(cmd_usage("config"))
        return 2
    }
    c := load_config()
    println("home:    " + suite_home())
    println("server:  " + c.server)
    println("email:   " + c.email)
    println("org:     " + c.org)
    if c.sync_collections == "" {
        println("collections: (auto — set via: config set sync_collections a/b,c/d)")
    } else {
        println("collections: " + c.sync_collections)
    }
    if c.token != "" {
        println("token:   present")
    } else {
        println("token:   none")
    }
    return code
}

func cmd_init() (code) {
    code = 0
    msg := ensure_home()
    if msg != "" {
        eprintln("machin-365: " + msg)
        return 1
    }
    p := config_path()
    s := read_file(p)
    if s == "" {
        if save_config(load_config()) != 0 {
            eprintln("machin-365: cannot write suite home " + suite_home())
            return 1
        }
        println("initialized " + suite_home())
    } else {
        println("already initialized: " + suite_home())
    }
    if env("MACHIN_365_HOME") != "" && bkn_port() == 17630 {
        eprintln("machin-365: warning: MACHIN_365_HOME is set but the bkn port is the " +
            "shared default 17630 — set MACHIN_365_BKN_PORT to run multiple suite homes")
    }
    n := prune_desktops()
    if n > 0 { report_prune(n) }
    println("")
    println("next: machin-365 catalog   — see available apps")
    println("      machin-365 auth login --server URL --email E [--password P | --password-stdin]")
    return code
}

func dispatch(a) (code) {
    code = 0
    cmd := a[1]
    if cmd == "init" {
        if has_help(a, 2) { println(cmd_usage("init"))  return code }
        if len(a) > 2 {
            usage_fail("unexpected argument '" + a[2] + "'", cmd_usage("init"))
            return 2
        }
        return cmd_init()
    }
    if cmd == "catalog" || cmd == "apps" { return cmd_catalog(a) }
    if cmd == "install" { return cmd_install(a) }
    if cmd == "uninstall" { return cmd_uninstall(a) }
    if cmd == "prune" { return cmd_prune(a) }
    if cmd == "run" { return cmd_run(a) }
    if cmd == "auth" {
        sub := ""
        if len(a) > 2 { sub = a[2] }
        if is_help(sub) { println(cmd_usage("auth"))  return code }
        if sub == "login" { return cmd_auth_login(a) }
        if sub == "signup" { return cmd_auth_signup(a) }
        if sub == "member" { return cmd_auth_member(a) }
        if sub == "memberships" { return cmd_auth_memberships(a) }
        if sub == "orgs" { return cmd_auth_orgs(a) }
        if sub == "org" { return cmd_auth_org(a) }
        if sub == "switch-org" { return cmd_auth_switch_org(a) }
        if sub == "status" || sub == "logout" {
            if len(a) > 3 {
                if has_help(a, 3) { println(cmd_usage("auth " + sub))  return code }
                usage_fail("unexpected argument '" + a[3] + "'",
                    cmd_usage("auth " + sub))
                return 2
            }
            if sub == "status" { cmd_auth_status() } else { cmd_auth_logout() }
            return code
        }
        eprintln(cmd_usage("auth"))
        return 2
    }
    if cmd == "config" { return cmd_config(a) }
    if cmd == "service" {
        sub := ""
        if len(a) > 2 { sub = a[2] }
        if is_help(sub) { println(cmd_usage("service"))  return code }
        if sub == "install" { return cmd_service_install(a) }
        if sub == "reset" { return cmd_service_reset(a) }
        if sub == "start" || sub == "stop" || sub == "status" {
            if len(a) > 3 {
                if has_help(a, 3) { println(cmd_usage("service " + sub))  return code }
                usage_fail("unexpected argument '" + a[3] + "'",
                    cmd_usage("service " + sub))
                return 2
            }
            if sub == "start" { return cmd_service_start() }
            if sub == "stop" { cmd_service_stop() } else { cmd_service_status() }
            return code
        }
        eprintln(cmd_usage("service"))
        return 2
    }
    if cmd == "sync" { return cmd_sync(a) }
    if cmd == "help" {
        // `help` alone shows the top level; `help <cmd> [sub...]` resolves
        // the joined path to that command's usage — the leaf-level
        // counterpart of --help/-h.
        path := ""
        i := 2
        while i < len(a) {
            if path != "" { path = path + " " }
            path = path + a[i]
            i = i + 1
        }
        if is_help(path) || path == "" {
            print_usage()
            return code
        }
        u := cmd_usage(path)
        if u != "" {
            println(u)
            return code
        }
        eprintln("machin-365: unknown command '" + path + "'")
        print_usage()
        return 2
    }
    if cmd == "--help" || cmd == "-h" { print_usage()  return code }
    eprintln("machin-365: unknown command '" + cmd + "'")
    print_usage()
    return 2
}

func main() {
    a := args()
    if len(a) < 2 {
        print_usage()
        exit(2)
    }
    code := dispatch(a)
    if code != 0 { exit(code) }
}
