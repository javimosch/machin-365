// provision.src — remote collection self-provisioning for sync.
//
// bkn lets an org-scoped member declare a collection the token cannot yet
// see: PUT /v1/store/<ref> with an org-bounded access policy. That is what
// makes "signup, install, sync" work on a fresh open-signup deployment —
// without it every undeclared collection fails each pass with 403
// "administered privately". sync.src calls remote_provision() once per ref
// per pass after that exact refusal, then retries the failed call; a
// refused PUT (admin-declared collection, non-org deployment, org-less
// token) just keeps the original error.

// Refs whose provisioning PUT was already attempted this pass — the server
// refuses a second declaration anyway, so one try per ref per pass is
// enough (a fresh pass, e.g. after token refresh, may carry an org).
var sync_provision_tried = []string{}

// Read-path provisioning gate, set by sync_one_ref before each remote
// fetch (and pinned to 0 around canon_tombs, whose remote fetch is not a
// sync decision):
//   0 = local state unknown — the local fetch failed and already reported
//   1 = local fetch clean but nothing live to push for this ref
//   2 = local writes are pending — the remote collection is needed
// Only 2 may self-declare on a remote read refusal: an empty<->empty ref
// (a typo'd --collections) has nothing to declare, and provisioning it
// would leave a permanent phantom collection on the server (#101).
var sync_prov_gate = 0

// Refs already reported absent this process — a persisted typo would
// otherwise print the warning on every --watch pass.
var sync_absent_refs = []string{}

// Refs reported absent during the CURRENT pass. Unlike the warn-once
// list above this is rebuilt every pass, so the --collections persist
// gate sees exactly what the last pass flagged as absent on both sides
// (#131) — a ref absent once but live later must not stay excluded.
var sync_absent_pass = []string{}

// sync_prov_gate_for computes the read-path provisioning gate for one ref
// from its just-fetched local records: 0 = the local fetch failed (its
// error is already reported), 1 = clean fetch but nothing live to push,
// 2 = local writes pending. A record tombstone-dead under tm is deleted
// locally during the merge instead, so it is not a pending write; and
// since the remote fetch has not run yet, every live local record would
// push if it fails — which is exactly when declaring is justified.
func sync_prov_gate_for(ref, lr, tm, lok) (g) {
    g = 0
    if !lok { return }
    g = 1
    k := 0
    while k < len(lr) {
        if !tomb_wins(tm, ref, rec_id(lr[k]), rec_mtime_bounded(lr[k])) {
            g = 2
            break
        }
        k = k + 1
    }
    return
}

// One-line report for a ref that is refused on the remote read path while
// the local side has nothing to push. Not a sync error: there is genuinely
// nothing to move, and the collection is declared lazily on the first
// actual POST (push_doc). sync/tombstones is exempt — it is infrastructure,
// not a configured ref, and its absence is the normal fresh-install state.
func sync_note_absent(ref) {
    if ref == sync_tomb_coll { return }
    if !has_ref(sync_absent_pass, ref) {
        sync_absent_pass = append(sync_absent_pass, ref)
    }
    if has_ref(sync_absent_refs, ref) { return }
    sync_absent_refs = append(sync_absent_refs, ref)
    perr("machin-365: sync: " + ref + " absent on the remote and empty" +
        " locally — nothing to sync (check for typos)")
}

// true when a failed store call is the undeclared/private-collection refusal
// an org member can repair by self-declaring (bkn: "this collection is
// administered privately"). Other 403s — org-scope sign-in refusals,
// admin-only policies on already-declared collections — are not fixable by
// a declaration PUT and fall through to the normal error path.
func is_private_admin_err(st, resp) {
    if st != 403 { return false }
    m, e := json_get(resp, ".error.message")
    if e != "" { return false }
    return contains(parse(m, ""), "administered privately")
}

// true when ref's remote side already refused writes this pass — the
// ref is skipped for the rest of the pass (remote writes AND pulls).
func sync_ref_denied(ref) {
    return has_ref(sync_denied_refs, ref)
}

// Mark ref remote-denied for the rest of the pass and say so once per
// process. Only reached for the administered-privately 403 on discovered
// refs — every other failure still counts toward the pass result.
func sync_deny_ref(ref) {
    if !has_ref(sync_denied_refs, ref) {
        sync_denied_refs = append(sync_denied_refs, ref)
    }
    if has_ref(sync_denied_warned, ref) { return }
    sync_denied_warned = append(sync_denied_warned, ref)
    perr("machin-365: sync: " + ref + " is administered privately on the" +
        " remote — skipping it this pass (the token cannot write it;" +
        " collections pulled before discovery was scoped may need" +
        " removing locally)")
}

// org claim of the remote access token; "" for org-less or non-JWT tokens.
// Same unsigned payload read as jwt_exp — a presence check only, the server
// stays the verifier. bkn gates self-service PUTs on this claim, so an
// empty result means the PUT could only be refused: skip it quietly.
func jwt_org(token) {
    p1 := index(token, ".")
    if p1 <= 0 { return "" }
    rest := substr(token, p1 + 1, len(token))
    p2 := index(rest, ".")
    if p2 <= 0 { return "" }
    v, e := json_get(base64_decode(substr(rest, 0, p2)), ".org")
    if e != "" { return "" }
    return parse(v, "")
}

func api_put(base, tok, path, body) {
    st, resp, err := http_request("PUT", base + path,
        []string{"Authorization: Bearer " + tok, "Content-Type: application/json"}, body)
    return st, resp, err
}

// PUT /v1/store/<ref> declaring the default org-wide policy. Returns true
// only when the server accepted the declaration. A ref that cannot name a
// real collection (fails the bkn segment rule — see ref_ok in colls.src)
// is refused outright: provisioning exists to declare collections sync
// actually found, and a malformed ref is corruption, not a collection
// (#109 — phantom discovery refs must never mint server-side rows).
func remote_provision(ref) {
    if !ref_ok(ref) { return false }
    if has_ref(sync_provision_tried, ref) { return false }
    sync_provision_tried = append(sync_provision_tried, ref)
    if jwt_org(sync_remote_tok) == "" { return false }
    st, _, err := api_put(sync_remote, sync_remote_tok, "/v1/store/" + ref,
        "{\"access\":{\"rules\":{\"read\":\"org\",\"create\":\"org\",\"update\":\"org\",\"delete\":\"org\"},\"org_field\":\"org\"}}")
    if err != "" || (st != 200 && st != 201) { return false }
    perr("machin-365: declared remote collection " + ref)
    return true
}
