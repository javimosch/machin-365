// auth.src — login against a machin-bkn server.
// POST /v1/auth/login {email,password,org} → {ok, tokens:{access_token,…}}.
// The access token is stored in config.json and sent by apps as a bearer;
// refresh-token rotation is phase 2 (apps will call /v1/auth/refresh).

type Tokens struct {
    access_token string
    refresh_token string
    expires_in int
}
type LoginResp struct {
    ok bool
    tokens Tokens
}

func strip_slash(s) {
    while has_suffix(s, "/") && len(s) > 8 {
        s = substr(s, 0, len(s) - 1)
    }
    return s
}

// POST /v1/auth/login {email,password,org} → tokens. msg "" on success,
// otherwise the transport error or "HTTP <status> <body>" to report.
func auth_login_call(server, email, password, org) (lr, msg) {
    lr = LoginResp{}
    msg = ""
    body := "{\"email\":" + json(email) + ",\"password\":" + json(password) + ",\"org\":" + json(org) + "}"
    st, resp, err := http_request("POST", server + "/v1/auth/login", []string{"Content-Type: application/json"}, body)
    if err != "" { msg = err  return }
    if st != 200 { msg = "HTTP " + str(st) + " " + resp  return }
    lr = parse(resp, LoginResp{})
    if lr.tokens.access_token == "" { msg = "login response missing access_token" }
    return
}

// GET /v1/auth/me → the account's org slugs. ok=false means the server has
// no /me route or the call failed — memberships unknown, not zero.
func auth_my_orgs(server, tok) (orgs, ok) {
    orgs = []string{}
    ok = false
    st, body, err := http_request("GET", server + "/v1/auth/me",
        []string{"Authorization: Bearer " + tok}, "")
    if err != "" || st != 200 { return }
    ok = true
    j := 0
    while true {
        r, e := json_get(body, ".memberships[" + str(j) + "].org_slug")
        if e != "" { break }
        slug := parse(r, "")
        if slug != "" { orgs = append(orgs, slug) }
        j = j + 1
    }
    return
}

func join_strs(list, sep) {
    out := ""
    i := 0
    while i < len(list) {
        if i > 0 { out = out + sep }
        out = out + list[i]
        i = i + 1
    }
    return out
}

func cmd_auth_login(a) (code) {
    code = 0
    server := ""
    email := ""
    password := ""
    org := ""
    i := 2
    while i < len(a) {
        if a[i] == "--server" && i+1 < len(a) { server = a[i+1]  i = i + 2  continue }
        if a[i] == "--email" && i+1 < len(a) { email = a[i+1]  i = i + 2  continue }
        if a[i] == "--password" && i+1 < len(a) { password = a[i+1]  i = i + 2  continue }
        if a[i] == "--org" && i+1 < len(a) { org = a[i+1]  i = i + 2  continue }
        i = i + 1
    }
    if server == "" {
        server = load_config().server
    }
    if server == "" {
        eprintln("machin-365: --server required (e.g. https://bkn.example.com)")
        return 2
    }
    if email == "" || password == "" {
        eprintln("usage: machin-365 auth login --server URL --email E --password P [--org SLUG]")
        return 2
    }
    server = strip_slash(server)
    lr, msg := auth_login_call(server, email, password, org)
    if msg != "" {
        eprintln("machin-365: login failed: " + msg)
        return 1
    }

    // --org omitted: the issued token has an empty org claim, which
    // org-scoped collections refuse. Ask /v1/auth/me for memberships and
    // re-login scoped when the choice is unambiguous — the org this config
    // already used, or the account's only org. Several orgs need --org.
    picked := ""
    if org == "" {
        myorgs, mok := auth_my_orgs(server, lr.tokens.access_token)
        if mok {
            prev := load_config().org
            if prev != "" && has_ref(myorgs, prev) {
                picked = prev
            } else if len(myorgs) == 1 {
                picked = myorgs[0]
            }
            if picked != "" {
                org = picked
                lr, msg = auth_login_call(server, email, password, org)
                if msg != "" {
                    eprintln("machin-365: login failed: " + msg)
                    return 1
                }
            } else if len(myorgs) > 1 {
                eprintln("machin-365: this account belongs to " + str(len(myorgs)) +
                    " orgs: " + join_strs(myorgs, ", "))
                eprintln("machin-365: token has no org scope — re-run with --org SLUG" +
                    " (org-scoped collections refuse org-less tokens)")
            } else {
                eprintln("machin-365: account has no org memberships —" +
                    " org-scoped collections will refuse this token")
            }
        }
    }

    c := load_config()
    c.server = server
    c.token = lr.tokens.access_token
    c.refresh_token = lr.tokens.refresh_token
    c.email = email
    c.org = org
    save_config(c)
    println("logged in to " + server + " as " + email)
    if org != "" {
        note := ""
        if picked != "" { note = " (auto-selected — --org overrides)" }
        println("org: " + org + note)
    }
    return code
}

// default_org_slug derives a unique-ish workspace slug from the email:
// u-<sanitized local part>-<4 hex>. The suffix keeps collisions rare;
// callers can always pass --org explicitly.
func default_org_slug(email) {
    at := index(email, "@")
    local := email
    if at > 0 { local = substr(email, 0, at) }
    local = to_lower(local)
    out := ""
    i := 0
    while i < len(local) {
        ch := substr(local, i, i + 1)
        if (ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9") {
            out = out + ch
        } else if ch == "." || ch == "_" || ch == "-" || ch == " " {
            out = out + "-"
        }
        i = i + 1
    }
    if out == "" { out = "user" }
    if len(out) > 24 { out = substr(out, 0, 24) }
    return "u-" + out + "-" + to_hex(rand_bytes(2))
}

// auth signup: POST /v1/auth/register (BKN_OPEN_SIGNUP deployments) →
// POST /v1/auth/orgs (creator becomes owner — the tenant) → login --org
// for org-scoped tokens. Three calls because register returns unscoped
// tokens and sync needs the org claim for row-level tenancy.
func cmd_auth_signup(a) (code) {
    code = 0
    server := ""
    email := ""
    password := ""
    name := ""
    org := ""
    i := 2
    while i < len(a) {
        if a[i] == "--server" && i+1 < len(a) { server = a[i+1]  i = i + 2  continue }
        if a[i] == "--email" && i+1 < len(a) { email = a[i+1]  i = i + 2  continue }
        if a[i] == "--password" && i+1 < len(a) { password = a[i+1]  i = i + 2  continue }
        if a[i] == "--name" && i+1 < len(a) { name = a[i+1]  i = i + 2  continue }
        if a[i] == "--org" && i+1 < len(a) { org = a[i+1]  i = i + 2  continue }
        i = i + 1
    }
    if server == "" { server = load_config().server }
    if server == "" {
        eprintln("machin-365: --server required (e.g. https://bkn.example.com)")
        return 2
    }
    if email == "" || password == "" {
        eprintln("usage: machin-365 auth signup --server URL --email E --password P [--name N] [--org SLUG]")
        return 2
    }
    server = strip_slash(server)
    jhdr := []string{"Content-Type: application/json"}

    rbody := "{\"email\":" + json(email) + ",\"password\":" + json(password)
    if name != "" { rbody = rbody + ",\"name\":" + json(name) }
    rbody = rbody + "}"
    st, resp, err := http_request("POST", server + "/v1/auth/register", jhdr, rbody)
    if err != "" {
        eprintln("machin-365: signup failed: " + err)
        return 1
    }
    if st != 200 {
        eprintln("machin-365: signup failed: HTTP " + str(st) + " " + resp)
        return 1
    }
    rr := parse(resp, LoginResp{})
    if rr.tokens.access_token == "" {
        eprintln("machin-365: signup response missing access_token")
        return 1
    }

    if org == "" { org = default_org_slug(email) }
    oname := name
    if oname == "" { oname = org }
    obody := "{\"slug\":" + json(org) + ",\"name\":" + json(oname) + "}"
    st, resp, err = http_request("POST", server + "/v1/auth/orgs",
        []string{"Content-Type: application/json", "Authorization: Bearer " + rr.tokens.access_token}, obody)
    if err != "" {
        eprintln("machin-365: org create failed: " + err)
        return 1
    }
    if st != 200 && st != 201 {
        eprintln("machin-365: org create failed: HTTP " + str(st) + " " + resp)
        return 1
    }

    lr, msg := auth_login_call(server, email, password, org)
    if msg != "" {
        eprintln("machin-365: login failed: " + msg)
        return 1
    }
    c := load_config()
    c.server = server
    c.token = lr.tokens.access_token
    c.refresh_token = lr.tokens.refresh_token
    c.email = email
    c.org = org
    save_config(c)
    println("signed up " + email + " → org " + org + " on " + server)
    return code
}

func cmd_auth_status() {
    c := load_config()
    if c.server == "" {
        println("not configured — run: machin-365 auth login --server URL --email E --password P")
        return
    }
    println("server:  " + c.server)
    println("email:   " + c.email)
    if c.org == "" && c.token != "" {
        println("org:     (none — org-scoped collections will refuse this token)")
    } else {
        println("org:     " + c.org)
    }
    if c.token != "" {
        println("token:   present")
    } else {
        println("token:   none")
    }
}

func cmd_auth_logout() {
    c := load_config()
    c.token = ""
    c.refresh_token = ""
    save_config(c)
    println("logged out (server and email kept)")
}
