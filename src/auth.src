// auth.src — login against a machin-bkn server.
// POST /v1/auth/login {email,password,org} → {ok, tokens:{access_token,…}}.
// The access token is stored in config.json and sent by apps as a bearer;
// refresh-token rotation is phase 2 (apps will call /v1/auth/refresh).

type Tokens struct {
    access_token string
    refresh_token string
    expires_in int
}
type LoginResp struct {
    ok bool
    tokens Tokens
}

func strip_slash(s) {
    while has_suffix(s, "/") && len(s) > 8 {
        s = substr(s, 0, len(s) - 1)
    }
    return s
}

func cmd_auth_login(a) (code) {
    code = 0
    server := ""
    email := ""
    password := ""
    org := ""
    i := 2
    while i < len(a) {
        if a[i] == "--server" && i+1 < len(a) { server = a[i+1]  i = i + 2  continue }
        if a[i] == "--email" && i+1 < len(a) { email = a[i+1]  i = i + 2  continue }
        if a[i] == "--password" && i+1 < len(a) { password = a[i+1]  i = i + 2  continue }
        if a[i] == "--org" && i+1 < len(a) { org = a[i+1]  i = i + 2  continue }
        i = i + 1
    }
    if server == "" {
        server = load_config().server
    }
    if server == "" {
        eprintln("machin-365: --server required (e.g. https://bkn.example.com)")
        return 2
    }
    if email == "" || password == "" {
        eprintln("usage: machin-365 auth login --server URL --email E --password P [--org SLUG]")
        return 2
    }
    server = strip_slash(server)
    body := "{\"email\":" + json(email) + ",\"password\":" + json(password) + ",\"org\":" + json(org) + "}"
    st, resp, err := http_request("POST", server + "/v1/auth/login", []string{"Content-Type: application/json"}, body)
    if err != "" {
        eprintln("machin-365: login failed: " + err)
        return 1
    }
    if st != 200 {
        eprintln("machin-365: login failed: HTTP " + str(st) + " " + resp)
        return 1
    }
    lr := parse(resp, LoginResp{})
    if lr.tokens.access_token == "" {
        eprintln("machin-365: login response missing access_token")
        return 1
    }
    c := load_config()
    c.server = server
    c.token = lr.tokens.access_token
    c.refresh_token = lr.tokens.refresh_token
    c.email = email
    c.org = org
    save_config(c)
    println("logged in to " + server + " as " + email)
    return code
}

func cmd_auth_status() {
    c := load_config()
    if c.server == "" {
        println("not configured — run: machin-365 auth login --server URL --email E --password P")
        return
    }
    println("server:  " + c.server)
    println("email:   " + c.email)
    println("org:     " + c.org)
    if c.token != "" {
        println("token:   present")
    } else {
        println("token:   none")
    }
}

func cmd_auth_logout() {
    c := load_config()
    c.token = ""
    c.refresh_token = ""
    save_config(c)
    println("logged out (server and email kept)")
}
