// args.src — shared CLI argument validation. Every command rejects unknown
// "--*" flags, dangling flag values and stray positionals with exit 2 +
// usage: a mistyped flag must fail loudly, never degrade into an action
// the user did not request (the convention `sync` established in #25,
// applied suite-wide). Both "--flag value" and "--flag=value" forms are
// accepted where a flag takes a value.

// split an arg of the form "--name=value" into name and inline value.
// has_eq is false for a bare "--name" (no '=' present).
func flag_eq(arg) (name, val, has_eq) {
    name = arg
    val = ""
    has_eq = false
    eq := index(arg, "=")
    if eq > 0 {
        name = substr(arg, 0, eq)
        val = substr(arg, eq + 1, len(arg))
        has_eq = true
    }
    return
}

// flag_value resolves the value for the flag at argv index i. The inline
// "--name=value" form wins; otherwise the next argv token is the value —
// which must exist and not itself look like a "--*" flag. Returns the
// value, the index of the last argv token consumed, and ok=false when the
// flag is dangling: a usage error, never a silent default.
func flag_value(a, i, val, has_eq) (v, last, ok) {
    v = ""
    last = i
    ok = false
    if has_eq {
        if val == "" { return }
        v = val
        ok = true
        return
    }
    if i + 1 >= len(a) || has_prefix(a[i+1], "--") { return }
    v = a[i+1]
    last = i + 1
    ok = true
    return
}

// usage_fail prints the standard "machin-365: <msg>" diagnostic followed by
// the command's usage line; the caller then returns 2.
func usage_fail(msg, usage) {
    eprintln("machin-365: " + msg)
    eprintln(usage)
}

// is_help reports an explicit help request. Every command answers it with
// its usage on stdout and exit 0 — the agent-first discovery surface.
func is_help(arg) {
    return arg == "--help" || arg == "-h"
}

// has_help scans argv a[from:] for a help token. A "--help"/"-h" sitting
// in flag-value position is indistinguishable from a real request and is
// treated as one — no legitimate value in this CLI is either token.
func has_help(a, from) {
    i := from
    while i < len(a) {
        if is_help(a[i]) { return true }
        i = i + 1
    }
    return false
}

// Parse and validate `sync` flags. Returns the --watch interval in seconds
// (0 = one-shot), the --collections/--coll value ("" = flag absent), whether
// the collections flag was given, and a usage-error message ("" = ok).
func sync_parse_args(a) (watch, coll_arg, have_coll, err_msg) {
    watch = 0
    coll_arg = ""
    have_coll = false
    err_msg = ""
    i := 2
    while i < len(a) {
        arg := a[i]
        if !has_prefix(arg, "--") {
            err_msg = "unexpected argument '" + arg + "'"
            return
        }
        name, val, has_eq := flag_eq(arg)
        if name == "--collections" || name == "--coll" {
            have_coll = true
            if has_eq {
                coll_arg = val
            } else {
                if i + 1 >= len(a) || has_prefix(a[i+1], "--") {
                    err_msg = name + " requires a value" +
                        " (e.g. --collections ns/coll,ns/coll2)"
                    return
                }
                coll_arg = a[i+1]
                i = i + 1
            }
        } else if name == "--watch" {
            watch = 15
            if has_eq {
                n := parse_int(val)
                if n <= 0 {
                    err_msg = "--watch requires a positive interval in seconds"
                    return
                }
                watch = n
            } else if i + 1 < len(a) && !has_prefix(a[i+1], "--") {
                n := parse_int(a[i+1])
                if n > 0 {
                    watch = n
                    i = i + 1
                }
            }
        } else {
            err_msg = "unknown flag '" + arg + "'"
            return
        }
        i = i + 1
    }
    if have_coll && trim(coll_arg) == "" {
        err_msg = "--collections requires a value" +
            " (e.g. --collections ns/coll,ns/coll2)"
    } else if have_coll {
        // the flag value is persisted verbatim — a malformed ref must die
        // here, before it can be memorised or used for a sync pass (#48)
        bad := first_bad_ref(parse_coll_list(coll_arg))
        if bad != "" {
            err_msg = "invalid collection ref '" + bad +
                "' — expected ns/coll with [a-z0-9_-] segments" +
                " (e.g. --collections ns/coll,ns/coll2)"
        }
    }
    return
}
