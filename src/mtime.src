// mtime.src — _mtime sanity bounds for sync (#129).
//
// _mtime is trusted verbatim almost everywhere: a record stamped in the
// future (client clock skew, a unit bug writing µs/ns — the mirror
// image of #126's epoch-seconds case) wins every LWW conflict and can
// never be deleted, because tombstones are stamped at now_ms() and
// tomb_wins needs marker > record. The delete doesn't just fail — the
// record resurrects on the next pass when the still-live remote copy is
// pulled back down.
//
// The bound is a skew horizon of now_ms() + mtime_skew_ms (15 min
// covers NTP correction and minor drift), applied on both sides:
//
//   - rec_mtime_b is the READ bound: LWW, tomb_wins and vanished-id
//     detection compare min(_mtime, horizon), so an unclamped future
//     stamp degrades to "recent" instead of "eternal".
//   - stamp is the WRITE bound: any doc sync writes whose _mtime sits
//     beyond the horizon is rewritten to now_ms() through SQLite's
//     JSON1 engine (the same trick jstrip uses — MFL has no generic
//     JSON value). sync_write_rec mirrors the healed doc to the
//     opposite store so both sides pin the same sane value; without
//     the mirror the raw stamp would keep winning reads on the store
//     that was not written.
//   - heal_future_mtimes covers what the write bound cannot reach: a
//     poisoned record sitting IDENTICAL on both sides never goes
//     through stamp() (the merge reads "same" and writes nothing), so
//     its raw stamp would survive forever — and because the read bound
//     moves with now, a fixed tombstone marker eventually loses to it.
//     Each fetch re-POSTs stored docs beyond the horizon, converging
//     the value to now on that side independently of the merge.
//
// Tombstone markers get a wider WRITE horizon (now + 2*skew): a
// back-filled marker is stamped at max(now, record_mtime + 1) so it
// always beats the version it deletes — later legit edits still win
// under sane clocks — and that value can sit just past the record
// horizon. Marker READS stay unbounded (load_tombs uses rec_mtime): a
// marker is only ever written at ~now or ~horizon+1, and bounding it
// would tie it against the record it must beat.
//
// heal_local_docs covers the other end of the _mtime lifecycle (#1):
// _mtime is a sync-internal field apps never write, so a plain local
// upsert leaves the stored record reading as epoch 0 and losing every
// LWW comparison. Every local record without a usable _mtime was
// necessarily written after the last sync pass that stamped it, so
// now_ms() is the freshest honest timestamp — stamped and persisted
// before the merge compares mtimes.

// _mtime is milliseconds since epoch — the unit sync writes (now_ms())
// and every comparison assumes. Epoch-SECONDS values (what `date +%s`,
// time.time() or Math.floor(Date.now()/1000) produce, ~1e9–1e10 today)
// are ~1000x too small: read literally they lose every LWW/tombstone
// comparison as "ancient" and fall under tomb_cutoff() so markers look
// expired (#126). No real ms timestamp sits below mtime_ms_floor
// (1e11 ms ≈ 1973-03), so a positive value under it is read as seconds
// and scaled ×1000 — the same instant, in the documented unit. rec_mtime
// is the single read funnel, so records, tombstones and manifests all
// compare in ms; the stored doc keeps its original value.
var mtime_ms_floor = 100000000000

func norm_mtime(mt) {
    if mt > 0 && mt < mtime_ms_floor { return mt * 1000 }
    return mt
}

// mtime of a raw record JSON, normalized to ms; 0 when absent/unparseable.
func rec_mtime(rec) (mt) {
    mt = 0
    v, e := json_get(rec, "._mtime")
    if e != "" { return mt }
    return norm_mtime(parse_int(trim(v)))
}

// count records whose _mtime sits in the epoch-seconds band — fetch_range
// calls this once per fetched doc so the pass can warn about mixed-unit
// writers instead of silently scaling them forever.
func note_mtime_suspect(rec) {
    v, e := json_get(rec, "._mtime")
    if e != "" { return }
    mt := parse_int(trim(v))
    if mt > 0 && mt < mtime_ms_floor {
        sync_mtime_suspect = sync_mtime_suspect + 1
    }
}

var mtime_skew_ms = 900000 // 15 min

// Docs whose _mtime stamp() rewrote this pass — reported once at the
// end of sync_pass_once so poisoned writers surface instead of being
// silently normalized forever.
var sync_mtime_clamped = 0

func mtime_horizon() { return now_ms() + mtime_skew_ms }

func mtime_tomb_horizon() { return now_ms() + mtime_skew_ms * 2 }

// write-side horizon for one collection's _mtime stamps.
func mtime_write_horizon(ref) {
    if ref == sync_tomb_coll { return mtime_tomb_horizon() }
    return mtime_horizon()
}

// rec_mtime bounded to the skew horizon — the value every LWW and
// tombstone comparison should use for RECORDS. Stored docs are healed
// on write, so this only bounds unhealed poison (direct store-API
// writes, pre-fix data); the bound moves with now, which is what lets
// a fixed tombstone beat the record it deletes on the pass it lands.
func rec_mtime_bounded(rec) {
    mt := rec_mtime(rec)
    h := mtime_horizon()
    if mt > h { return h }
    return mt
}

var mtime_json_db = 0

// Rewrite $._mtime in a raw doc through SQLite's JSON1 engine — MFL has
// no generic JSON value, so documents are only ever rewritten by JSON1
// (the same trick scope.src's jstrip uses). Returns rec unchanged when
// the rewrite cannot run or produce a document.
func jset_mtime(rec, mt) {
    if mtime_json_db == 0 { mtime_json_db = sqlite_open(":memory:") }
    if mtime_json_db == 0 { return rec }
    rows := sqlite_query(mtime_json_db,
        "SELECT json_set(?, '$._mtime', CAST(? AS INTEGER)) AS d",
        []string{rec, str(mt)})
    if rows == "" || rows == "[]" { return rec }
    v, e := json_get(rows, "[0].d")
    if e != "" || len(v) < 2 { return rec }
    if substr(v, 0, 1) != "\"" { return rec }
    v = substr(v, 1, len(v) - 1)
    v = replace(replace(v, "\\\"", "\""), "\\\\", "\\")
    return v
}

// ensure _mtime is present and sane: inject now_ms() when absent, and
// clamp values beyond the collection's write horizon to now_ms() — a
// poisoned future stamp degrades to "recent" instead of winning LWW
// and tombstones forever (#129).
func stamp(rec, ref) {
    v, e := json_get(rec, "._mtime")
    if e == "" {
        mt := parse_int(trim(v))
        // A present-but-unusable stamp (0, negative, non-numeric) reads
        // as epoch 0 in every comparison — the same hole as an absent
        // field. jset_mtime rewrites it whatever shape it had.
        if mt <= 0 { return jset_mtime(rec, now_ms()) }
        if mt <= mtime_write_horizon(ref) { return rec }
        sync_mtime_clamped = sync_mtime_clamped + 1
        return jset_mtime(rec, now_ms())
    }
    inner := substr(rec, 0, len(rec)-1)
    comma := ","
    if len(inner) <= 1 { comma = "" }
    return inner + comma + "\"_mtime\":" + str(now_ms()) + "}"
}

// _mtime the remote record will carry after push_doc: the doc's own
// when sane, else the now_ms() stamp()/clamp writes — approximated by
// now_ms() (the inject/clamp runs a few instructions later inside
// push_doc; ms-level skew is harmless for manifest bookkeeping).
func push_mtime(rec, ref) {
    mt := rec_mtime(rec)
    if mt > 0 && mt <= mtime_write_horizon(ref) { return mt }
    return now_ms()
}

// Write one record to a side during the merge, healing _mtime on BOTH
// stores when stamp() rewrote it: the stamped doc goes to the target
// side as usual, and — only when the doc actually changed — the same
// stamped doc is mirrored to the opposite side so the raw future stamp
// cannot keep winning reads on the store that was not written.
// Mirroring is safe: it is the same fetched content with a sane
// _mtime, and both sides then hold identical mtimes so the next pass
// reads "same" instead of re-fighting the raw stamp.
// A pulled doc is localized first (scope.src): the remote's tenancy
// stamp must not fork a second scope-keyed row in the single-user
// local store. Pushes are untouched — the remote re-stamps on write.
func sync_write_rec(ref, rec, to_remote) (ok) {
    if !to_remote { rec = localize_doc(rec, ref) }
    doc := stamp(rec, ref)
    if to_remote {
        ok = post_doc(sync_remote, sync_remote_tok, ref, doc, "remote")
        if doc != rec { post_doc(sync_local, sync_local_tok, ref, doc, "local") }
    } else {
        ok = post_doc(sync_local, sync_local_tok, ref, doc, "local")
        if doc != rec { post_doc(sync_remote, sync_remote_tok, ref, doc, "remote") }
    }
    return ok
}

// Re-POST fetched records whose stored _mtime sits beyond the record
// horizon: stamp() only runs when a merge writes the doc, so poison
// that is identical on both sides (or never conflicts) would keep its
// raw stamp forever — and rec_mtime_bounded's moving horizon means a
// fixed tombstone eventually loses to it (#129). Healing on fetch
// converges each side's stored value to now independently; the pass's
// in-memory recs are untouched, so this pass's comparisons are
// unchanged and the next fetch sees the sane value. sync/tombstones is
// exempt: markers legitimately carry record_mtime+1 up to the wider
// tomb horizon. Docs stamp() cannot rewrite (jset_mtime failure) are
// skipped rather than re-POSTed unchanged every pass.
func heal_future_mtimes(base, tok, ref, recs, side) {
    if ref == sync_tomb_coll { return }
    h := mtime_horizon()
    i := 0
    while i < len(recs) {
        r := recs[i]
        if rec_mtime(r) > h {
            doc := stamp(r, ref)
            if doc != r {
                perr("machin-365: sync: " + ref + "/" + rec_id(r) +
                    " had a future-dated _mtime — clamped to now")
                post_doc(base, tok, ref, doc, side)
            }
        }
        i = i + 1
    }
}

// heal_local_docs stamps _mtime=now onto every local record whose stamp
// is absent or unusable (rec_mtime_bounded <= 0) and persists it via
// POST — the same upsert-by-id write path sync itself uses, so it works
// on both bkn implementations and cannot mangle ids the way a
// record-path write could (#140). lr is updated in place so the merge
// compares the healed timestamp; without the write-back the stamp would
// not persist and every pass would re-heal the same docs forever.
//
// Two guards keep the heal from overriding stronger signals:
//
//   - tomb_wins on the PRE-heal read: a record a live tombstone already
//     condemns keeps its epoch-0 mtime, so deletes still beat ambiguous
//     unstamped writes instead of being resurrected by a "now" stamp.
//   - ref == sync_tomb_coll: an unstamped tombstone marker is dead by
//     design (load_tombs ignores mt <= cutoff), and stamping it would
//     revive a delete.
//
// Returns how many records were stamped; the caller reports it.
func heal_local_docs(ref, lr, tm) (n) {
    n = 0
    if ref == sync_tomb_coll { return n }
    j := 0
    while j < len(lr) {
        r := lr[j]
        id := rec_id(r)
        mt := rec_mtime_bounded(r)
        if id != "" && mt <= 0 && !tomb_wins(tm, ref, id, mt) {
            doc := stamp(r, ref)
            if doc != r &&
                post_doc(sync_local, sync_local_tok, ref, doc, "local") {
                lr[j] = doc
                n = n + 1
            }
        }
        j = j + 1
    }
    return n
}
