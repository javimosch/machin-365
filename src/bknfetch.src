// bknfetch.src — `service install` release fallback. When --bin,
// MACHIN_BKN_BIN, PATH and an existing suite install all miss, the latest
// machin-bkn GitHub release asset for this platform is downloaded,
// checksum-verified, and handed to the same install path a --bin file
// takes — the probe + serve gate still decides whether it really is bkn.

type GhAsset struct { name string  browser_download_url string  digest string }
type GhRelease struct { tag_name string  assets []GhAsset }

// sums_sha256 returns the checksum published for asset in a SHA256SUMS
// body ("<sha256>  <name>" per line); "" when there is no entry.
func sums_sha256(body, asset) {
    i := 0
    n := len(body)
    while i < n {
        j := i
        while j < n && substr(body, j, j + 1) != "\n" { j = j + 1 }
        line := trim(substr(body, i, j))
        i = j + 1
        if !(has_suffix(line, " " + asset) || has_suffix(line, "*" + asset)) { continue }
        sp := index(line, " ")
        if sp <= 0 { continue }
        sha := trim(substr(line, 0, sp))
        if len(sha) == 64 { return sha }
    }
    return ""
}

// gh_pick_asset selects the release asset for this platform: the
// mbkn-<tag>-<plat> convention first, then any mbkn-* asset suffixed
// -<plat>. Also returns the SHA256SUMS.txt download URL when published.
func gh_pick_asset(rel, plat) (aname, aurl, adigest, sumsurl) {
    aname = ""
    aurl = ""
    adigest = ""
    sumsurl = ""
    want := "mbkn-" + rel.tag_name + "-" + plat
    i := 0
    while i < len(rel.assets) {
        a := rel.assets[i]
        if a.name == "SHA256SUMS.txt" { sumsurl = a.browser_download_url }
        if a.name == want {
            aname = a.name
            aurl = a.browser_download_url
            adigest = a.digest
        }
        i = i + 1
    }
    if aname != "" { return }
    i = 0
    while i < len(rel.assets) {
        a := rel.assets[i]
        if has_prefix(a.name, "mbkn-") && has_suffix(a.name, "-" + plat) {
            aname = a.name
            aurl = a.browser_download_url
            adigest = a.digest
        }
        i = i + 1
    }
    return
}

// bkn_fetch_release downloads the latest mbkn release asset for this
// platform into the suite home. Returns the temp path plus a display
// label for diagnostics; "" path on any failure — the reason is already
// on stderr. The caller removes the temp file once the bytes are read.
func bkn_fetch_release() (path, label) {
    path = ""
    label = ""
    plat := platform()
    st, body, err := http_request("GET",
        "https://api.github.com/repos/javimosch/machin-bkn/releases/latest",
        []string{"User-Agent: machin-365", "Accept: application/vnd.github+json"}, "")
    if err != "" || st != 200 {
        eprintln("machin-365: cannot query machin-bkn releases: " +
            http_errnote(st, err, body))
        return
    }
    rel := parse(body, GhRelease{})
    if rel.tag_name == "" || len(rel.assets) == 0 {
        eprintln("machin-365: machin-bkn release metadata unreadable")
        return
    }
    aname, aurl, adigest, sumsurl := gh_pick_asset(rel, plat)
    if aname == "" {
        eprintln("machin-365: no mbkn release asset for " + plat)
        eprintln("  build from source: git clone https://github.com/javimosch/machin-bkn && ./build.sh")
        return
    }
    system("mkdir -p '" + suite_home() + "'")
    // Checksum: the release's own SHA256SUMS.txt when published, else the
    // sha256 digest GitHub records for the asset at upload time.
    expected := ""
    if sumsurl != "" {
        sp := suite_home() + "/.bkn-sums.tmp"
        dc, _, _ := exec("curl -fsSL '" + sumsurl + "' -o '" + sp + "'")
        if dc == 0 { expected = sums_sha256(read_file(sp), aname) }
        remove(sp)
    }
    if expected == "" && has_prefix(adigest, "sha256:") {
        expected = substr(adigest, 7, len(adigest))
    }
    eprintln("machin-365: fetching " + aname + " from github.com/javimosch/machin-bkn " +
        rel.tag_name)
    tmp := suite_home() + "/.bkn-" + aname + ".dl"
    dc, _, _ := exec("curl -fsSL '" + aurl + "' -o '" + tmp + "'")
    if dc != 0 {
        remove(tmp)
        eprintln("machin-365: download failed: GET " + aurl + " (curl exit " + str(dc) + ")")
        return
    }
    if expected != "" {
        sum := to_hex(sha256_bytes(read_file_bytes(tmp)))
        if to_lower(sum) != to_lower(expected) {
            remove(tmp)
            eprintln("machin-365: sha256 mismatch for " + aname + " — refusing to install")
            return
        }
    } else {
        eprintln("machin-365: warning: " + rel.tag_name + " publishes no checksum" +
            " for " + aname + " — bytes unverified")
    }
    path = tmp
    label = "mbkn " + rel.tag_name + " " + plat +
        " (github.com/javimosch/machin-bkn release)"
    return
}
