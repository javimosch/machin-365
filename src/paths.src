// paths.src — suite filesystem layout.
// MACHIN_365_HOME relocates the whole suite home (apps, data, config,
// installed registry) — the BKN_HOME pattern: one env var moves everything.

func suite_home() {
    h := env("MACHIN_365_HOME")
    if h != "" { return h }
    return env("HOME") + "/.local/share/machin-365"
}

func config_path() { return suite_home() + "/config.json" }
func catalog_path() { return suite_home() + "/catalog.json" }
func installed_path() { return suite_home() + "/installed.json" }
func manifest_path() { return suite_home() + "/sync-manifest.txt" }
func apps_dir() { return suite_home() + "/apps" }
func data_root() { return suite_home() + "/data" }

func app_dir(id) { return apps_dir() + "/" + id }
func app_bin_dir(id) { return app_dir(id) + "/bin" }

// desktop_dir is the per-user applications dir — .desktop entries here make
// installed apps show up in the OS app menu without a custom launcher.
func desktop_dir() {
    d := env("XDG_DATA_HOME")
    if d == "" { d = env("HOME") + "/.local/share" }
    return d + "/applications"
}

// ensure_home creates the suite home tree and proves it is writable.
// Returns "" on success, else a diagnostic for the caller to report.
// mkdir -p exits 0 when the directory already exists — even when nothing
// inside it can be written — so the only honest check is a real write:
// the probe file stands in for config.json. init treats any failure as
// fatal before it claims "initialized".
func ensure_home() (msg) {
    msg = ""
    if system("mkdir -p '" + suite_home() + "' '" + apps_dir() + "' '" + data_root() + "'") != 0 {
        msg = "cannot create suite home " + suite_home()
        return
    }
    // The desktop dir lives under XDG_DATA_HOME/HOME — outside the suite
    // home — and only feeds best-effort .desktop entries, so its creation
    // is not part of the writability contract.
    system("mkdir -p '" + desktop_dir() + "'")
    if system("chmod 700 '" + suite_home() + "'") != 0 {
        msg = "cannot secure suite home " + suite_home() + " (chmod 700 failed)"
        return
    }
    pp := suite_home() + "/.home-probe"
    if write_file(pp, "ok") < 0 {
        msg = "cannot write suite home " + suite_home()
        return
    }
    remove(pp)
    return
}
