// syncauth.src — remote credential recovery for sync passes. Split from
// sync.src (which owns the replication pass itself) to keep both files
// under the suite's source-size convention.
//
// When remote calls fail in an auth-class way, sync_pass rotates the
// stored session via /v1/auth/refresh and retries the pass ONCE with the
// new token. A fresh token that is still refused (org-less login,
// revoked session) marks refresh dead for the process — sync keeps
// reporting the failures, but stops rotating tokens every pass.

// the actionable hint prints once per process, not once per failed pass.
func sync_auth_warn(msg) {
    if sync_refresh_warned { return }
    sync_refresh_warned = true
    eprintln("machin-365: " + msg)
}

// One shot at remote credential recovery. Env-managed tokens
// (MACHIN_365_REMOTE_TOKEN) are the caller's problem — auth login cannot
// override them, so they are refused here rather than silently ignored.
// Returns the new access token on success; fatal=true means retrying later
// cannot help until the next auth login.
func sync_try_refresh() (ntok, ok, fatal) {
    ntok = ""
    ok = false
    fatal = false
    if env("MACHIN_365_REMOTE_TOKEN") != "" {
        sync_auth_warn("remote rejected MACHIN_365_REMOTE_TOKEN — set a valid" +
            " token or unset the env var (auth login cannot override it)")
        fatal = true
        return
    }
    ntok, ok, fatal = auth_refresh_stored(sync_remote)
    return
}

// Refresh ahead of expiry so --watch does not eat a failed pass every token
// TTL. Only config-managed JWTs are proactively refreshed; anything else
// falls through to the reactive path in sync_pass.
func sync_maybe_refresh() {
    if sync_refresh_dead { return }
    if env("MACHIN_365_REMOTE_TOKEN") != "" { return }
    exp := jwt_exp(sync_remote_tok)
    if exp == 0 || exp - now_ms() / 1000 > 60 { return }
    ntok, ok, fatal := sync_try_refresh()
    if ok {
        sync_remote_tok = ntok
        perr("machin-365: access token refreshed before expiry")
    } else {
        if fatal { sync_refresh_dead = true }
        sync_auth_warn("access token expired and refresh failed — run: machin-365 auth login")
    }
}

func sync_pass(refs) {
    sync_maybe_refresh()
    sync_pass_once(refs)
    if !sync_remote_auth_err || sync_refresh_dead { return }
    ntok, ok, fatal := sync_try_refresh()
    if !ok {
        if fatal { sync_refresh_dead = true }
        if env("MACHIN_365_REMOTE_TOKEN") == "" {
            sync_auth_warn("remote rejected the access token and refresh failed" +
                " — run: machin-365 auth login")
        }
        return
    }
    sync_remote_tok = ntok
    perr("machin-365: access token refreshed — retrying pass")
    sync_pass_once(refs)
    if sync_remote_auth_err {
        sync_refresh_dead = true
        sync_auth_warn("token refreshed but remote still refuses — check org" +
            " scope (auth login --org SLUG) or run: auth login")
    }
}
