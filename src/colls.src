// colls.src — collection ref ("ns/coll") list parsing and validation.
// Both writers of the sticky sync_collections set — the --collections
// flag and `config set sync_collections` — parse through here, and sync
// re-validates whatever discover_refs returns, so a malformed ref is
// rejected before it can be memorised or used for a pass (#48).

// comma-separated list → refs ("a/b, c/d" tolerates spaces)
func parse_coll_list(s) (refs) {
    refs = []string{}
    cur := ""
    i := 0
    while i <= len(s) {
        ch := ","
        if i < len(s) { ch = substr(s, i, i + 1) }
        if ch == "," {
            r := trim(cur)
            if r != "" { refs = append(refs, r) }
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    return refs
}

// a collection ref is exactly "ns/coll" — one '/', non-empty on both
// sides. Anything else can only ever 404, and because --collections is
// persisted verbatim a typo would silently replace the whole sticky list,
// so malformed refs are rejected before any pass or config write.
func valid_ref(ref) {
    s := index(ref, "/")
    if s <= 0 { return false }
    rest := substr(ref, s + 1, len(ref))
    if rest == "" || index(rest, "/") >= 0 { return false }
    return true
}

// first entry that is not ns/coll-shaped, "" when all are valid.
func first_bad_ref(refs) {
    i := 0
    while i < len(refs) {
        if !valid_ref(refs[i]) { return refs[i] }
        i = i + 1
    }
    return ""
}

// ref ∈ refs — generic membership test shared by sync, config and auth.
func has_ref(refs, ref) {
    i := 0
    while i < len(refs) {
        if refs[i] == ref { return true }
        i = i + 1
    }
    return false
}
