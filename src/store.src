// store.src — per-account partitioning of the local bkn store.
// bkn/bkn.db* is always the ACTIVE database; each identity's parked copy
// lives at bkn/accounts/<key>.db*, and bkn/.active-key records which key
// owns the active files. See bkn_store_switch for the swap protocol.
// The "_unclaimed" key holds pre-sign-in data; the first real identity to
// activate adopts it (adopt_unclaimed_store) instead of stranding it.

// entries of dir starting with prefix; empty when dir is missing
func dir_names_prefixed(dir, prefix) (names) {
    names = []string{}
    if !is_dir(dir) { return names }
    all := list_dir(dir)
    i := 0
    while i < len(all) {
        if has_prefix(all[i], prefix) { names = append(names, all[i]) }
        i = i + 1
    }
    return names
}

// The local store is partitioned per account. bkn/bkn.db* is always the
// ACTIVE database; each identity's parked copy lives at
// bkn/accounts/<key>.db*, and bkn/.active-key records which key owns the
// active files (absent on pre-partitioning installs — the configured
// identity is then the owner). The key covers server+email+org — org is
// the tenancy boundary sync enforces, so switch-org gets its own store —
// hashed so emails and URLs never become filenames.
func account_store_key(server, email, org) {
    return substr(sha256(server + "\n" + to_lower(email) + "\n" + org), 0, 24)
}

// store keys are 24 lowercase hex chars, or "_unclaimed" for a home with
// no signed-in identity — anything else in .active-key is corruption, not
// an owner, and must never reach a mv destination.
func valid_store_key(k) {
    if k == "_unclaimed" { return true }
    if len(k) != 24 { return false }
    i := 0
    while i < 24 {
        ch := substr(k, i, i + 1)
        if !((ch >= "0" && ch <= "9") || (ch >= "a" && ch <= "f")) { return false }
        i = i + 1
    }
    return true
}

// Restart the bkn after a store change when it was running beforehand.
// what prefixes each diagnostic ("store switched", "pre-sign-in data
// adopted"). Same contract as the old inline block: 0 healthy, diagnostics
// appended otherwise; service_spawn itself prints the happy path.
func bkn_restart_after(was, what) (msg) {
    msg = ""
    if !was { return msg }
    // Restart via service_spawn, never cmd_service_start: config.json
    // still names the PREVIOUS identity until the caller saves the
    // new one, so a nested start would re-resolve the old key and
    // switch straight back — silently undoing this swap.
    tok := local_admin_token()
    if tok == "" {
        return what + " but the bkn token could not be" +
            " saved — run 'service start'; "
    }
    rc := service_spawn(tok)
    if rc == 3 {
        // Alive but unbound at the deadline — a slow boot, not a
        // failure; it should come up on its own.
        return what + "; bkn still starting —" +
            " 'service status' to confirm; "
    }
    if rc != 0 {
        return what + " but the bkn did not restart —" +
            " run 'service start'; "
    }
    return msg
}

type CntRow struct { c int }
type SqlTab struct { n string  s string }

// Adopt the parked pre-auth (_unclaimed) store into the ACTIVE bkn.db*.
// Runs while the bkn is stopped, after a store switch has settled — or on
// the same-identity path to heal homes a pre-adoption build already
// stranded. Two shapes:
//   - no live store (fresh account): the parked files are renamed to
//     bkn.db* — every table comes across untouched, including kv/files.
//   - live store with data: rows merge table-by-table over sqlite ATTACH,
//     INSERT OR IGNORE, so the account's own rows always win a conflict.
// A table merges only when its DDL is identical on both sides — schema
// drift skips that table rather than guessing at columns. Parked files are
// removed only once the data is safely in place; on failure they stay put
// and the note says where to find them.
func adopt_unclaimed_store() (note) {
    note = ""
    bdir := suite_home() + "/bkn"
    adir := bdir + "/accounts"
    old := adir + "/_unclaimed.db"
    if file_size(old) < 0 { return note }
    // Pre-auth record count for the report — 0 when the file is not a
    // readable bkn store. Opening and closing the db checkpoints its WAL,
    // which can remove the -wal/-shm sidecars — so the parked file list is
    // re-read at each use site rather than cached up front.
    n := 0
    odb := sqlite_open(old)
    if odb != 0 {
        rows := sqlite_query(odb, "SELECT COUNT(*) AS c FROM records")
        if rows != "" {
            cnt := parse(rows, []CntRow{})
            if len(cnt) > 0 { n = cnt[0].c }
        }
        sqlite_close(odb)
    }
    // A live store is a bkn.db that opens AND carries the records table.
    // No file at all, or a zero-byte husk, means the parked store can
    // simply move into place; anything else gets the row merge below.
    live := false
    ndb := 0
    // A zero-byte bkn.db is an empty husk — skip the open and let the
    // rename path replace it; anything bigger must prove it is a store.
    if file_size(bkn_db()) > 0 {
        ndb = sqlite_open(bkn_db())
        if ndb == 0 {
            note = "could not open the local store to adopt" +
                " pre-sign-in data — it stays at" +
                " bkn/accounts/_unclaimed.db*; "
            return note
        }
        mt := sqlite_query(ndb, "SELECT COUNT(*) AS c FROM" +
            " sqlite_master WHERE type='table' AND name='records'")
        if mt != "" {
            cnt := parse(mt, []CntRow{})
            if len(cnt) > 0 && cnt[0].c > 0 { live = true }
        }
        if !live {
            // A non-empty file without the records table is not a bkn
            // store — leave it and the parked copy exactly as found.
            sqlite_close(ndb)
            ndb = 0
            note = "local store at bkn/bkn.db is not a recognized" +
                " bkn database — pre-sign-in data left at" +
                " bkn/accounts/_unclaimed.db*; "
            return note
        }
    }
    if !live {
        if ndb != 0 { sqlite_close(ndb) }
        // Clear whatever bkn.db* husk remains so an orphan -wal cannot
        // attach to the adopted database, then move the parked files in.
        stray := dir_names_prefixed(bdir, "bkn.db")
        i := 0
        while i < len(stray) {
            remove(bdir + "/" + stray[i])
            i = i + 1
        }
        parked := dir_names_prefixed(adir, "_unclaimed.db")
        i = 0
        while i < len(parked) {
            nm := parked[i]
            if nm == "_unclaimed.db" || has_prefix(nm, "_unclaimed.db-") {
                system("mv -f " + shell_quote(adir + "/" + nm) + " " +
                    shell_quote(bdir + "/bkn.db" + substr(nm, 13, len(nm))))
            }
            i = i + 1
        }
        if n > 0 {
            note = "adopted " + str(n) + " pre-sign-in record(s) into this" +
                " account's local store; "
        } else {
            note = "adopted the pre-sign-in local store into this" +
                " account's store; "
        }
        return note
    }
    sqlite_exec(ndb, "PRAGMA busy_timeout = 5000")
    if sqlite_exec(ndb, "ATTACH DATABASE '" +
        replace(old, "'", "''") + "' AS uncl") != 0 {
        sqlite_close(ndb)
        note = "could not open the parked pre-auth store for merge —" +
            " it stays at bkn/accounts/_unclaimed.db*; "
        return note
    }
    ot := sqlite_query(ndb, "SELECT name AS n, sql AS s FROM" +
        " uncl.sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")
    nt := sqlite_query(ndb, "SELECT name AS n, sql AS s FROM" +
        " sqlite_master WHERE type='table'")
    mtab := make(map[string]string)
    if nt != "" {
        nrows := parse(nt, []SqlTab{})
        i := 0
        while i < len(nrows) {
            mtab[nrows[i].n] = nrows[i].s
            i = i + 1
        }
    }
    common := 0
    failed := false
    sqlite_exec(ndb, "BEGIN IMMEDIATE")
    if ot != "" {
        orows := parse(ot, []SqlTab{})
        i := 0
        while i < len(orows) {
            t := orows[i]
            if t.s != "" && mtab[t.n] == t.s {
                common = common + 1
                rc := sqlite_exec(ndb, "INSERT OR IGNORE INTO \"" + t.n +
                    "\" SELECT * FROM uncl.\"" + t.n + "\"")
                if rc != 0 { failed = true }
            }
            i = i + 1
        }
    }
    if failed {
        sqlite_exec(ndb, "ROLLBACK")
    } else {
        sqlite_exec(ndb, "COMMIT")
    }
    sqlite_exec(ndb, "DETACH DATABASE uncl")
    sqlite_close(ndb)
    if common == 0 {
        note = "parked pre-auth store shares no tables with the local" +
            " store — left at bkn/accounts/_unclaimed.db*; "
        return note
    }
    if failed {
        // Rolled back whole — the parked copy remains for the next
        // attempt, which OR IGNORE would have made idempotent anyway.
        note = "pre-auth store merge failed — left at" +
            " bkn/accounts/_unclaimed.db* for retry; "
        return note
    }
    parked := dir_names_prefixed(adir, "_unclaimed.db")
    i := 0
    while i < len(parked) {
        nm := parked[i]
        if nm == "_unclaimed.db" || has_prefix(nm, "_unclaimed.db-") {
            remove(adir + "/" + nm)
        }
        i = i + 1
    }
    if n > 0 {
        note = "merged " + str(n) + " pre-sign-in record(s) into this" +
            " account's local store; "
    } else {
        note = "merged the pre-sign-in local store into this account's" +
            " store; "
    }
    return note
}

// Switch the local bkn store to a different account identity. On an
// identity change the active bkn.db* is parked under the PREVIOUS
// identity's key and the incoming identity's parked store (if any) is
// activated in its place — so the previous account's rows can be neither
// read by the new account's apps nor pushed by sync under the new token.
// The bkn is stopped before any file moves (never swap sqlite files under
// a live server) and restarted afterwards if it was running — via
// service_spawn, which never re-reads the still-stale config identity.
// Returns "" or a diagnostic; callers report it — auth never fails on it.
func bkn_store_switch(prev_server, prev_email, prev_org, server, email, org) (msg) {
    msg = ""
    bdir := suite_home() + "/bkn"
    if !is_dir(bdir) { return msg }
    // who owns the active bkn.db* right now: the marker when present and
    // sane, else the previous config identity (pre-partitioning installs)
    pkey := trim(read_file(bdir + "/.active-key"))
    if !valid_store_key(pkey) {
        pkey = "_unclaimed"
        if prev_email != "" {
            pkey = account_store_key(prev_server, prev_email, prev_org)
        }
    }
    nkey := "_unclaimed"
    if email != "" {
        nkey = account_store_key(server, email, org)
    }
    if pkey == nkey && file_size(bkn_db()) >= 0 {
        // already this identity's store — just (re)establish the marker
        write_file(bdir + "/.active-key", nkey)
        // A pre-auth (_unclaimed) store parked by a build that predates
        // adoption still holds the home's offline data unreachable —
        // merge it into the live store once, then drop the parked copy.
        if nkey != "_unclaimed" &&
            len(dir_names_prefixed(bdir + "/accounts", "_unclaimed.db")) > 0 {
            was := bkn_owner() == "ours"
            if was {
                cmd_service_stop()
                if bkn_owner() == "ours" {
                    msg = msg + "could not stop the local bkn —" +
                        " pre-sign-in store left parked under" +
                        " accounts/_unclaimed.db*; "
                }
            }
            if msg == "" {
                msg = msg + adopt_unclaimed_store()
                msg = msg + bkn_restart_after(was,
                    "pre-sign-in data adopted")
            }
        }
        return msg
    }
    was := bkn_owner() == "ours"
    if was {
        cmd_service_stop()
        if bkn_owner() == "ours" {
            return "could not stop the local bkn — local store left" +
                " unchanged; run 'service stop' and retry the sign-in"
        }
    }
    adir := bdir + "/accounts"
    if pkey != nkey {
        parked := dir_names_prefixed(bdir, "bkn.db")
        if len(parked) > 0 {
            system("mkdir -p " + shell_quote(adir))
            pkdb := pkey + ".db"
            i := 0
            while i < len(parked) {
                n := parked[i]
                if system("mv -f " + shell_quote(bdir + "/" + n) + " " +
                    shell_quote(adir + "/" + pkdb + substr(n, 6, len(n)))) != 0 {
                    msg = msg + "could not park " + n + "; "
                }
                i = i + 1
            }
        }
    }
    // "<key>.db" as a prefix also catches "<key>.db-wal"/"-shm" — exactly
    // the set to activate; a 24-hex prefix cannot collide across keys.
    nkdb := nkey + ".db"
    incoming := dir_names_prefixed(adir, nkdb)
    i := 0
    while i < len(incoming) {
        n := incoming[i]
        if n == nkdb || has_prefix(n, nkdb + "-") {
            if system("mv -f " + shell_quote(adir + "/" + n) + " " +
                shell_quote(bdir + "/bkn.db" + substr(n, len(nkdb), len(n)))) != 0 {
                msg = msg + "could not activate " + n + "; "
            }
        }
        i = i + 1
    }
    if msg == "" { write_file(bdir + "/.active-key", nkey) }
    // First real sign-in adopts the pre-auth (_unclaimed) store: parked
    // above when it was the active db, or already sitting in accounts/
    // from an older build — either way it becomes this account's data,
    // not a silent orphan.
    if msg == "" && nkey != "_unclaimed" {
        msg = msg + adopt_unclaimed_store()
    }
    msg = msg + bkn_restart_after(was, "store switched")
    return msg
}

// Adopt the parked pre-auth store into the ACTIVE bkn.db. A suite home
// used before its first sign-in keeps its rows under the "_unclaimed"
// partition; when a real identity activates, bkn_store_switch parks that
// database at accounts/_unclaimed.db* — without this merge every
// pre-login record is stranded where nothing can reach it. Rows copy
// verbatim at the sqlite level: doc never carries its own id (the store
// strips $.id on write and re-injects the column on read), record ids
// are ULIDs so INSERT OR IGNORE collisions are ~impossible, and the
// account's own row wins the rare conflict. collections rows come along
// so normalize rules survive; the access column is local-store
// irrelevant (the loopback token is admin) and keeps its default. The
// merge is one transaction; the parked copy is KEPT under
// accounts/_unclaimed.db* — re-running is idempotent (OR IGNORE), it
// preserves anything the just-stopped bkn committed during shutdown,
// and 'service reset' remains the wipe. Returns the inserted record
// count with err "" on success (0 when there was nothing to adopt), or
// err set to the diagnostic on failure.
func bkn_adopt_unclaimed() (adopted, err) {
    adopted = 0
    err = ""
    srcp := suite_home() + "/bkn/accounts/_unclaimed.db"
    if file_size(srcp) <= 0 { return }
    ddb := sqlite_open(bkn_db())
    if ddb == 0 {
        err = "pre-auth local data is parked at " + srcp +
            " but the active store could not be opened"
        return
    }
    sqlite_exec(ddb, "PRAGMA busy_timeout = 5000", []string{})
    // A fresh dst gets the store shape bkn expects; on an existing store
    // these are no-ops and bkn's own migrations add anything newer next
    // open.
    if sqlite_exec(ddb, "CREATE TABLE IF NOT EXISTS collections (ns TEXT NOT NULL, name TEXT NOT NULL, normalize TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL, PRIMARY KEY (ns, name))", []string{}) != 0 ||
        sqlite_exec(ddb, "CREATE TABLE IF NOT EXISTS records (ns TEXT NOT NULL, coll TEXT NOT NULL, id TEXT NOT NULL, scope TEXT NOT NULL DEFAULT '', doc TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, PRIMARY KEY (ns, coll, scope, id))", []string{}) != 0 {
        sqlite_close(ddb)
        err = "pre-auth local data is parked at " + srcp +
            " but the active store schema could not be prepared"
        return
    }
    // A dst whose records table predates scoped keys cannot take the
    // merge without silently dropping tenancy — leave it parked.
    d := sqlite_query(ddb, "SELECT sql AS s FROM sqlite_master WHERE type='table' AND name='records'", []string{})
    dsql := ""
    if d != "" && d != "[]" {
        sv, se := json_get(d, "[0].s")
        if se == "" { dsql = parse(sv, "") }
    }
    if !contains(dsql, "scope") {
        sqlite_close(ddb)
        err = "pre-auth local data is parked at " + srcp +
            " — the active store has a pre-scope schema; run" +
            " 'service start' so bkn migrates it, then" +
            " 'auth adopt-local'"
        return
    }
    arc := sqlite_exec(ddb, "ATTACH DATABASE ? AS preauth", []string{srcp})
    if arc != 0 {
        sqlite_close(ddb)
        err = "pre-auth local data is parked at " + srcp +
            " and could not be read (sqlite error " + str(arc) + ")"
        return
    }
    t := sqlite_query(ddb, "SELECT COUNT(*) AS c FROM preauth.records", []string{})
    if t == "" || t == "[]" {
        sqlite_exec(ddb, "DETACH DATABASE preauth", []string{})
        sqlite_close(ddb)
        err = "pre-auth store " + srcp + " is not a readable bkn database"
        return
    }
    srcn := 0
    tv, te := json_get(t, "[0].c")
    if te == "" { srcn = parse_int(trim(tv)) }
    // A pre-scope src has no scope column — its rows are all unscoped,
    // so '' is the exact value to write. Only a positively-read DDL may
    // trigger that: an unreadable one keeps "scope" so the INSERT fails
    // loudly instead of silently dropping tenancy.
    sddl := ""
    sdok := false
    sd := sqlite_query(ddb, "SELECT sql AS s FROM preauth.sqlite_master WHERE type='table' AND name='records'", []string{})
    if sd != "" && sd != "[]" {
        sv, se := json_get(sd, "[0].s")
        if se == "" {
            sddl = parse(sv, "")
            sdok = true
        }
    }
    scope_sel := "scope"
    if sdok && !contains(sddl, "scope") { scope_sel = "''" }
    has_colls := false
    ct := sqlite_query(ddb, "SELECT COUNT(*) AS c FROM preauth.sqlite_master WHERE type='table' AND name='collections'", []string{})
    if ct != "" && ct != "[]" {
        cv, ce := json_get(ct, "[0].c")
        if ce == "" && trim(cv) != "0" { has_colls = true }
    }
    brc := sqlite_exec(ddb, "BEGIN IMMEDIATE", []string{})
    if brc != 0 {
        sqlite_exec(ddb, "DETACH DATABASE preauth", []string{})
        sqlite_close(ddb)
        err = "pre-auth local data stays parked at " + srcp +
            " — merge failed (sqlite error " + str(brc) + ")"
        return
    }
    rc := 0
    if has_colls {
        rc = sqlite_exec(ddb, "INSERT OR IGNORE INTO collections (ns, name, normalize, created_at) SELECT ns, name, normalize, created_at FROM preauth.collections", []string{})
    }
    if rc == 0 {
        rc = sqlite_exec(ddb, "INSERT OR IGNORE INTO records (ns, coll, scope, id, doc, created_at, updated_at) SELECT ns, coll, " + scope_sel + ", id, doc, created_at, updated_at FROM preauth.records", []string{})
    }
    if rc != 0 {
        sqlite_exec(ddb, "ROLLBACK", []string{})
        sqlite_exec(ddb, "DETACH DATABASE preauth", []string{})
        sqlite_close(ddb)
        err = "pre-auth local data stays parked at " + srcp +
            " — merge failed (sqlite error " + str(rc) + ")"
        return
    }
    ch := sqlite_query(ddb, "SELECT changes() AS n", []string{})
    adopted = srcn
    if ch != "" && ch != "[]" {
        cv, ce := json_get(ch, "[0].n")
        if ce == "" { adopted = parse_int(trim(cv)) }
    }
    crc := sqlite_exec(ddb, "COMMIT", []string{})
    if crc != 0 {
        sqlite_exec(ddb, "ROLLBACK", []string{})
        sqlite_exec(ddb, "DETACH DATABASE preauth", []string{})
        sqlite_close(ddb)
        err = "pre-auth local data stays parked at " + srcp +
            " — merge failed (sqlite error " + str(crc) + ")"
        return
    }
    sqlite_exec(ddb, "DETACH DATABASE preauth", []string{})
    sqlite_close(ddb)
    return
}

